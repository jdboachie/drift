<?xml version="1.0" encoding="utf-8"?>
<!-- When a page's process dies or hangs (MainWindow.ShowCrash): which page, what happened, and a way back. A hung page stays in view under the scrim, so it's clear which one it is. -->
<UserControl
    x:Class="Drift.CrashCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift"
    xmlns:models="using:Drift.Models">

    <Grid>
        <Border x:Name="Scrim" x:FieldModifier="internal" Background="{ThemeResource DriftPageBrush}" Opacity="0" CornerRadius="5">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
        </Border>
        <Border x:Name="Card" x:FieldModifier="internal"
                Width="300"
                Padding="24,24,24,20"
                CornerRadius="12"
                Style="{StaticResource FloatingPanelStyle}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Opacity="0"
                Translation="0,0,32"
                SizeChanged="{x:Bind Owner.CrashCard_SizeChanged}">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel>
                <!-- The site's own icon, so it's clear which page; a glyph when there's none. -->
                <Border Width="48" Height="48" CornerRadius="12" HorizontalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <Grid>
                        <Image x:Name="Favicon" x:FieldModifier="internal" Width="24" Height="24" />
                        <FontIcon x:Name="Glyph" x:FieldModifier="internal" Glyph="&#xE774;" FontSize="22"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                    </Grid>
                </Border>
                <TextBlock x:Name="Title" x:FieldModifier="internal" Margin="0,14,0,0" FontSize="16" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="Text" x:FieldModifier="internal" Margin="0,4,0,0" FontSize="13"
                           Foreground="{ThemeResource DriftSecondaryTextBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <Grid Margin="0,20,0,0" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="WaitButton" x:FieldModifier="internal" Content="Wait" HorizontalAlignment="Stretch"
                            Click="{x:Bind Owner.CrashWait_Click}" />
                    <Button x:Name="ReloadButton" x:FieldModifier="internal" Grid.Column="1" Content="Reload" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}" Click="{x:Bind Owner.CrashReload_Click}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
