<?xml version="1.0" encoding="utf-8"?>
<!-- The command bar (CommandBar.cs): search or type an address, run a command, or ask AI (AskAiBar.cs), over a backdrop that closes it when clicked. -->
<UserControl
    x:Class="Drift.CommandBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift"
    xmlns:models="using:Drift.Models">

    <UserControl.Resources>
        <Storyboard x:Name="EnterAnimation" x:FieldModifier="internal">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Card" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </UserControl.Resources>

    <Grid x:Name="Backdrop" x:FieldModifier="internal"
          Background="Transparent"
          Visibility="Collapsed"
          PointerPressed="{x:Bind Owner.CommandLayer_PointerPressed}">
        <Border x:Name="Card" x:FieldModifier="internal"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="720"
                CornerRadius="10"
                Style="{StaticResource FloatingPanelStyle}"
                Translation="0,0,24">
            <StackPanel>
                <!-- Arc's measures: 51 tall, its icon 22 and its text 50 in from the card's edge. -->
                <Grid Height="51" Padding="20,0,16,0" ColumnSpacing="13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="Glyph" x:FieldModifier="internal" Glyph="&#xE721;" FontSize="15"
                              Foreground="{ThemeResource DriftIconBrush}" />
                    <Image x:Name="Favicon" x:FieldModifier="internal" Width="16" Height="16" Visibility="Collapsed" />
                    <!-- Searching a site (SiteSearchBar.cs): its name in a chip before what you type. -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="SiteChip" x:FieldModifier="internal" CornerRadius="6" Padding="8,3,8,4" Margin="0,0,8,0"
                                VerticalAlignment="Center" Visibility="Collapsed"
                                Background="{ThemeResource DriftPillBrush}">
                            <TextBlock x:Name="SiteChipText" x:FieldModifier="internal" FontSize="14" />
                        </Border>
                        <TextBox x:Name="Box" x:FieldModifier="internal"
                                 Grid.Column="1"
                                 Style="{StaticResource CommandBoxStyle}"
                                 VerticalAlignment="Center"
                                 Padding="0,6,0,6"
                                 FontSize="16"
                                 PlaceholderText="Search or Enter URL..."
                                 AutomationProperties.Name="Search or enter URL"
                                 IsSpellCheckEnabled="False"
                                 IsTextPredictionEnabled="False"
                                 TextChanged="{x:Bind Owner.CommandBox_TextChanged}"
                                 PreviewKeyDown="{x:Bind Owner.CommandBox_PreviewKeyDown}" />
                    </Grid>
                    <!-- Ask AI (AskAiBar.cs): the key for it while there's something typed; in an
                         answer, the model answering. -->
                    <StackPanel x:Name="AskHint" x:FieldModifier="internal" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="Ask AI" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        <Border CornerRadius="4" Padding="6,1,6,2" Background="{ThemeResource DriftPillBrush}">
                            <TextBlock Text="Tab" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="AskModelLabel" x:FieldModifier="internal" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
                </Grid>
                <Border x:Name="Divider" x:FieldModifier="internal" Height="1" Background="{ThemeResource DriftDividerBrush}" Visibility="Collapsed" />
                <StackPanel x:Name="Results" x:FieldModifier="internal" Padding="4" Spacing="2" Visibility="Collapsed" />
                <ScrollViewer x:Name="AskScroller" x:FieldModifier="internal" Visibility="Collapsed"
                              HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                              ViewChanged="{x:Bind Owner.AskScroller_ViewChanged}">
                    <StackPanel x:Name="AskTranscript" x:FieldModifier="internal" Padding="18,14,18,16" Spacing="8" />
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
