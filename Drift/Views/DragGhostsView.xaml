<?xml version="1.0" encoding="utf-8"?>
<!-- What follows the pointer while a tab is dragged: a row over the tab lists, a tile over Essentials, a card of the page over the page (to split). Kept off-screen and photographed (RenderGhostsAsync) at the start of a drag. -->
<UserControl
    x:Class="Drift.DragGhostsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift"
    xmlns:models="using:Drift.Models">

    <Canvas>
        <Border x:Name="Row" x:FieldModifier="internal" Canvas.Left="-4000" Height="36" Padding="11,0"
                CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                Background="{ThemeResource DriftActiveBrush}">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon x:Name="RowGlyph" x:FieldModifier="internal" Glyph="&#xE774;" FontSize="14" Opacity="0.6"
                          Foreground="{ThemeResource DriftIconBrush}" />
                <Image x:Name="RowIcon" x:FieldModifier="internal" Width="16" Height="16" />
                <TextBlock x:Name="RowTitle" x:FieldModifier="internal" Grid.Column="1" FontSize="13"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Border x:Name="Tile" x:FieldModifier="internal" Canvas.Left="-4000" Canvas.Top="60" Height="43"
                CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                Background="{ThemeResource DriftActiveBrush}">
            <Grid>
                <FontIcon x:Name="TileGlyph" x:FieldModifier="internal" Glyph="&#xE774;" FontSize="16" Opacity="0.6"
                          Foreground="{ThemeResource DriftIconBrush}" />
                <Image x:Name="TileIcon" x:FieldModifier="internal" Width="18" Height="18" />
            </Grid>
        </Border>
        <Border x:Name="Page" x:FieldModifier="internal" Canvas.Left="-4000" Canvas.Top="120" Width="88" Height="116"
                CornerRadius="10" BorderThickness="1" Padding="8,0"
                BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                Background="{ThemeResource DriftActiveBrush}">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <Grid HorizontalAlignment="Center">
                    <FontIcon x:Name="PageGlyph" x:FieldModifier="internal" Glyph="&#xE774;" FontSize="18" Opacity="0.6"
                              Foreground="{ThemeResource DriftIconBrush}" />
                    <Image x:Name="PageIcon" x:FieldModifier="internal" Width="20" Height="20" />
                </Grid>
                <TextBlock x:Name="PageTitle" x:FieldModifier="internal" FontSize="12" HorizontalAlignment="Center"
                           TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
