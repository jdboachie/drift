<?xml version="1.0" encoding="utf-8"?>
<!-- Your newest downloads, rising above the library button while it's hovered (DownloadsPeek.cs): click one to open it, or drag it out. -->
<UserControl
    x:Class="Drift.DownloadPeekView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift"
    xmlns:models="using:Drift.Models">

    <Border x:Name="Card" x:FieldModifier="internal"
            Padding="4"
            VerticalAlignment="Bottom"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{ThemeResource DriftActiveBorderBrush}"
            Background="{ThemeResource DriftSwitcherBrush}"
            Opacity="0"
            Translation="0,8,0"
            IsHitTestVisible="False"
            PointerEntered="{x:Bind Owner.DownloadPeek_PointerEntered}"
            PointerExited="{x:Bind Owner.DownloadPeek_PointerExited}">
        <Border.OpacityTransition>
            <ScalarTransition Duration="0:0:0.15" />
        </Border.OpacityTransition>
        <Border.TranslationTransition>
            <Vector3Transition Duration="0:0:0.15" />
        </Border.TranslationTransition>
        <ListView x:Name="List" x:FieldModifier="internal"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="{x:Bind Owner.DownloadPeek_ItemClick}"
                  CanDragItems="True"
                  DragItemsStarting="{x:Bind Owner.DownloadItems_DragItemsStarting}"
                  DragItemsCompleted="{x:Bind Owner.DownloadItems_DragItemsCompleted}"
                  ItemContainerStyle="{StaticResource TabRowStyle}"
                  AutomationProperties.Name="Recent downloads">
            <ListView.ItemContainerTransitions>
                <TransitionCollection />
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DownloadItem">
                    <Grid ColumnSpacing="10" Padding="0,6" Background="Transparent"
                          Tag="{x:Bind}" ContextRequested="DownloadRow_ContextRequested"
                          AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind FileName, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <FontIcon Glyph="&#xE8A5;" FontSize="24"
                                      Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                      Foreground="{ThemeResource DriftIconBrush}" />
                            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind PeekStatus, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                            <ProgressBar Margin="0,3,0,0"
                                         Value="{x:Bind Percent, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                         Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Border>
</UserControl>
