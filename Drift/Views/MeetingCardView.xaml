<?xml version="1.0" encoding="utf-8"?>
<!-- The next meeting at the foot of the sidebar (MeetingCard.cs): a row with its name and countdown, on a
     tint of the accent; hovered, or from ten minutes before, a card with when, the call and who's coming,
     each with its icon in the calendar icon's column. -->
<UserControl
    x:Class="Drift.MeetingCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift">

    <Grid x:Name="Mover" x:FieldModifier="internal">
        <!-- What's cut back to the row while it grows (its visual's clip, MeetingCard.cs). -->
        <Grid x:Name="Body" x:FieldModifier="internal" Background="Transparent" Tapped="{x:Bind Owner.MeetingCard_Tapped}">
            <!-- The card itself, which stretches up past its top as it springs open. -->
            <Grid x:Name="Back" x:FieldModifier="internal">
                <!-- The row: a tint of the accent, as the calendar card's meetings are. -->
                <Border x:Name="Tint" x:FieldModifier="internal" CornerRadius="8" Background="{ThemeResource DriftCalendarEventBrush}" />
                <!-- Open, the tint gives way to WinUI's card, as Settings' rows are (the tint showing through it
                     turned it peach). -->
                <Border x:Name="Plate" x:FieldModifier="internal"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Opacity="0" />
            </Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!-- When, the call and who's coming: one icon a line, in the calendar icon's column. -->
                <StackPanel x:Name="Details" x:FieldModifier="internal" Margin="10,8,6,2" Spacing="8" Visibility="Collapsed" Opacity="0">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE823;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0" Foreground="{ThemeResource DriftIconBrush}" />
                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock x:Name="Soon" x:FieldModifier="internal" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Hours" x:FieldModifier="internal" FontSize="13"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Top" Margin="0,-2,0,0"
                                Click="{x:Bind Owner.MeetingCollapse_Click}"
                                AutomationProperties.Name="Collapse" ToolTipService.ToolTip="Collapse">
                            <FontIcon Glyph="&#xE70D;" FontSize="12" />
                        </Button>
                    </Grid>
                    <Grid x:Name="CallRow" x:FieldModifier="internal" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE714;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" />
                        <TextBlock x:Name="Call" x:FieldModifier="internal" Grid.Column="1" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid x:Name="PeopleRow" x:FieldModifier="internal" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" />
                        <!-- Each person's initial on their colour, overlapping, then "+3" (MeetingCard.cs). -->
                        <StackPanel x:Name="Faces" x:FieldModifier="internal" Grid.Column="1" Orientation="Horizontal" />
                        <TextBlock x:Name="People" x:FieldModifier="internal" Grid.Column="2" FontSize="12" Margin="0,0,0,1" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>

                <!-- The row: the meeting's name, and its countdown; open, Join (once it can be joined) and close. -->
                <Grid Grid.Row="1" Padding="10,0,6,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE787;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="Title" x:FieldModifier="internal" Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="Countdown" x:FieldModifier="internal" FontSize="12" FontWeight="SemiBold" Margin="0,0,4,1"
                                   VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <Button x:Name="Join" x:FieldModifier="internal" Content="Join" Style="{StaticResource AccentButtonStyle}"
                                FontSize="12" Height="26" Padding="11,0,11,1" MinHeight="0" MinWidth="0" CornerRadius="6"
                                VerticalAlignment="Center" Visibility="Collapsed" Click="{x:Bind Owner.MeetingJoinCard_Click}" />
                        <Button x:Name="Close" x:FieldModifier="internal" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                                Visibility="Collapsed" Click="{x:Bind Owner.MeetingClose_Click}"
                                AutomationProperties.Name="Close" ToolTipService.ToolTip="Close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
