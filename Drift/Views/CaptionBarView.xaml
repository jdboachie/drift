<?xml version="1.0" encoding="utf-8"?>
<!-- The window buttons (CaptionBar.cs): minimize, maximize and close, sliding down from the top edge when the pointer's there. -->
<UserControl
    x:Class="Drift.CaptionBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift"
    xmlns:models="using:Drift.Models">

    <Border x:Name="Panel" x:FieldModifier="internal"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            CornerRadius="0,0,0,8"
            Style="{StaticResource FloatingPanelStyle}"
            BorderThickness="1,0,0,1"
            Visibility="Collapsed"
            Translation="0,-56,32">
        <Border.Resources>
            <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="46" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource DriftIconBrush}" />
                <Setter Property="IsTabStop" Value="False" />
            </Style>
        </Border.Resources>
        <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource CaptionButtonStyle}" CornerRadius="0,0,0,7" Click="{x:Bind Owner.Minimize_Click}"
                    AutomationProperties.Name="Minimize">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                </Button.Resources>
                <FontIcon Glyph="&#xE921;" FontSize="10" />
            </Button>
            <Button Style="{StaticResource CaptionButtonStyle}" Click="{x:Bind Owner.Maximize_Click}"
                    AutomationProperties.Name="Maximize">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                </Button.Resources>
                <FontIcon x:Name="MaximizeGlyph" x:FieldModifier="internal" Glyph="&#xE922;" FontSize="10" />
            </Button>
            <Button Style="{StaticResource CaptionButtonStyle}" Click="{x:Bind Owner.CloseWindow_Click}"
                    AutomationProperties.Name="Close">
                <Button.Resources>
                    <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C83C31" />
                    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                </Button.Resources>
                <FontIcon Glyph="&#xE8BB;" FontSize="10" />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
