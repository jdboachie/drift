<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Drift.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Drift Settings">

    <!-- Laid out like Dia's settings: pages listed down the left, the page on the right with
         its settings grouped into cards (rows split by hairlines). Changes apply as they're made. -->
    <Grid Background="{ThemeResource DriftWindowBrush}">
        <!-- No title bar: the page list and the page run to the top edge, and the close button floats
             over the page's corner. The window drags from the empty top of the page (TitleBar, below). -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The pages. Windows 11's list marks the selected one with an accent bar, as Dia's does. -->
        <ListView x:Name="Nav" Padding="0,8,0,0" SelectionMode="Single" SelectionChanged="Nav_SelectionChanged">
            <ListViewItem Tag="general" AutomationProperties.Name="General">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE713;" FontSize="16" />
                    <TextBlock Text="General" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="tabs" AutomationProperties.Name="Tabs">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE737;" FontSize="16" />
                    <TextBlock Text="Tabs" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="ai" AutomationProperties.Name="AI">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE945;" FontSize="16" />
                    <TextBlock Text="AI" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="shortcuts" AutomationProperties.Name="Shortcuts">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE765;" FontSize="16" />
                    <TextBlock Text="Shortcuts" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="extensions" AutomationProperties.Name="Extensions">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xEA86;" FontSize="16" />
                    <TextBlock Text="Extensions" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="privacy" AutomationProperties.Name="Privacy">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon Glyph="&#xE72E;" FontSize="16" />
                    <TextBlock Text="Privacy" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- The page: a lighter layer with a hairline down its left side. -->
        <Border Grid.Column="1"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
            <!-- No sideways scrolling, so the page fits the window's width. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <Grid Padding="36,28,28,28">

                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Spacing="8">
                        <TextBlock Text="General" Style="{StaticResource SettingsTitleStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Default browser" />
                                        <TextBlock x:Name="DefaultBrowserText" Style="{StaticResource SettingsDescriptionStyle}"
                                                   TextWrapping="Wrap" Text="Open links from other apps in Drift" />
                                    </StackPanel>
                                    <Button x:Name="DefaultBrowserButton" Grid.Column="1" VerticalAlignment="Center"
                                            Content="Make default" Click="DefaultBrowser_Click" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Block ads and trackers" />
                                        <TextBlock x:Name="AdBlockText" Style="{StaticResource SettingsDescriptionStyle}"
                                                   TextWrapping="Wrap" Text="With uBlock Origin Lite" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AdBlockToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Block ads and trackers"
                                                  Toggled="AdBlockToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Tabs -->
                    <StackPanel x:Name="TabsPage" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Tabs" Style="{StaticResource SettingsTitleStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="When Drift closes" />
                                        <TextBlock Text="What happens to your tabs" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="CloseCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                              AutomationProperties.Name="When Drift closes"
                                              SelectionChanged="CloseCombo_SelectionChanged">
                                        <ComboBoxItem Content="Keep all tabs" />
                                        <ComboBoxItem Content="Keep Essentials and pinned" />
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Close Drift on a second click" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="CloseTwiceToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Close Drift on a second click"
                                                  Toggled="CloseTwiceToggle_Toggled" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Picture-in-picture when you leave a tab" />
                                        <TextBlock Text="A video that's playing floats in its own window" TextWrapping="Wrap"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PipToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Picture-in-picture when you leave a tab"
                                                  Toggled="PipToggle_Toggled" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl+Tab goes to recently used tabs" />
                                        <TextBlock Text="Off, it goes down the sidebar" TextWrapping="Wrap"
                                                   Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="RecentTabsToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Ctrl+Tab goes to recently used tabs"
                                                  Toggled="RecentTabsToggle_Toggled" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="When Drift opens" />
                                        <TextBlock Text="What's in front when you start Drift" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ComboBox x:Name="StartupCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                              AutomationProperties.Name="When Drift opens"
                                              SelectionChanged="StartupCombo_SelectionChanged">
                                        <ComboBoxItem Content="The tab you were on" />
                                        <ComboBoxItem Content="A new tab" />
                                        <ComboBoxItem Content="A specific page" />
                                    </ComboBox>
                                    <StackPanel x:Name="StartupPagePanel" Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"
                                                Visibility="Collapsed">
                                        <TextBox x:Name="StartupPageBox"
                                                 PlaceholderText="https://example.com"
                                                 AutomationProperties.Name="Startup page"
                                                 IsSpellCheckEnabled="False"
                                                 LostFocus="StartupPageBox_LostFocus"
                                                 KeyDown="StartupPageBox_KeyDown" />
                                        <TextBlock x:Name="StartupPageError" Style="{StaticResource SettingsDescriptionStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                                                   Text="Enter a web address, like example.com" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- AI: Ask AI in the command bar (AskAiBar.cs), with the Claude Code or Codex you have. -->
                    <StackPanel x:Name="AiPage" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="AI" Style="{StaticResource SettingsTitleStyle}" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Ask AI with Tab" />
                                        <TextBlock Text="In the command bar" Style="{StaticResource SettingsDescriptionStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AskTabToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Ask AI with Tab"
                                                  Toggled="AskTabToggle_Toggled" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Preferred provider" VerticalAlignment="Center" />
                                    <ComboBox x:Name="AskFirstCombo" Grid.Column="1" Width="160" VerticalAlignment="Center"
                                              AutomationProperties.Name="Preferred provider"
                                              SelectionChanged="AskFirstCombo_SelectionChanged">
                                        <ComboBoxItem Content="Claude" />
                                        <ComboBoxItem Content="Codex" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Claude" />
                                    <TextBlock x:Name="ClaudeStatus" Style="{StaticResource SettingsDescriptionStyle}" Text="Checking…" />
                                </StackPanel>
                                <Button x:Name="ClaudeAction" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="AiAction_Click" Tag="Claude" />
                                <ComboBox x:Name="ClaudeModelCombo" Grid.Column="2" Width="160" VerticalAlignment="Center"
                                          AutomationProperties.Name="Claude model"
                                          SelectionChanged="AiModelCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <Grid Style="{StaticResource SettingsRowStyle}" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Codex" />
                                    <TextBlock x:Name="CodexStatus" Style="{StaticResource SettingsDescriptionStyle}" Text="Checking…" />
                                </StackPanel>
                                <Button x:Name="CodexAction" Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed"
                                        Click="AiAction_Click" Tag="Codex" />
                                <ComboBox x:Name="CodexModelCombo" Grid.Column="2" Width="160" VerticalAlignment="Center"
                                          AutomationProperties.Name="Codex model"
                                          SelectionChanged="AiModelCombo_SelectionChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Shortcuts -->
                    <StackPanel x:Name="ShortcutsPage" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Shortcuts" Style="{StaticResource SettingsTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Margin="0,-4,0,4"
                                   Text="Click a shortcut, then press the keys you want. Esc cancels." />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel x:Name="ShortcutList" />
                        </Border>
                        <Button x:Name="ResetAllButton" Content="Reset all" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Click="ResetAll_Click" />
                    </StackPanel>

                    <!-- Extensions -->
                    <StackPanel x:Name="ExtensionsPage" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Extensions" Style="{StaticResource SettingsTitleStyle}" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Margin="0,-4,0,4"
                                   Text="Chrome and Edge extensions, added from their unpacked folder. They work in every page, but Drift has no toolbar, so their buttons and popups don't show." />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel x:Name="ExtensionList" />
                        </Border>
                        <TextBlock x:Name="ExtensionsError" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                        <Button Content="Add extension…" HorizontalAlignment="Right" Margin="0,8,0,0" Click="AddExtension_Click" />
                    </StackPanel>

                    <!-- Privacy: clearing what's kept, saving passwords, and what sites are allowed to do. -->
                    <StackPanel x:Name="PrivacyPage" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="Privacy" Style="{StaticResource SettingsTitleStyle}" />
                        <TextBlock Text="Clear browsing data" FontWeight="SemiBold" Margin="0,0,0,2" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Time range" VerticalAlignment="Center" />
                                    <ComboBox x:Name="ClearRangeCombo" Grid.Column="1" Width="200" VerticalAlignment="Center"
                                              AutomationProperties.Name="Time range">
                                        <ComboBoxItem Content="Last hour" />
                                        <ComboBoxItem Content="Last 24 hours" />
                                        <ComboBoxItem Content="Last 7 days" />
                                        <ComboBoxItem Content="Last 4 weeks" />
                                        <ComboBoxItem Content="All time" />
                                    </ComboBox>
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <StackPanel Padding="14,8,14,12" Spacing="0">
                                    <CheckBox x:Name="ClearHistoryCheck" AutomationProperties.Name="Browsing history" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock Text="Browsing history" />
                                            <TextBlock Text="The pages you've visited" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ClearCookiesCheck" AutomationProperties.Name="Cookies and site data" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock Text="Cookies and site data" />
                                            <TextBlock Text="Signs you out of most sites" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ClearCacheCheck" AutomationProperties.Name="Cached images and files" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock Text="Cached images and files" />
                                            <TextBlock Text="Some sites load more slowly the next time" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ClearDownloadsCheck" AutomationProperties.Name="Download list">
                                        <StackPanel>
                                            <TextBlock Text="Download list" />
                                            <TextBlock Text="The files themselves stay" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox x:Name="ClearPasswordsCheck" AutomationProperties.Name="Saved passwords">
                                        <StackPanel>
                                            <TextBlock Text="Saved passwords" />
                                            <TextBlock Text="And other saved form data" Style="{StaticResource SettingsDescriptionStyle}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid Margin="0,10,0,0" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ClearDataText" Style="{StaticResource SettingsDescriptionStyle}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                                        <Button x:Name="ClearDataButton" Grid.Column="1" Content="Clear data"
                                                Style="{StaticResource AccentButtonStyle}" Click="ClearData_Click" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Passwords and forms" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel>
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Offer to save passwords" />
                                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                                                   Text="Drift asks after you sign in, and fills them in next time. Kept on this PC, in Drift's profile." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="PasswordsToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Offer to save passwords"
                                                  Toggled="PasswordsToggle_Toggled" />
                                </Grid>
                                <Border Style="{StaticResource SettingsDividerStyle}" />
                                <Grid Style="{StaticResource SettingsRowStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Fill in forms" />
                                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                                                   Text="Names, addresses and other things you've typed before" />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="AutofillToggle" Grid.Column="1" VerticalAlignment="Center"
                                                  MinWidth="0" OnContent="" OffContent=""
                                                  AutomationProperties.Name="Fill in forms"
                                                  Toggled="AutofillToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Site permissions" FontWeight="SemiBold" Margin="0,12,0,2" />
                        <TextBlock Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" Margin="0,-2,0,4"
                                   Text="What you've allowed or blocked. To change a site's, open it and click the padlock in the address bar." />
                        <Border Style="{StaticResource SettingsGroupStyle}">
                            <StackPanel x:Name="PermissionList" />
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Invisible drag area: the top of the page, up to the close button. -->
        <Border x:Name="TitleBar" Grid.Column="1" Height="20" Margin="0,0,48,0" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
