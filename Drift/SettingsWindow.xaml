<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Drift.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift"
    Title="Drift Settings">

    <!-- Laid out like Arc's settings (on Mac): the pages as a toolbar along the top, the page's name
         in the title bar, and the page below in a centred column, its settings grouped into cards
         (rows split by hairlines). Changes apply as they're made. -->
    <Grid Background="{ThemeResource DriftWindowBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The title bar: drags the window; Windows' close button sits at its right end. -->
        <Border x:Name="TitleBar" Background="Transparent" />
        <TextBlock x:Name="PageTitle" Text="General" FontSize="13" FontWeight="SemiBold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />

        <!-- The pages. The one showing is filled, in the accent colour; it switches at once. -->
        <StackPanel x:Name="Toolbar" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                    Spacing="2" Padding="0,0,0,8">
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="general"
                         AutomationProperties.Name="General" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xE713;" FontSize="18" />
                    <TextBlock Text="General" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="accounts"
                         AutomationProperties.Name="Account" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xE77B;" FontSize="18" />
                    <TextBlock Text="Account" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="tabs"
                         AutomationProperties.Name="Tabs" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xE737;" FontSize="18" />
                    <TextBlock Text="Tabs" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="ai"
                         AutomationProperties.Name="AI" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xF4A5;" FontSize="18" />
                    <TextBlock Text="AI" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="shortcuts"
                         AutomationProperties.Name="Shortcuts" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xE765;" FontSize="18" />
                    <TextBlock Text="Shortcuts" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="extensions"
                         AutomationProperties.Name="Extensions" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xEA86;" FontSize="18" />
                    <TextBlock Text="Extensions" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
            <RadioButton Style="{StaticResource SettingsTabStyle}" GroupName="SettingsPages" Tag="privacy"
                         AutomationProperties.Name="Privacy" Checked="Page_Checked">
                <StackPanel Spacing="3">
                    <FontIcon Glyph="&#xE72E;" FontSize="18" />
                    <TextBlock Text="Privacy" FontSize="12" HorizontalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </StackPanel>

        <!-- The page: a lighter layer under a hairline. -->
        <Border Grid.Row="2"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <!-- No sideways scrolling, so the page fits the window's width. -->
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
                <!-- The column is centred by this full-width grid: centred by the ScrollViewer itself, it
                     kept the place it had at the window's first size. -->
                <Grid>
                <Grid MaxWidth="620" Padding="24,20,24,28">

                    <!-- General -->
                    <StackPanel x:Name="GeneralPage" Spacing="12">
                        <local:SettingsGroup>
                            <local:SettingsRow x:Name="DefaultBrowserRow" Header="Open links from other apps in Drift">
                                <Button x:Name="DefaultBrowserButton" Content="Make default" Click="DefaultBrowser_Click" />
                            </local:SettingsRow>
                            <!-- In Windows' own list too (Task Manager › Startup apps): StartAtSignIn.cs. -->
                            <local:SettingsRow x:Name="StartAtSignInRow" Header="Open Drift when you start your PC">
                                <ToggleSwitch x:Name="StartAtSignInToggle" Toggled="StartAtSignInToggle_Toggled" />
                            </local:SettingsRow>
                            <local:SettingsRow x:Name="AdBlockRow" Header="Block ads and trackers"
                                               Description="Drift uses uBlock Origin Lite to block them">
                                <ToggleSwitch x:Name="AdBlockToggle" Toggled="AdBlockToggle_Toggled" />
                            </local:SettingsRow>
                        </local:SettingsGroup>
                        <!-- Downloads: where they're saved, and how long they stay in the list. -->
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="Downloads" Style="{StaticResource SettingsCaptionStyle}" />
                            <local:SettingsGroup>
                                <local:SettingsRow x:Name="DownloadFolderRow" Header="Save downloads to" SizeChanged="DownloadFolderRow_SizeChanged">
                                    <!-- Where they go now, on the right as every row's value is: the whole path, losing its middle
                                         when it's too long, as iOS does (ShowDownloadFolder), so the label keeps its line. Then a
                                         button to change it. -->
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock x:Name="DownloadFolderText" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <Button Content="Change…" Click="DownloadFolder_Click" />
                                    </StackPanel>
                                </local:SettingsRow>
                                <!-- Each choice finishes the sentence, so none dangles ("…after Never"), and "keep… in
                                     the list" says the files aren't touched, with no line under it to take back "remove". -->
                                <local:SettingsRow Header="Keep downloads in the list">
                                    <ComboBox x:Name="KeepDownloadsCombo" Width="200" SelectionChanged="KeepDownloadsCombo_SelectionChanged">
                                        <ComboBoxItem Content="For a day" />
                                        <ComboBoxItem Content="For a week" />
                                        <ComboBoxItem Content="For a month" />
                                        <ComboBoxItem Content="Forever" />
                                    </ComboBox>
                                </local:SettingsRow>
                            </local:SettingsGroup>
                        </StackPanel>
                        <!-- Previews: what hovering a pinned tab shows, each on or off (ShowPreviews). A folder's is always on. -->
                        <StackPanel x:Name="PreviewsSection" Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="Previews" Style="{StaticResource SettingsCaptionStyle}" />
                            <TextBlock Style="{StaticResource SettingsIntroStyle}" Text="Hover a pinned tab to see what's in it, without opening it." />
                            <local:SettingsGroup x:Name="PreviewList" />
                            <!-- Not a preview (it comes by itself), so a group of its own. -->
                            <local:SettingsGroup>
                                <local:SettingsRow Header="Remind me a minute before a meeting"
                                                   Description="Works with a pinned Google or Outlook calendar">
                                    <ToggleSwitch x:Name="RemindersToggle" Toggled="RemindersToggle_Toggled" />
                                </local:SettingsRow>
                            </local:SettingsGroup>
                        </StackPanel>
                    </StackPanel>

                    <!-- Accounts (MicrosoftSignIn.cs): the Windows account, with what you can do about the
                         Microsoft sites it signs you in to right under it; then the switch, a setting of its own. -->
                    <StackPanel x:Name="AccountsPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsIntroStyle}"
                                   Text="Drift signs you in to Outlook, Office and other Microsoft sites with your Windows account." />
                        <local:SettingsGroup>
                            <Grid Padding="16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <PersonPicture x:Name="AccountPicture" Width="56" Height="56" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="AccountName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="AccountEmail" Style="{StaticResource SettingsDescriptionStyle}"
                                               TextTrimming="CharacterEllipsis" Text="Your Windows account" />
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                        <Button Content="Use another account"
                                                AutomationProperties.Name="Sign in with a different Microsoft account"
                                                Click="DifferentAccount_Click" />
                                        <Button x:Name="SignOutButton" Content="Sign out"
                                                AutomationProperties.Name="Sign out of Microsoft sites"
                                                Click="SignOut_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="SignOutText" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                                               Margin="0,8,0,0" Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </local:SettingsGroup>
                        <local:SettingsGroup>
                            <local:SettingsRow x:Name="SignInRow" Header="Sign me in to Microsoft sites automatically">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="SignInRestartButton" Content="Restart Drift" Visibility="Collapsed"
                                            Click="SignInRestart_Click" />
                                    <ToggleSwitch x:Name="SignInToggle" Toggled="SignInToggle_Toggled" />
                                </StackPanel>
                            </local:SettingsRow>
                        </local:SettingsGroup>
                    </StackPanel>

                    <!-- Tabs -->
                    <StackPanel x:Name="TabsPage" Spacing="12" Visibility="Collapsed">
                        <!-- What Drift opens with, and what it keeps when it closes. -->
                        <StackPanel Spacing="12">
                            <TextBlock Text="Opening and closing" Style="{StaticResource SettingsCaptionStyle}" />
                            <local:SettingsGroup>
                                <local:SettingsRow Header="When Drift opens, show">
                                    <ComboBox x:Name="StartupCombo" Width="220" SelectionChanged="StartupCombo_SelectionChanged">
                                        <ComboBoxItem Content="The tab I was on" />
                                        <ComboBoxItem Content="A new tab" />
                                        <ComboBoxItem Content="A page I choose" />
                                    </ComboBox>
                                    <local:SettingsRow.Below>
                                        <StackPanel x:Name="StartupPagePanel" Spacing="4" Visibility="Collapsed">
                                            <TextBox x:Name="StartupPageBox"
                                                     PlaceholderText="https://example.com"
                                                     AutomationProperties.Name="Startup page"
                                                     IsSpellCheckEnabled="False"
                                                     LostFocus="StartupPageBox_LostFocus"
                                                     KeyDown="StartupPageBox_KeyDown" />
                                            <TextBlock x:Name="StartupPageError" Style="{StaticResource SettingsDescriptionStyle}"
                                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed"
                                                       Text="Enter a web address, like example.com" />
                                        </StackPanel>
                                    </local:SettingsRow.Below>
                                </local:SettingsRow>
                                <local:SettingsRow Header="Load Essentials as soon as Drift opens">
                                    <ToggleSwitch x:Name="LoadEssentialsToggle" Toggled="LoadEssentialsToggle_Toggled" />
                                </local:SettingsRow>
                                <local:SettingsRow Header="When Drift closes, keep">
                                    <ComboBox x:Name="CloseCombo" Width="220" SelectionChanged="CloseCombo_SelectionChanged">
                                        <ComboBoxItem Content="All my tabs" />
                                        <ComboBoxItem Content="Only Essentials and pinned tabs" />
                                    </ComboBox>
                                </local:SettingsRow>
                                <local:SettingsRow Header="Warn before closing Drift">
                                    <ToggleSwitch x:Name="CloseTwiceToggle" Toggled="CloseTwiceToggle_Toggled" />
                                </local:SettingsRow>
                            </local:SettingsGroup>
                        </StackPanel>
                        <!-- Going from tab to tab, and what comes with you. -->
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="Switching tabs" Style="{StaticResource SettingsCaptionStyle}" />
                            <local:SettingsGroup>
                                <local:SettingsRow Header="Ctrl+Tab switches to recently used tabs"
                                                   Description="When off, it goes in sidebar order">
                                    <ToggleSwitch x:Name="RecentTabsToggle" Toggled="RecentTabsToggle_Toggled" />
                                </local:SettingsRow>
                                <local:SettingsRow Header="Switch to links you open in a new tab"
                                                   Description="This applies to Ctrl+click, middle-click and Open link in new tab">
                                    <ToggleSwitch x:Name="SwitchToNewTabsToggle" Toggled="SwitchToNewTabsToggle_Toggled" />
                                </local:SettingsRow>
                                <local:SettingsRow Header="Keep videos playing in a small window when you switch tabs">
                                    <ToggleSwitch x:Name="PipToggle" Toggled="PipToggle_Toggled" />
                                </local:SettingsRow>
                            </local:SettingsGroup>
                        </StackPanel>
                        <!-- Two-finger swipes on a touchpad (Swipe.cs). -->
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="Swiping" Style="{StaticResource SettingsCaptionStyle}" />
                            <local:SettingsGroup>
                                <local:SettingsRow Header="Slide the page with your fingers when you swipe back or forward"
                                                   Description="When off, an arrow shows at the side instead">
                                    <ToggleSwitch x:Name="SwipePageToggle" Toggled="SwipePageToggle_Toggled" />
                                </local:SettingsRow>
                                <local:SettingsRow Header="Swipe back closes a tab a link opened"
                                                   Description="Back to the tab you were on, as Safari and Arc do">
                                    <ToggleSwitch x:Name="SwipeClosesToggle" Toggled="SwipeClosesToggle_Toggled" />
                                </local:SettingsRow>
                            </local:SettingsGroup>
                        </StackPanel>
                        <!-- How a split's tabs sit in the sidebar. -->
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="Split View" Style="{StaticResource SettingsCaptionStyle}" />
                            <local:SettingsGroup>
                                <!-- Pictures of the sidebar (a tab, the split's box, a tab), as Dia shows its layouts. -->
                                <local:SettingsRow Header="Split View tabs">
                                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4">
                                        <local:PictureChoice x:Name="SplitVerticalChoice" Label="Vertical" GroupName="SplitRows" Picked="SplitRowsChoice_Picked">
                                            <StackPanel Spacing="3">
                                                <Border Style="{StaticResource PictureTabStyle}" Width="36" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                                <Border Style="{StaticResource PictureGroupStyle}">
                                                    <StackPanel Spacing="3">
                                                        <Border Style="{StaticResource PictureGroupTabStyle}" />
                                                        <Border Style="{StaticResource PictureGroupTabStyle}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource PictureTabStyle}" Width="28" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                            </StackPanel>
                                        </local:PictureChoice>
                                        <local:PictureChoice x:Name="SplitHorizontalChoice" Label="Horizontal" GroupName="SplitRows" Picked="SplitRowsChoice_Picked">
                                            <StackPanel Spacing="3">
                                                <Border Style="{StaticResource PictureTabStyle}" Width="36" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                                <Border Style="{StaticResource PictureGroupStyle}">
                                                    <Grid ColumnSpacing="3">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Style="{StaticResource PictureGroupTabStyle}" />
                                                        <Border Grid.Column="1" Style="{StaticResource PictureGroupTabStyle}" />
                                                    </Grid>
                                                </Border>
                                                <Border Style="{StaticResource PictureTabStyle}" Width="28" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                            </StackPanel>
                                        </local:PictureChoice>
                                    </StackPanel>
                                </local:SettingsRow>
                            </local:SettingsGroup>
                        </StackPanel>
                    </StackPanel>

                    <!-- AI: Ask AI in the command bar (AskAiBar.cs), with the Claude Code or Codex you have. -->
                    <StackPanel x:Name="AiPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsIntroStyle}"
                                   Text="Ask AI right from the command bar. Drift uses Claude Code or Codex, if you have them on this PC." />
                        <local:SettingsGroup>
                            <local:SettingsRow Header="Press Tab in the command bar to ask AI">
                                <ToggleSwitch x:Name="AskTabToggle" Toggled="AskTabToggle_Toggled" />
                            </local:SettingsRow>
                            <local:SettingsRow Header="Ask first" Description="If it isn't ready, Drift asks the other">
                                <ComboBox x:Name="AskFirstCombo" Width="160" SelectionChanged="AskFirstCombo_SelectionChanged">
                                    <ComboBoxItem Content="Claude" />
                                    <ComboBoxItem Content="Codex" />
                                </ComboBox>
                            </local:SettingsRow>
                        </local:SettingsGroup>
                        <local:SettingsGroup>
                            <local:SettingsRow x:Name="ClaudeRow" Header="Claude" Description="Checking…">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ClaudeAction" Visibility="Collapsed" Click="AiAction_Click" Tag="Claude" />
                                    <ComboBox x:Name="ClaudeModelCombo" Width="160" AutomationProperties.Name="Claude model"
                                              SelectionChanged="AiModelCombo_SelectionChanged" />
                                </StackPanel>
                            </local:SettingsRow>
                        </local:SettingsGroup>
                        <local:SettingsGroup>
                            <local:SettingsRow x:Name="CodexRow" Header="Codex" Description="Checking…">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="CodexAction" Visibility="Collapsed" Click="AiAction_Click" Tag="Codex" />
                                    <ComboBox x:Name="CodexModelCombo" Width="160" AutomationProperties.Name="Codex model"
                                              SelectionChanged="AiModelCombo_SelectionChanged" />
                                </StackPanel>
                            </local:SettingsRow>
                        </local:SettingsGroup>
                    </StackPanel>

                    <!-- Shortcuts -->
                    <StackPanel x:Name="ShortcutsPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsIntroStyle}"
                                   Text="Click a shortcut, then press the keys you'd like instead. Press Esc to cancel." />
                        <TextBox x:Name="ShortcutSearchBox" PlaceholderText="Search shortcuts" IsSpellCheckEnabled="False"
                                 AutomationProperties.Name="Search shortcuts" TextChanged="ShortcutSearch_TextChanged" />
                        <!-- A section per group (ShortcutAction.Group), each a caption over its card (BuildShortcuts). -->
                        <StackPanel x:Name="ShortcutSections" Spacing="12" />
                        <TextBlock x:Name="ShortcutsEmpty" Style="{StaticResource SettingsIntroStyle}" HorizontalAlignment="Center"
                                   Margin="0,24,0,0" Text="No shortcuts match" Visibility="Collapsed" />
                        <Button x:Name="ResetAllButton" Content="Reset all shortcuts" HorizontalAlignment="Right" Margin="0,8,0,0"
                                Click="ResetAll_Click" />
                    </StackPanel>

                    <!-- Extensions -->
                    <StackPanel x:Name="ExtensionsPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SettingsIntroStyle}"
                                   Text="Add Chrome and Edge extensions from their unzipped folder. They work on every page, but Drift doesn't have a toolbar yet, so you won't see their buttons or popups." />
                        <local:SettingsGroup x:Name="ExtensionList" />
                        <TextBlock x:Name="ExtensionsError" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                        <Button Content="Add extension…" HorizontalAlignment="Right" Margin="0,8,0,0" Click="AddExtension_Click" />
                    </StackPanel>

                    <!-- Privacy: clearing what's kept, saving passwords, and what sites are allowed to do. -->
                    <StackPanel x:Name="PrivacyPage" Spacing="12" Visibility="Collapsed">
                        <TextBlock Text="Clear browsing data" Style="{StaticResource SettingsCaptionStyle}" />
                        <local:SettingsGroup>
                            <local:SettingsRow Header="Clear data from">
                                <ComboBox x:Name="ClearRangeCombo" Width="200">
                                    <ComboBoxItem Content="Last hour" />
                                    <ComboBoxItem Content="Last 24 hours" />
                                    <ComboBoxItem Content="Last 7 days" />
                                    <ComboBoxItem Content="Last 4 weeks" />
                                    <ComboBoxItem Content="All time" />
                                </ComboBox>
                            </local:SettingsRow>
                            <!-- Just the names: what clearing cookies costs is said when you click Clear (Warnings.ClearData). -->
                            <local:SettingsRow Padding="14,6,14,12">
                                <local:SettingsRow.Below>
                                    <StackPanel Spacing="2">
                                        <CheckBox x:Name="ClearHistoryCheck" Content="Browsing history" AutomationProperties.Name="Browsing history" IsChecked="True" />
                                        <CheckBox x:Name="ClearCookiesCheck" Content="Cookies and site data" AutomationProperties.Name="Cookies and site data" IsChecked="True" />
                                        <CheckBox x:Name="ClearCacheCheck" Content="Cached images and files" AutomationProperties.Name="Cached images and files" IsChecked="True" />
                                        <CheckBox x:Name="ClearDownloadsCheck" Content="Download history" AutomationProperties.Name="Download history" />
                                        <CheckBox x:Name="ClearPasswordsCheck" Content="Passwords and form data" AutomationProperties.Name="Passwords and form data" />
                                        <Grid Margin="0,10,0,0" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="ClearDataText" Style="{StaticResource SettingsDescriptionStyle}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button x:Name="ClearDataButton" Grid.Column="1" Content="Clear data"
                                                    Style="{StaticResource AccentButtonStyle}" Click="ClearData_Click" />
                                        </Grid>
                                    </StackPanel>
                                </local:SettingsRow.Below>
                            </local:SettingsRow>
                        </local:SettingsGroup>

                        <TextBlock Text="Passwords and forms" Style="{StaticResource SettingsCaptionStyle}" Margin="4,8,0,-6" />
                        <local:SettingsGroup>
                            <local:SettingsRow Header="Offer to save passwords"
                                               Description="Drift asks when you sign in, then fills them in next time. They stay on this PC.">
                                <ToggleSwitch x:Name="PasswordsToggle" Toggled="PasswordsToggle_Toggled" />
                            </local:SettingsRow>
                            <local:SettingsRow Header="Fill in forms"
                                               Description="Names, addresses and other things you've typed before">
                                <ToggleSwitch x:Name="AutofillToggle" Toggled="AutofillToggle_Toggled" />
                            </local:SettingsRow>
                        </local:SettingsGroup>

                        <TextBlock Text="Site permissions" Style="{StaticResource SettingsCaptionStyle}" Margin="4,8,0,-6" />
                        <TextBlock Style="{StaticResource SettingsIntroStyle}"
                                   Text="What you've let sites do, like use your camera or send notifications, and what you've blocked. To change a site's, open it and click the padlock in the address bar." />
                        <local:SettingsGroup x:Name="PermissionList" />
                    </StackPanel>
                </Grid>
                </Grid>
            </ScrollViewer>
        </Border>

    </Grid>
</Window>
