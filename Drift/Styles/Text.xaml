<?xml version="1.0" encoding="utf-8"?>
<!-- Drift's font and its text styles, which the rest build on. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift">

    <!-- Drift's font: Segoe UI Variable (Windows 11), else Segoe UI. Controls take it from
         ContentControlThemeFontFamily; plain text from the TextBlock style below, which Drift's
         own text styles build on (a style of their own would otherwise drop it). -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

    <Style x:Key="DriftTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource DriftTextStyle}" />

    <Style TargetType="RichTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>

</ResourceDictionary>
