<?xml version="1.0" encoding="utf-8"?>
<!-- Drift's colours, light and dark: Windows' own neutrals and acrylic, translucent chips on top, and near-white
     for whatever is active. Used as ThemeResource, so they follow the theme as it changes. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!-- Plain acrylic: no tint of Drift's own over it, so the windows behind show through. -->
            <SolidColorBrush x:Key="DriftWindowBrush" Color="Transparent" />
            <!-- The sidebar floats over the page when hidden, so it needs its own backdrop. -->
            <StaticResource x:Key="DriftFloatingSidebarBrush" ResourceKey="AcrylicBackgroundFillColorBaseBrush" />
            <SolidColorBrush x:Key="DriftPageBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DriftPageBorderBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="DriftFocusedPageBorderBrush" Color="#38000000" />
            <SolidColorBrush x:Key="DriftPillBrush" Color="#14000000" />
            <SolidColorBrush x:Key="DriftPillHoverBrush" Color="#1C000000" />
            <SolidColorBrush x:Key="DriftTileBrush" Color="#0D000000" />
            <SolidColorBrush x:Key="DriftHoverBrush" Color="#14000000" />
            <SolidColorBrush x:Key="DriftActiveBrush" Color="#F9F9F9" />
            <!-- The selected tab or tile: see-through, so the acrylic carries on under it. -->
            <SolidColorBrush x:Key="DriftSelectedBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="DriftActiveBorderBrush" Color="#14000000" />
            <!-- The selected tab's edge, as Arc's: faint along the top, darker along the bottom, and
                 a hairline of shadow under it, so it sits a little above the sidebar. -->
            <LinearGradientBrush x:Key="DriftSelectedEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#08000000" />
                <GradientStop Offset="0.5" Color="#0A000000" />
                <GradientStop Offset="1" Color="#14000000" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriftSelectedShadowBrush" Color="#05000000" />
            <!-- A folder's card (FolderCard.cs), as Dia's groups: a light frost the sidebar shows through,
                 with a hairline round it. Translucent rather than acrylic: the sidebar's colour is the window's
                 own backdrop, which an in-app acrylic can't see through to (it comes out solid). -->
            <SolidColorBrush x:Key="DriftFolderCardBrush" Color="#59FFFFFF" />
            <!-- The page controls' pill over a page: solid, so the page under it never shows through. -->
            <SolidColorBrush x:Key="DriftPageControlsBrush" Color="#F9F9F9" />
            <SolidColorBrush x:Key="DriftFolderCardBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="DriftDividerBrush" Color="#1A000000" />
            <!-- Where a dragged tab will land beside the page (split view). -->
            <SolidColorBrush x:Key="DriftIconBrush" Color="#474747" />
            <SolidColorBrush x:Key="DriftSecondaryTextBrush" Color="#666666" />
            <!-- A meeting on the calendar card: a tint of the accent, as Arc's are of the Space's colour. -->
            <SolidColorBrush x:Key="DriftCalendarEventBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.16" />
            <SolidColorBrush x:Key="DriftCalendarEventHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.24" />
            <SolidColorBrush x:Key="DriftCalendarEventPressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.2" />
            <!-- The people coming to a meeting (MeetingCardView): an initial in white on one of these, the same
                 one every time for the same name, ringed in the card's colour; then "+3" on the last. -->
            <SolidColorBrush x:Key="DriftFace0Brush" Color="#B4421A" />
            <SolidColorBrush x:Key="DriftFace1Brush" Color="#0F766E" />
            <SolidColorBrush x:Key="DriftFace2Brush" Color="#6D28D9" />
            <SolidColorBrush x:Key="DriftFace3Brush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="DriftFace4Brush" Color="#9D174D" />
            <SolidColorBrush x:Key="DriftFace5Brush" Color="#4D7C0F" />
            <SolidColorBrush x:Key="DriftFaceMoreBrush" Color="#475569" />
            <SolidColorBrush x:Key="DriftFaceRingBrush" Color="#F6F6F6" />
            <SolidColorBrush x:Key="DriftPeekButtonBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DriftPeekButtonHoverBrush" Color="#F3F3F3" />
            <SolidColorBrush x:Key="DriftPeekButtonPressedBrush" Color="#EBEBEB" />
            <SolidColorBrush x:Key="DriftPeekButtonBorderBrush" Color="#1A000000" />
            <!-- The square holding a Peek page's icon at the end of a pinned row. -->
            <SolidColorBrush x:Key="DriftPeekBadgeBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="DriftPeekBadgeBorderBrush" Color="#1F000000" />
            <!-- The command bar's card (Ctrl+T, Ctrl+L). -->
            <SolidColorBrush x:Key="DriftCommandBarBrush" Color="#FFFFFF" />
            <!-- Ctrl+Tab's bar, frosted over the page. -->
            <StaticResource x:Key="DriftSwitcherBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <!-- Private windows: a violet tint over the acrylic, and a badge saying so. -->
            <SolidColorBrush x:Key="DriftPrivateWindowBrush" Color="#337A5AC8" />
            <SolidColorBrush x:Key="DriftPrivateBadgeBrush" Color="#337A5AC8" />
            <SolidColorBrush x:Key="DriftPrivateBadgeTextBrush" Color="#4B2E8F" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DriftWindowBrush" Color="Transparent" />
            <StaticResource x:Key="DriftFloatingSidebarBrush" ResourceKey="AcrylicBackgroundFillColorBaseBrush" />
            <SolidColorBrush x:Key="DriftPageBrush" Color="#1C1C1C" />
            <SolidColorBrush x:Key="DriftPageBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="DriftFocusedPageBorderBrush" Color="#47FFFFFF" />
            <SolidColorBrush x:Key="DriftPillBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="DriftPillHoverBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="DriftTileBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="DriftHoverBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="DriftActiveBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="DriftSelectedBrush" Color="#2EFFFFFF" />
            <SolidColorBrush x:Key="DriftActiveBorderBrush" Color="#1FFFFFFF" />
            <LinearGradientBrush x:Key="DriftSelectedEdgeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#24FFFFFF" />
                <GradientStop Offset="0.5" Color="#14FFFFFF" />
                <GradientStop Offset="1" Color="#0AFFFFFF" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="DriftSelectedShadowBrush" Color="#1F000000" />
            <SolidColorBrush x:Key="DriftFolderCardBrush" Color="#0EFFFFFF" />
            <SolidColorBrush x:Key="DriftPageControlsBrush" Color="#2C2C2C" />
            <SolidColorBrush x:Key="DriftFolderCardBorderBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="DriftDividerBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="DriftIconBrush" Color="#D3D3D3" />
            <SolidColorBrush x:Key="DriftSecondaryTextBrush" Color="#A0A0A0" />
            <SolidColorBrush x:Key="DriftCalendarEventBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.28" />
            <SolidColorBrush x:Key="DriftCalendarEventHoverBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.38" />
            <SolidColorBrush x:Key="DriftCalendarEventPressedBrush" Color="{ThemeResource SystemAccentColor}" Opacity="0.33" />
            <SolidColorBrush x:Key="DriftFace0Brush" Color="#B4421A" />
            <SolidColorBrush x:Key="DriftFace1Brush" Color="#0F766E" />
            <SolidColorBrush x:Key="DriftFace2Brush" Color="#6D28D9" />
            <SolidColorBrush x:Key="DriftFace3Brush" Color="#1D4ED8" />
            <SolidColorBrush x:Key="DriftFace4Brush" Color="#9D174D" />
            <SolidColorBrush x:Key="DriftFace5Brush" Color="#4D7C0F" />
            <SolidColorBrush x:Key="DriftFaceMoreBrush" Color="#475569" />
            <SolidColorBrush x:Key="DriftFaceRingBrush" Color="#2E2E2E" />
            <SolidColorBrush x:Key="DriftPeekButtonBrush" Color="#2D2D2D" />
            <SolidColorBrush x:Key="DriftPeekButtonHoverBrush" Color="#383838" />
            <SolidColorBrush x:Key="DriftPeekButtonPressedBrush" Color="#323232" />
            <SolidColorBrush x:Key="DriftPeekBadgeBrush" Color="#525252" />
            <SolidColorBrush x:Key="DriftPeekBadgeBorderBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="DriftPeekButtonBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="DriftCommandBarBrush" Color="#2C2C2C" />
            <StaticResource x:Key="DriftSwitcherBrush" ResourceKey="AcrylicInAppFillColorDefaultBrush" />
            <SolidColorBrush x:Key="DriftPrivateWindowBrush" Color="#4D2A1F4A" />
            <SolidColorBrush x:Key="DriftPrivateBadgeBrush" Color="#4D9A7AE8" />
            <SolidColorBrush x:Key="DriftPrivateBadgeTextBrush" Color="#E4DAFF" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>
