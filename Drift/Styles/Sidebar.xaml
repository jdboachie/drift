<?xml version="1.0" encoding="utf-8"?>
<!-- The sidebar's lists: an Essential's tile, a tab's row, a folder's header and a split's row, and the cards
     drawn under them. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift">

    <!-- Pinned tab tile. A plain template: the chip and the content are siblings,
         so the Peek badge in the item template can overhang the corner. -->
    <Style x:Key="PinnedTileStyle" TargetType="GridViewItem">
        <!-- 10 between tiles, as Arc's. -->
        <Setter Property="Margin" Value="5" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftSelectedBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource DriftActiveBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftSelectedBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource DriftActiveBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftSelectedBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource DriftActiveBorderBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Chip"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="Transparent"
                                Background="{ThemeResource DriftTileBrush}" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Regular tab row: transparent until hovered, near-white when active. Arc's measures: 38 tall,
         44 apart. -->
    <Style x:Key="TabRowStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftHoverBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftSelectedBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource DriftSelectedEdgeBrush}" />
                                        <Setter Target="Lift.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOverSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftSelectedBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource DriftSelectedEdgeBrush}" />
                                        <Setter Target="Lift.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PressedSelected">
                                    <VisualState.Setters>
                                        <Setter Target="Chip.Background" Value="{ThemeResource DriftSelectedBrush}" />
                                        <Setter Target="Chip.BorderBrush" Value="{ThemeResource DriftSelectedEdgeBrush}" />
                                        <Setter Target="Lift.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <!-- The selected tab's shadow: a pixel of it below the card, as Arc's. -->
                        <Border x:Name="Lift"
                                CornerRadius="8"
                                Margin="0,1,0,-1"
                                Background="{ThemeResource DriftSelectedShadowBrush}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Grid x:Name="Chip"
                              CornerRadius="8"
                              BorderThickness="1"
                              BorderBrush="Transparent"
                              Background="Transparent"
                              Padding="10,0,4,0">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The half you're on of a split's row, on the row's card (Split.cs): a selected tab's card. -->
    <Style x:Key="SplitFrontCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DriftSelectedBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DriftSelectedEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <!-- A piece of a folder's card, made for each row in code (Folders.cs, IndentFolderRow). -->
    <Style x:Key="FolderCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource DriftFolderCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DriftFolderCardBorderBrush}" />
    </Style>

    <!-- A folder's header in the folder list (FolderRowStyleSelector): a tab row's layout, without the
         hover fill or selection (a closed one shows its card on hover, Folders.cs). -->
    <Style x:Key="FolderHeaderRowStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid>
                        <Grid x:Name="Chip" Background="Transparent" Padding="10,0,4,0">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="Center" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A split's row (Split.cs): no card or padding of its own. Its two halves fill it edge to edge, each
         with its own hover, and the selected-tab card sits on the half you're on. -->
    <Style x:Key="SplitRowStyle" TargetType="ListViewItem">
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid CornerRadius="8" Background="Transparent">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
