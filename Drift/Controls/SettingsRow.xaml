<?xml version="1.0" encoding="utf-8"?>
<!-- A row of a settings card (SettingsRow.xaml.cs): what it is, a quieter line under it, and its control on the right;
     sometimes more underneath (a box to type in). The card (SettingsGroup) draws the hairline above it. -->
<UserControl
    x:Class="Drift.SettingsRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border x:Name="Line" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid x:Name="Root" Style="{StaticResource SettingsRowStyle}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- The first takes the row's least height (44), so a lone line sits in its middle. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeaderText" x:FieldModifier="internal" TextWrapping="Wrap" Visibility="Collapsed" />
                <TextBlock x:Name="DescriptionText" x:FieldModifier="internal" Style="{StaticResource SettingsDescriptionStyle}"
                           TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
            <ContentPresenter x:Name="TrailingPresenter" Grid.Column="1" VerticalAlignment="Center" />
            <ContentPresenter x:Name="BelowPresenter" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
