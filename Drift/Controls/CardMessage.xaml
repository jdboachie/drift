<?xml version="1.0" encoding="utf-8"?>
<!-- Why a card has nothing to show, and what to do about it (Try again, Sign in), centred where its list would be. -->
<UserControl
    x:Class="Drift.CardMessage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"
    Visibility="Collapsed">
    <StackPanel Spacing="10">
        <TextBlock x:Name="MessageText" FontSize="13" HorizontalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
        <Button x:Name="ActionButton" HorizontalAlignment="Center" Visibility="Collapsed" Click="Action_Click" />
    </StackPanel>
</UserControl>
