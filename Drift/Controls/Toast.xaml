<?xml version="1.0" encoding="utf-8"?>
<!-- A toast (Toast.xaml.cs): a floating line at the foot of the page (Undo, Bookmarked, Copied link) or under the
     window buttons (Press again to close), or a notice (an icon, a title over a quieter line, and choices).
     One look for all of them; MainWindow places each. -->
<UserControl
    x:Class="Drift.Toast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Visibility="Collapsed">

    <Border x:Name="Surface"
            Padding="14,8"
            CornerRadius="10"
            Style="{StaticResource FloatingPanelStyle}"
            Opacity="0"
            IsHitTestVisible="False"
            Translation="0,0,32"
            PointerEntered="Surface_PointerEntered"
            PointerExited="Surface_PointerExited">
        <Border.OpacityTransition>
            <ScalarTransition Duration="0:0:0.15" />
        </Border.OpacityTransition>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <!-- A notice's icon (a logo, say), or a line's glyph: plain, or in the accent colour. -->
            <ContentPresenter x:Name="IconPresenter" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="Collapsed" />
            <FontIcon x:Name="PlainGlyph" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"
                      Foreground="{ThemeResource DriftIconBrush}" />
            <FontIcon x:Name="AccentGlyph" FontSize="13" VerticalAlignment="Center" Visibility="Collapsed"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            <StackPanel x:Name="Texts" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="13" MaxWidth="480" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" FontSize="12" MaxWidth="480" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
            </StackPanel>
            <Button x:Name="Action1" Style="{StaticResource AccentButtonStyle}" FontSize="13"
                    VerticalAlignment="Center" Click="Action_Click" Visibility="Collapsed" />
            <Button x:Name="Action2" Style="{StaticResource SubtleButtonStyle}" FontSize="13"
                    VerticalAlignment="Center" Click="Action_Click" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</UserControl>
