<?xml version="1.0" encoding="utf-8"?>
<!-- A card an integration hangs from its pinned tab while you hover it, as Arc's since its 2023 redesign
     (Integrations.cs): the card's own content (Body) from edge to edge, with no header, and + to make a new one
     floating over its bottom-right corner. It grows out of the tab's corner and fades (its own scale and opacity
     transitions, driven by Integrations.cs). -->
<UserControl
    x:Class="Drift.HoverCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Top"
    Visibility="Collapsed"
    Opacity="0">
    <UserControl.OpacityTransition>
        <ScalarTransition Duration="0:0:0.12" />
    </UserControl.OpacityTransition>
    <UserControl.ScaleTransition>
        <Vector3Transition Duration="0:0:0.15" />
    </UserControl.ScaleTransition>

    <Border CornerRadius="12"
            Style="{StaticResource FloatingPanelStyle}"
            Background="{ThemeResource DriftCommandBarBrush}"
            Translation="0,0,48">
        <Grid>
            <ContentPresenter Content="{x:Bind Body, Mode=OneWay}" />
            <Button Style="{StaticResource PeekButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,10,10"
                    Click="Action_Click"
                    AutomationProperties.Name="{x:Bind ActionName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ActionName, Mode=OneWay}">
                <FontIcon Glyph="&#xE710;" FontSize="12" Foreground="{ThemeResource DriftIconBrush}" />
            </Button>
        </Grid>
    </Border>
</UserControl>
