<?xml version="1.0" encoding="utf-8"?>
<!-- A row in the sidebar's tab lists (TabRowTemplate), pinned (PinnedList) and regular (TabList): favicon and title,
     or a split's pages one under another (Split.cs); on hover, its end button (RowAction_Click). A split with a pinned tab
     has its row in PinnedList, in that tab's place. Tabs in folders use it too (FolderList), with a dot while a live
     folder's tab is new. What's done in it is the window's (MainWindow.Of). -->
<UserControl
    x:Class="Drift.TabRowView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift">

    <Grid ColumnSpacing="10" Background="Transparent"
          AutomationProperties.Name="{x:Bind Tab.Title, Mode=OneWay}"
          PointerEntered="TabRow_PointerEntered"
          PointerExited="TabRow_PointerExited"
          Tapped="TabRow_Tapped">
        <Grid.ContextFlyout>
            <MenuFlyout ShouldConstrainToRootBounds="False" Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed" />
        </Grid.ContextFlyout>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Visibility="{x:Bind Tab.SingleVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                      Visibility="{x:Bind Tab.PlaceholderVisibility, Mode=OneWay}" />
            <Image Source="{x:Bind Tab.Favicon, Mode=OneWay}" Width="16" Height="16"
                   Opacity="{x:Bind Tab.ContentOpacity, Mode=OneWay}" />
        </Grid>
        <Grid Grid.Column="1" ColumnSpacing="6" Margin="{x:Bind Tab.TitleEndMargin, Mode=OneWay}" Visibility="{x:Bind Tab.SingleVisibility, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
            <Button Width="20" Height="20"
                    Tag="{x:Bind Tab, Mode=OneWay}"
                    Click="TabAudio_Click"
                    Style="{StaticResource TabCloseButtonStyle}"
                    Visibility="{x:Bind Tab.AudioVisibility, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind Tab.AudioName, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Tab.AudioName, Mode=OneWay}">
                <FontIcon Glyph="{x:Bind Tab.AudioGlyph, Mode=OneWay}" FontSize="12" />
            </Button>
            <TextBlock Grid.Column="1"
                       Opacity="{x:Bind Tab.ContentOpacity, Mode=OneWay}"
                       Text="{x:Bind Tab.Title, Mode=OneWay}"
                       Visibility="{x:Bind local:Ui.Hidden(Tab.IsRenaming), Mode=OneWay}"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <!-- Rename… in its menu: the title, in place (TabMenu.cs). -->
            <TextBox Grid.Column="1" Grid.ColumnSpan="2"
                       Tag="{x:Bind Tab, Mode=OneWay}"
                       Visibility="{x:Bind local:Ui.Shown(Tab.IsRenaming), Mode=OneWay}"
                       Margin="-6,0,4,0" Padding="5,4,5,4" MinHeight="28" FontSize="14"
                       VerticalAlignment="Center"
                       AutomationProperties.Name="Tab name"
                       KeyDown="TabName_KeyDown"
                       LostFocus="TabName_LostFocus" />
            <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m". Join is on the meeting card (MeetingCard.cs). -->
            <TextBlock Grid.Column="2" Text="{x:Bind Tab.MeetingText, Mode=OneWay}" FontSize="12"
                       VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                       Visibility="{x:Bind Tab.MeetingTextVisibility, Mode=OneWay}" />
        <!-- New in a live folder (LiveFolders.cs), until it's opened. -->
        <Ellipse Grid.Column="2" Width="6" Height="6" Margin="0,0,6,0"
                 VerticalAlignment="Center"
                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                 Visibility="{x:Bind Tab.NewVisibility, Mode=OneWay}"
                 AutomationProperties.Name="New" />
        </Grid>
        <!-- Split view (Split.cs): one box for all its pages, one under another, each a tab's row of its own, as
             Search Browser's are (the left page on top); or, if Settings › Tabs says so, side by side in one row
             as they are on screen, each filling its column (LayOutSplitRow puts them in their rows or columns;
             as written here, they're one under another). While the split is the tab you're on, the selected-tab
             card sits on the page you're on, and is on the other at once when you switch (PlaceSplitCard). On
             hover a page shows its × at its end. -->
        <Grid Grid.ColumnSpan="2" Visibility="{x:Bind Tab.SplitVisibility, Mode=OneWay}" SizeChanged="SplitRow_SizeChanged">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="{x:Bind Tab.Split.Gap3Width, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind Tab.Split.Slot3Width, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind Tab.Split.Gap4Width, Mode=OneWay}" />
                <ColumnDefinition Width="{x:Bind Tab.Split.Slot4Width, Mode=OneWay}" />
            </Grid.ColumnDefinitions>
            <Border Grid.RowSpan="4" Grid.ColumnSpan="7" HorizontalAlignment="Left" Tag="{x:Bind Tab, Mode=OneWay}"
                    CornerRadius="10" BorderThickness="1" IsHitTestVisible="False" Opacity="0"
                    Background="{ThemeResource DriftFolderCardBrush}"
                    BorderBrush="{ThemeResource DriftFolderCardBorderBrush}"
                    Loaded="SplitCard_Loaded">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Border.OpacityTransition>
            </Border>
            <local:SplitPageView Grid.Row="0" Grid.ColumnSpan="7" Height="38" Page="{x:Bind Tab.Split.Page1, Mode=OneWay}"
                                 Loaded="SplitHalf_Loaded" Tapped="SplitHalf_Tapped" CloseClick="CloseSplitHalf_Click"
                                 PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited" />
            <local:SplitPageView Grid.Row="1" Grid.ColumnSpan="7" Height="38" Page="{x:Bind Tab.Split.Page2, Mode=OneWay}"
                                 Loaded="SplitHalf_Loaded" Tapped="SplitHalf_Tapped" CloseClick="CloseSplitHalf_Click"
                                 PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited" />
            <local:SplitPageView Grid.Row="2" Grid.ColumnSpan="7" Height="38" Page="{x:Bind Tab.Split.Page3, Mode=OneWay}" Visibility="{x:Bind Tab.Split.Slot3Visibility, Mode=OneWay}"
                                 Loaded="SplitHalf_Loaded" Tapped="SplitHalf_Tapped" CloseClick="CloseSplitHalf_Click"
                                 PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited" />
            <local:SplitPageView Grid.Row="3" Grid.ColumnSpan="7" Height="38" Page="{x:Bind Tab.Split.Page4, Mode=OneWay}" Visibility="{x:Bind Tab.Split.Slot4Visibility, Mode=OneWay}"
                                 Loaded="SplitHalf_Loaded" Tapped="SplitHalf_Tapped" CloseClick="CloseSplitHalf_Click"
                                 PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited" />
        </Grid>
        <!-- Shown on hover, like Arc: a pinned tab's −/×, a regular tab's × (RowActionGlyph). A split's row has one per half instead. -->
        <Button Grid.Column="1" HorizontalAlignment="Right"
                Opacity="0"
                Visibility="{x:Bind Tab.SingleVisibility, Mode=OneWay}"
                Tag="{x:Bind Tab, Mode=OneWay}"
                Click="RowAction_Click"
                Margin="{x:Bind Tab.RowButtonMargin, Mode=OneWay}"
                Style="{StaticResource TabCloseButtonStyle}"
                AutomationProperties.Name="{x:Bind Tab.RowActionName, Mode=OneWay}"
                ToolTipService.ToolTip="{x:Bind Tab.RowActionName, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind Tab.RowActionGlyph, Mode=OneWay}" FontSize="10" />
        </Button>
        <!-- While this tab has a page open in Peek, that page's icon sits at the row's end, as on pinned rows. -->
        <Border Grid.Column="1"
                Width="24" Height="24"
                HorizontalAlignment="Right"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                Background="{ThemeResource DriftPeekBadgeBrush}"
                Visibility="{x:Bind Tab.PeekBadgeVisibility, Mode=OneWay}"
                AutomationProperties.Name="Open in Peek">
            <Grid>
                <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                          Visibility="{x:Bind Tab.PeekPlaceholderVisibility, Mode=OneWay}" />
                <Image Source="{x:Bind Tab.PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
