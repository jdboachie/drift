<?xml version="1.0" encoding="utf-8"?>
<!-- An Essential's tile (EssentialList): its favicon, a calendar's next meeting and Join, its Peek's icon on the
     corner, and a speaker while it plays sound. What's done in it is the window's (MainWindow.Of). -->
<UserControl
    x:Class="Drift.EssentialTileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Drift">

    <Grid Height="48" Background="Transparent"
          AutomationProperties.Name="{x:Bind Tab.Title, Mode=OneWay}"
          ToolTipService.ToolTip="{x:Bind Tab.Title, Mode=OneWay}"
          PointerEntered="IntegrationAnchor_PointerEntered"
          PointerExited="IntegrationAnchor_PointerExited">
        <Grid.ContextFlyout>
            <MenuFlyout ShouldConstrainToRootBounds="False" Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed" />
        </Grid.ContextFlyout>
        <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                  Margin="{x:Bind Tab.FaviconMargin, Mode=OneWay}"
                  Visibility="{x:Bind Tab.PlaceholderVisibility, Mode=OneWay}" />
        <Image Source="{x:Bind Tab.Favicon, Mode=OneWay}" Width="18" Height="18"
               Margin="{x:Bind Tab.FaviconMargin, Mode=OneWay}"
               Opacity="{x:Bind Tab.ContentOpacity, Mode=OneWay}" />
        <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m". Join is on the meeting card (MeetingCard.cs). -->
        <TextBlock Text="{x:Bind Tab.MeetingText, Mode=OneWay}" FontSize="10"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"
                   Foreground="{ThemeResource DriftSecondaryTextBrush}"
                   Visibility="{x:Bind Tab.MeetingTextVisibility, Mode=OneWay}" />
        <!-- While this tab has a page open in Peek, that page's icon sits on the corner. -->
        <Border Width="22" Height="22"
                Margin="0,-4,-4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                Background="{ThemeResource DriftActiveBrush}"
                Visibility="{x:Bind Tab.PeekBadgeVisibility, Mode=OneWay}">
            <Grid>
                <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                          Visibility="{x:Bind Tab.PeekPlaceholderVisibility, Mode=OneWay}" />
                <Image Source="{x:Bind Tab.PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
            </Grid>
        </Border>
        <!-- Playing sound: a speaker on the icon's top-right corner, which mutes the tab
             (MediaControls.cs). -->
        <Grid Width="18" Height="18">
            <!-- The size of the speaker on a tab row. -->
            <Border Width="22" Height="22"
                    Margin="0,-12,-14,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    CornerRadius="11"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}"
                    Visibility="{x:Bind Tab.AudioVisibility, Mode=OneWay}">
                <Button Width="20" Height="20"
                        CornerRadius="10"
                        Tag="{x:Bind Tab, Mode=OneWay}"
                        Click="TabAudio_Click"
                        Style="{StaticResource TabCloseButtonStyle}"
                        AutomationProperties.Name="{x:Bind Tab.AudioName, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Tab.AudioName, Mode=OneWay}">
                    <FontIcon Glyph="{x:Bind Tab.AudioGlyph, Mode=OneWay}" FontSize="12" />
                </Button>
            </Border>
        </Grid>
    </Grid>
</UserControl>
