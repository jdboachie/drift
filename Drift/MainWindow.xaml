<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Drift.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Drift.Models"
    xmlns:local="using:Drift"
    Title="Drift">

    <Grid x:Name="Root"
          Background="{ThemeResource DriftWindowBrush}"
          Loaded="Root_Loaded"
          KeyDown="Root_KeyDown"
          KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.Resources>
            <!-- Peek entrance: the card grows out of the link that opened it while the page behind recedes and fades.
                 The card's growth and the buttons' pop are springs (ShowPeekLayer, Spring.cs): they overshoot a touch
                 and settle, which storyboards can't do. This storyboard has the parts that should land exactly:
                 the page's shrink to whole pixels (PageShrink/PageShift, set in code) on the iOS drawer curve,
                 cubic-bezier(0.32, 0.72, 0, 1), over 300ms, and the fades, on the strong ease-out,
                 cubic-bezier(0.23, 1, 0.32, 1). The card starts small at the link and fades up over 100ms; the
                 page dims a little behind it so the card reads first; the buttons fade in as the card settles,
                 sliding out from its edge (SpringPeekIn), all three together.
                 Timings match the Peek constants in MainWindow.xaml.cs. -->
            <Storyboard x:Name="PeekEnterAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleX">
                    <SplineDoubleKeyFrame x:Name="PageShrinkX" KeyTime="0:0:0.300" Value="0.97" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleY">
                    <SplineDoubleKeyFrame x:Name="PageShrinkY" KeyTime="0:0:0.300" Value="0.97" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateX">
                    <SplineDoubleKeyFrame x:Name="PageShiftX" KeyTime="0:0:0.300" Value="0" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame x:Name="PageShiftY" KeyTime="0:0:0.300" Value="0" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekCardFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekControls" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.120" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.250" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Peek exit: quicker than the entrance, since the user has already decided. The card springs back
                 toward the link it came from (ClosePeek) while this fades it and restores the page. -->
            <Storyboard x:Name="PeekExitAnimation">
                <!-- Holds so the card is still visible as it heads back to the link and dips past it. -->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.110" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <!-- The buttons go at once, back toward the card (SpringPeekOut), not with it. -->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekControls" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleX">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateX">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.170" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.170" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- With Windows animation effects turned off: fade only, no movement. -->
            <Storyboard x:Name="PeekFadeInAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- With Windows animation effects turned off: fade only, no movement. -->
            <Storyboard x:Name="PeekFadeOutAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Command bar, opened by a click: fades in on the strong ease-out while it scales up from 0.97
                 (a spring, in CommandBar.cs). From the keyboard it just appears. -->
            <Storyboard x:Name="CommandEnterAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CommandCard" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

        </Grid.Resources>

        <!-- Keyboard shortcuts are added in code (ApplyShortcuts), from Settings. They fire while focus
             is in the app's own UI; when a page has focus, the injected script forwards the keys. -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- A private window's tint over the acrylic. -->
        <Border x:Name="PrivateTint"
                Grid.ColumnSpan="2"
                Background="{ThemeResource DriftPrivateWindowBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Page area: the active tab's page, inset from the window like a card; in split view
             (Split.cs), two cards side by side with a divider between them. -->
        <Border x:Name="PageArea"
                Grid.Column="1"
                Margin="0,8,8,8"
                SizeChanged="DragLayout_SizeChanged">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PageAreaTransform" />
            </Border.RenderTransform>
            <Grid x:Name="PageColumns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaneColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitGapColumn" Width="0" />
                    <ColumnDefinition x:Name="RightPaneColumn" Width="0" />
                </Grid.ColumnDefinitions>
            <!-- The border comes from a style so Peek can hide it with a local value and clear that
                 afterwards, getting back a brush that still follows light/dark mode. -->
            <Border x:Name="MainCard"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{ThemeResource DriftPageBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{ThemeResource DriftPageBorderBrush}" />
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Text="Press Ctrl+T to open a tab."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.6" />
                <Grid x:Name="WebHost" />
                <!-- When a page's process dies or hangs (OnProcessFailed): what happened, and a way back. -->
                <StackPanel x:Name="CrashPanel"
                            Visibility="Collapsed"
                            MaxWidth="360"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource DriftIconBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="CrashTitle" Text="This page crashed" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="CrashText" FontSize="13" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="CrashWaitButton" Content="Wait" Click="CrashWait_Click" />
                        <Button x:Name="CrashReloadButton" Content="Reload" Style="{StaticResource AccentButtonStyle}"
                                Click="CrashReload_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>
                <!-- Between the two pages: drag to share the width differently. -->
                <local:ResizeGrip x:Name="SplitDivider"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    PointerPressed="SplitDivider_PointerPressed"
                                    PointerMoved="SplitDivider_PointerMoved"
                                    PointerReleased="SplitDivider_PointerReleased"
                                    PointerCaptureLost="SplitDivider_PointerCaptureLost"
                                    PointerEntered="SplitDivider_PointerEntered"
                                    PointerExited="SplitDivider_PointerExited"
                                    DoubleTapped="SplitDivider_DoubleTapped">
                    <!-- A grip, so it reads as something to drag: brighter on hover, accent-coloured while held. -->
                    <Border x:Name="SplitGrip"
                            Width="4"
                            Height="32"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Background="{ThemeResource DriftIconBrush}"
                            Opacity="0.3">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                    </Border>
                    <Border x:Name="SplitGripAccent"
                            Width="4"
                            Height="32"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Border.OpacityTransition>
                    </Border>
                </local:ResizeGrip>
                <!-- The right-hand page of a split. Right-hand pages' views live here while they're split. -->
                <Border x:Name="SplitCard"
                        Grid.Column="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        Background="{ThemeResource DriftPageBrush}"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{ThemeResource DriftPageBorderBrush}" />
                        </Style>
                    </Border.Style>
                    <Grid x:Name="SplitHost" />
                </Border>
                <!-- The page you're on: its border a step stronger, over the card's own. -->
                <Border x:Name="LeftPageRing"
                        Grid.Column="0"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource DriftFocusedPageBorderBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
                <!-- On the left page's top edge, a little tab, on the page you're on only: click for what you can do with
                     that page; drag it to swap sides (SplitHandles.cs). Half of it is in the gap above the page, half over the page. -->
                <Button x:Name="LeftPageHandle"
                        Grid.Column="0"
                        Style="{StaticResource PageHandleStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,-9,0,0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Left page"
                        Click="PageHandle_Click">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <Grid>
                        <Border x:Name="LeftPageTab"
                                Width="40"
                                Height="14"
                                CornerRadius="7"
                                BorderThickness="1"
                                Background="{ThemeResource DriftPageBrush}"
                                BorderBrush="{ThemeResource DriftFocusedPageBorderBrush}" />
                        <StackPanel x:Name="LeftPageDots" Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource DriftIconBrush}" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource DriftIconBrush}" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource DriftIconBrush}" />
                            <StackPanel.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </StackPanel.OpacityTransition>
                        </StackPanel>
                    </Grid>
                </Button>
                <!-- The page you're on: its border a step stronger, over the card's own. -->
                <Border x:Name="RightPageRing"
                        Grid.Column="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource DriftFocusedPageBorderBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
                <!-- On the right page's top edge, a little tab, on the page you're on only: click for what you can do with
                     that page; drag it to swap sides (SplitHandles.cs). Half of it is in the gap above the page, half over the page. -->
                <Button x:Name="RightPageHandle"
                        Grid.Column="2"
                        Style="{StaticResource PageHandleStyle}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,-9,0,0"
                        Visibility="Collapsed"
                        AutomationProperties.Name="Right page"
                        Click="PageHandle_Click">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <Grid>
                        <Border x:Name="RightPageTab"
                                Width="40"
                                Height="14"
                                CornerRadius="7"
                                BorderThickness="1"
                                Background="{ThemeResource DriftPageBrush}"
                                BorderBrush="{ThemeResource DriftFocusedPageBorderBrush}" />
                        <StackPanel x:Name="RightPageDots" Orientation="Horizontal" Spacing="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource DriftIconBrush}" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource DriftIconBrush}" />
                            <Ellipse Width="4" Height="4" Fill="{ThemeResource DriftIconBrush}" />
                            <StackPanel.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.15" />
                            </StackPanel.OpacityTransition>
                        </StackPanel>
                    </Grid>
                </Button>
                <!-- While a tab is dragged over a half of the page: that half, outlined, where it'll land (Split.cs). -->
                <Border x:Name="SplitDropSlot"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Left"
                        CornerRadius="6"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource DriftDropOutlineBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
                <!-- While a tab is dragged from the sidebar: drop it on a half of the page to split. The page
                     there moves over to make room (Split.cs). -->
                <Grid x:Name="SplitDropLayer"
                      Grid.ColumnSpan="3"
                      Background="Transparent"
                      AllowDrop="True"
                      Visibility="Collapsed"
                      DragOver="SplitDrop_DragOver"
                      DragLeave="SplitDrop_DragLeave"
                      Drop="SplitDrop_Drop" />
            </Grid>
        </Border>

        <!-- While Peek is open the shrunk page fades back to 30% opacity. This frame draws that page's
             border unscaled, at the page's whole-pixel bounds (set in SnapPageShrink), because a scaled
             1px border always comes out soft. It fades with the page, and tapping it dismisses Peek. -->
        <Border x:Name="PeekPageFrame"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="Transparent"
                Opacity="0"
                Visibility="Collapsed"
                Tapped="PeekPageFrame_Tapped" />

        <!-- Peek: a floating page over the page column, with round controls beside it.
             It has no background of its own, so clicks around the card reach the muted page
             (PeekPageFrame) and dismiss Peek. It sits below the sidebar, which stays usable. -->
        <Grid x:Name="PeekLayer"
              Grid.Column="1"
              Visibility="Collapsed">
            <Grid x:Name="PeekCardFrame"
                  Margin="96,8,96,8">
                <!-- The shadow comes from this stand-in. Lifting the card itself (Translation + ThemeShadow)
                     moves its web content onto a layer that ignores the rounded clip, so the page
                     showed square corners. -->
                <Border x:Name="PeekCardShadow"
                        CornerRadius="8"
                        Background="{ThemeResource DriftPageBrush}"
                        Translation="0,0,14">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                </Border>
                <Border x:Name="PeekCard"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource DriftPageBorderBrush}"
                        Background="{ThemeResource DriftPageBrush}">
                    <Grid>
                        <!-- Opening as a tab (PromotePeekToTab): the page's background colour, filling the card as
                             it grows, and a picture of the page standing in for it, held still. -->
                        <Border x:Name="PeekCardTint" CornerRadius="7" />
                        <Grid x:Name="PeekWebHost" />
                        <!-- Over the page until it has content, then fades (RevealWhenLoaded): fading the page
                             itself stopped the whole card drawing for the length of the fade. -->
                        <Border x:Name="PeekCover"
                                CornerRadius="7"
                                Background="{ThemeResource DriftPageBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PeekStill" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush x:Name="PeekStillBrush" Stretch="Fill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
                <!-- The grabber, as on a sheet: pull the card down by it to close it (PeekGrab.cs). Out of
                     sight above the card until the pointer rests at the window's top over it; then the card
                     comes down a little and it's in the gap, clear of the window's drag edge. What it
                     answers to fills the gap and reaches a little way onto the card. -->
                <Grid x:Name="PeekGrabber"
                      Width="160"
                      Height="24"
                      Margin="0,-14,0,0"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      AutomationProperties.Name="Drag down to close"
                      PointerEntered="PeekGrabber_PointerEntered"
                      PointerExited="PeekGrabber_PointerExited"
                      PointerPressed="PeekGrabber_PointerPressed"
                      PointerMoved="PeekGrabber_PointerMoved"
                      PointerReleased="PeekGrabber_PointerReleased"
                      PointerCanceled="PeekGrabber_PointerCanceled"
                      PointerCaptureLost="PeekGrabber_PointerCanceled">
                    <Border x:Name="PeekGrabberBar"
                            Width="44"
                            Height="5"
                            Margin="0,4,0,0"
                            CornerRadius="2.5"
                            VerticalAlignment="Top"
                            Background="{ThemeResource DriftIconBrush}"
                            Opacity="0">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Border.OpacityTransition>
                    </Border>
                </Grid>
            </Grid>

            <StackPanel x:Name="PeekControls"
                        Margin="0,36,52,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Spacing="12">
                <Button x:Name="PeekCloseButton" Style="{StaticResource PeekButtonStyle}"
                        Click="PeekClose_Click"
                        AutomationProperties.Name="Close Peek" ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
                <Button x:Name="PeekToTabButton" Style="{StaticResource PeekButtonStyle}"
                        Click="PeekToTab_Click"
                        PointerEntered="PeekToTab_PointerEntered"
                        AutomationProperties.Name="Open as tab" ToolTipService.ToolTip="Open as tab">
                    <FontIcon Glyph="&#xE740;" FontSize="12" />
                </Button>
                <!-- Beside the page it came from (PromotePeekToTab). Not when that page is already in a split. -->
                <Button x:Name="PeekToSplitButton" Style="{StaticResource PeekButtonStyle}"
                        Click="PeekToSplit_Click"
                        PointerEntered="PeekToTab_PointerEntered"
                        AutomationProperties.Name="Open as split" ToolTipService.ToolTip="Open as split">
                    <FontIcon Glyph="&#xE90D;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- With the sidebar hidden, hovering the window's left edge brings it back over the page. -->
        <Border x:Name="SidebarHotZone"
                Grid.ColumnSpan="2"
                Width="8"
                HorizontalAlignment="Left"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="SidebarHotZone_PointerEntered" />

        <!-- Sidebar. Declared after the page and Peek so it stays on top: usable during Peek,
             and floating over the page when shown from the hot zone. -->
        <Grid x:Name="Sidebar"
              Padding="8,6,4,8">
            <!-- Disabled toolbar buttons (back/forward with no history) just dim their glyph,
                 without the grey plate the default button style gives them. -->
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Docked, the sidebar is see-through like the rest of the window. Floating over the page,
                 it's a card of its own: inset from the window's edges (SetSidebarHidden), rounded like the
                 Peek card, with an acrylic fill, a hairline border and a shadow. Its margin cancels the
                 sidebar's padding, so the card spans the whole sidebar. The shadow comes from Translation,
                 which is safe here: unlike the Peek card, nothing inside is web content. -->
            <Border x:Name="FloatingSidebarBackdrop"
                    Grid.RowSpan="10"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftPageBorderBrush}"
                    Background="{ThemeResource DriftFloatingSidebarBrush}"
                    Translation="0,0,32"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>

            <!-- Window row: menu and sidebar toggle on the left, navigation on the right.
                 The empty middle is where the window is dragged from. -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Menu" ToolTipService.ToolTip="Menu">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="Menu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                            <MenuFlyoutItem x:Name="NewTabMenuItem" Text="New tab" Click="NewTab_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="NewFolderMenuItem" Text="New folder" Click="NewFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="NewPullsFolderMenuItem" Text="New pull requests folder" Click="NewPullsFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ReopenMenuItem" Text="Reopen closed tab" Click="Reopen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="PrivateMenuItem" Text="New private window" Click="PrivateWindow_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED1A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="DownloadsMenuItem" Text="Downloads" Click="Downloads_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="HistoryMenuItem" Text="History" Click="History_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SidebarMenuItem" Text="Hide sidebar" Click="ToggleSidebar_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE90C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings" Click="Settings_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SidebarToggleButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                        Click="ToggleSidebar_Click"
                        AutomationProperties.Name="Toggle sidebar" ToolTipService.ToolTip="Toggle sidebar (Ctrl+S)">
                    <FontIcon Glyph="&#xE90C;" FontSize="14" />
                </Button>
                <Border x:Name="TitleDragSpacer" Grid.Column="2" Background="Transparent"
                        SizeChanged="DragLayout_SizeChanged" />
                <Button x:Name="BackButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                        Click="Back_Click" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                        Click="Forward_Click" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <!-- Reload; while the page loads, stop (ShowLoadButton). -->
                <Button x:Name="ReloadButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                        Click="Reload_Click" AutomationProperties.Name="Reload" ToolTipService.ToolTip="Reload">
                    <FontIcon x:Name="ReloadGlyph" Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Address pill: shows where the tab is. Clicking it opens the command bar on the tab's URL,
                 as Ctrl+L does; the typing happens there. -->
            <Grid Grid.Row="1" Margin="0,8,4,10">
            <Button x:Name="AddressPill"
                    Height="36"
                    Padding="10,0"
                    CornerRadius="8"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Address"
                    Click="AddressPill_Click">
                <!-- The pill and pill-hover colours from App.xaml (DriftPillBrush, DriftPillHoverBrush), repeated
                     as plain brushes per theme: aliases to those keys aren't picked up by the button's template. -->
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ButtonBackground" Color="#14000000" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1C000000" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1C000000" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ButtonBackground" Color="#1AFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <TextBlock x:Name="AddressText" FontSize="13" TextTrimming="CharacterEllipsis" />
            </Button>
            <!-- At the pill's end: the page's zoom, when it isn't 100% (ShowZoomChip), which resets it when
                 clicked; in a private window, a badge saying so, which lets clicks through to the pill; and,
                 like Arc's, copy link and site settings. -->
            <StackPanel x:Name="PillBadges"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        SizeChanged="PillBadges_SizeChanged">
                <Button x:Name="ZoomChip"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Height="26" MinHeight="0" MinWidth="0"
                        Padding="6,0"
                        Click="ZoomChip_Click">
                    <TextBlock x:Name="ZoomChipText" FontSize="12" Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                </Button>
                <Border x:Name="PrivateBadge"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Padding="8,2,8,3"
                        CornerRadius="10"
                        Background="{ThemeResource DriftPrivateBadgeBrush}">
                    <TextBlock Text="Private" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource DriftPrivateBadgeTextBrush}" />
                </Border>
                <!-- Copy link and site settings (whether it's secure, permissions, site data), Arc-style: only
                     there while the pointer is in the sidebar (ShowSiteSettingsButton); otherwise they take no room. -->
                <Button x:Name="CopyLinkButton"
                        Width="26" Height="26"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="Collapsed"
                        Opacity="0"
                        ToolTipService.ToolTip="Copy link"
                        AutomationProperties.Name="Copy link"
                        Click="CopyLink_Click">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <FontIcon x:Name="CopyLinkGlyph" Glyph="&#xE71B;" FontSize="13" />
                </Button>
                <Button x:Name="SiteInfoButton"
                        Width="26" Height="26"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="Collapsed"
                        Opacity="0"
                        ToolTipService.ToolTip="Site settings"
                        AutomationProperties.Name="Site settings"
                        GotFocus="SiteInfoButton_FocusChanged"
                        LostFocus="SiteInfoButton_FocusChanged">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                <Button.Flyout>
                    <Flyout x:Name="SiteInfoFlyout" Placement="BottomEdgeAlignedRight"
                            Opening="SiteInfo_Opening" Opened="SiteInfo_Opened" Closed="SiteInfo_Closed">
                        <StackPanel Width="300" Spacing="12">
                            <!-- The site, after a padlock (or a warning), with what that means under its name. -->
                            <Grid ColumnSpacing="8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon x:Name="SiteInfoSecureGlyph" Glyph="&#xE72E;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="SiteInfoHost" Grid.Column="1" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SiteInfoSecureText" Grid.Column="1" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                            </Grid>
                            <!-- Ad blocking for this site (SiteAdBlock.cs): some sites break with it on. Shown once
                                 the ad blocker says how the site stands; not at all without one. -->
                            <Grid x:Name="SiteAdBlockRow" Visibility="Collapsed" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ad blocking" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="SiteAdBlockSwitch" Grid.Column="1"
                                              OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Ad blocking on this site"
                                              Toggled="SiteAdBlock_Toggled" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DriftDividerBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Permissions" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel x:Name="SitePermissionList" Spacing="6" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource DriftDividerBrush}" />
                            <StackPanel Spacing="6">
                                <Button x:Name="ClearSiteDataButton" Content="Clear cookies and site data" Click="ClearSiteData_Click" />
                                <TextBlock x:Name="SiteDataText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                           Text="Signs you out of this site and clears what it has stored." />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                </Button>
            </StackPanel>
            <!-- At the pill's start, like Arc's: a padlock on secure pages, a warning on others. Its tooltip
                 says which; clicking it opens site settings. -->
            <Button x:Name="SiteSecurityButton"
                    Width="26" Height="26"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}"
                    Visibility="Collapsed"
                    Click="SiteSecurity_Click">
                <FontIcon x:Name="SiteSecurityGlyph" Glyph="&#xE72E;" FontSize="12" />
            </Button>
            </Grid>

            <!-- Essentials: favicon tiles, up to four across (LayoutEssentials). The tiles' outer edges line up
                 with the address bar's: the list reaches out by their margin on the left, and the address
                 bar stops short of the sidebar's edge on the right as they do. -->
            <GridView x:Name="EssentialList"
                      Grid.Row="2"
                      Margin="-4,-4,0,0"
                      SizeChanged="EssentialList_SizeChanged"
                      ItemsSource="{x:Bind EssentialTabs}"
                      ItemContainerStyle="{StaticResource PinnedTileStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      CanDragItems="True"
                      CanReorderItems="False"
                      AllowDrop="True"
                      DragItemsStarting="Tabs_DragItemsStarting"
                      DragItemsCompleted="Tabs_DragItemsCompleted"
                      SelectionChanged="TabList_SelectionChanged">
                <GridView.ItemContainerTransitions>
                    <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:BrowserTab">
                        <Grid Height="46" Background="Transparent"
                              AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                              PointerEntered="IntegrationAnchor_PointerEntered"
                              PointerExited="IntegrationAnchor_PointerExited">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                    <MenuFlyoutItem Text="Go to pinned page" Tag="{x:Bind}" Click="ResetPinned_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE80F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE90D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Move to pinned tabs" Tag="{x:Bind}" Click="MoveToPinned_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE718;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSubItem Text="Add to folder" Tag="{x:Bind}">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </MenuFlyoutSubItem.Icon>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="Remove from Essentials" Tag="{x:Bind}" Click="MoveToRegular_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77A;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                      Margin="{x:Bind FaviconMargin, Mode=OneWay}"
                                      Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="18" Height="18"
                                   Margin="{x:Bind FaviconMargin, Mode=OneWay}"
                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                            <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                            <TextBlock Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                       Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                            <Button Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    FontSize="10" Padding="8,0,8,1" MinHeight="0" MinWidth="0" CornerRadius="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                    Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                            <!-- While this tab has a page open in Peek, that page's icon sits on the corner. -->
                            <Border Width="22" Height="22"
                                    Margin="0,-4,-4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                                    Background="{ThemeResource DriftActiveBrush}"
                                    Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}">
                                <Grid>
                                    <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                              Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                </Grid>
                            </Border>
                            <!-- Playing sound: a speaker on the icon's top-right corner, which mutes the tab
                                 (MediaControls.cs). -->
                            <Grid Width="18" Height="18">
                                <!-- The size of the speaker on a tab row. -->
                                <Border Width="22" Height="22"
                                        Margin="0,-12,-14,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="11"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                                        Background="{ThemeResource DriftActiveBrush}"
                                        Visibility="{x:Bind AudioVisibility, Mode=OneWay}">
                                    <Button Width="20" Height="20"
                                            CornerRadius="10"
                                            Tag="{x:Bind}"
                                            Click="TabAudio_Click"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- While a tab is dragged and this group is empty: somewhere to drop it. -->
            <Grid x:Name="EssentialDropZone"
                  Grid.Row="2"
                  Height="46"
                  Margin="0,0,0,4"
                  AllowDrop="True"
                  Background="Transparent"
                  Visibility="Collapsed"
                  DragOver="Tabs_DragOver"
                  DragLeave="Tabs_DragLeave"
                  Drop="Tabs_Drop">
                <Rectangle x:Name="EssentialDropZoneOutline" RadiusX="8" RadiusY="8"
                           Stroke="{ThemeResource DriftDividerBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="4,3" />
                <TextBlock Text="Drop here to add to Essentials"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource DriftSecondaryTextBrush}" />
            </Grid>

            <!-- Folders, pinned tabs, New Tab and the tabs scroll together under the Essentials, as in Arc,
                 so a long pinned list never hides the tabs. The tab list takes whatever height is left
                 below the tabs (SidebarScroll_SizeChanged), so a tab can still be dropped there. -->
            <!-- Always scrollable (Enabled, not Auto), even with too few tabs to scroll: a touchpad swipe over
                 the sidebar reaches the library's swipe (Library.cs) only by chaining sideways out of a list
                 that scrolls. With nothing to scroll, the swipe open never reached it, and stalled. -->
            <ScrollViewer x:Name="SidebarScroll"
                          Grid.Row="3"
                          Grid.RowSpan="5"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="SidebarScroll_SizeChanged">
                <Grid x:Name="SidebarScrollContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Folders, like Arc's: between the Essentials and the pinned tabs (Folders.cs). One flat list of
                         folder headers and the tabs under them, indented a step per level. -->
                    <ListView x:Name="FolderList"
                              Grid.Row="0"
                              Margin="0,4,4,0"
                              Padding="0"
                              Visibility="Collapsed"
                              ItemsSource="{x:Bind FolderRows}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="FolderList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplateSelector>
                            <local:FolderRowTemplateSelector>
                                <local:FolderRowTemplateSelector.FolderTemplate>
                                    <DataTemplate x:DataType="models:TabFolder">
                                        <Grid ColumnSpacing="10" Background="Transparent"
                                              Tag="{x:Bind}"
                                              DoubleTapped="FolderHeader_DoubleTapped">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                                    <!-- A live folder (LiveFolders.cs): its tabs come from GitHub, not from you. -->
                                                    <MenuFlyoutItem Text="Refresh" Tag="{x:Bind}" Click="LiveFolderRefresh_Click"
                                                                    Visibility="{x:Bind local:Ui.Shown(IsLive), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE72C;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Open on GitHub" Tag="{x:Bind}" Click="LiveFolderOpenSource_Click"
                                                                    Visibility="{x:Bind local:Ui.Shown(IsLive), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8A7;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="New tab" Tag="{x:Bind}" Click="FolderNewTab_Click"
                                                                    Visibility="{x:Bind local:Ui.Hidden(IsLive), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE710;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Rename" Tag="{x:Bind}" Click="FolderRename_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8AC;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="New subfolder" Tag="{x:Bind}" Click="FolderNewSubfolder_Click"
                                                                    Visibility="{x:Bind local:Ui.Hidden(IsLive), Mode=OneWay}">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8F4;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Expand all folders" Click="FolderExpandAll_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Collapse all folders" Click="FolderCollapseAll_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70E;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Close all tabs" Tag="{x:Bind}" Click="FolderCloseAll_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE738;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copy all links" Tag="{x:Bind}" Click="FolderCopyLinks_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Delete folder…" Tag="{x:Bind}" Click="FolderDelete_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14"
                                                      Foreground="{ThemeResource DriftIconBrush}"
                                                      Visibility="{x:Bind local:Ui.Hidden(IsLive), Mode=OneWay}" />
                                            <!-- A live folder (LiveFolders.cs): still a folder, with where its tabs come from as a badge on its
                                                 corner, GitHub's mark (Octicons, MIT). The folder is drawn twice, each clipped, so its corner
                                                 under the badge is cut away: the sidebar's see-through, so nothing behind the badge could hide it. -->
                                            <Grid Width="16" Height="16" VerticalAlignment="Center"
                                                  Visibility="{x:Bind local:Ui.Shown(IsLive), Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Width="16" Height="16"
                                                          Foreground="{ThemeResource DriftIconBrush}">
                                                    <FontIcon.Clip>
                                                        <RectangleGeometry Rect="0,0,7.5,16" />
                                                    </FontIcon.Clip>
                                                </FontIcon>
                                                <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14" Width="16" Height="16"
                                                          Foreground="{ThemeResource DriftIconBrush}">
                                                    <FontIcon.Clip>
                                                        <RectangleGeometry Rect="7.5,0,8.5,7" />
                                                    </FontIcon.Clip>
                                                </FontIcon>
                                                <!-- Off the corner a little, as a badge sits. -->
                                                <Viewbox Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                    <Viewbox.RenderTransform>
                                                        <TranslateTransform X="1.5" Y="1" />
                                                    </Viewbox.RenderTransform>
                                                <Path Fill="{ThemeResource DriftIconBrush}"
                                                      Data="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" />
