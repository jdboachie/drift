<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Drift.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Drift.Models"
    xmlns:local="using:Drift"
    Title="Drift">

    <Grid x:Name="Root"
          Background="{ThemeResource DriftWindowBrush}"
          Loaded="Root_Loaded"
          KeyDown="Root_KeyDown"
          KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.Resources>
            <!-- Peek entrance, as Arc's: the card springs up from about a quarter of its size at the press
                 (SpringPeekIn, Spring.cs), its buttons attached to it, and shows within two frames. Behind
                 it the page comes in 8px a side, to whole pixels (PageShrink/PageShift, set in SnapPageShrink),
                 and fades back to 42%, both on the strong ease-out, cubic-bezier(0.23, 1, 0.32, 1), over 150ms.
                 Timings match the Peek constants in MainWindow.xaml.cs. -->
            <Storyboard x:Name="PeekEnterAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleX">
                    <SplineDoubleKeyFrame x:Name="PageShrinkX" KeyTime="0:0:0.150" Value="0.98" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleY">
                    <SplineDoubleKeyFrame x:Name="PageShrinkY" KeyTime="0:0:0.150" Value="0.98" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateX">
                    <SplineDoubleKeyFrame x:Name="PageShiftX" KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame x:Name="PageShiftY" KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekCardFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.033" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.42" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.42" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Peek exit: quicker than the entrance, since the user has already decided. The card springs back
                 into the link it came from (SpringPeekOut) while this fades it and restores the page. -->
            <Storyboard x:Name="PeekExitAnimation">
                <!-- Holds so the card is still visible as it heads back to the link, all but a speck when it fades. -->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.150" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.250" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <!-- The buttons go at once: on the card, they'd be squeezed into the link with it. -->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekControls" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleX">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateX">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.170" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.170" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- With Windows animation effects turned off: fade only, no movement. -->
            <Storyboard x:Name="PeekFadeInAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.42" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.42" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- With Windows animation effects turned off: fade only, no movement. -->
            <Storyboard x:Name="PeekFadeOutAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- A tab's row (Controls/TabRowView.xaml): pinned (PinnedList), regular (TabList) and in folders (FolderList). -->
            <DataTemplate x:Key="TabRowTemplate" x:DataType="models:BrowserTab">
                <local:TabRowView Tab="{x:Bind}" />
            </DataTemplate>

        </Grid.Resources>

        <!-- Keyboard shortcuts are added in code (ApplyShortcuts), from Settings. They fire while focus
             is in the app's own UI; when a page has focus, the injected script forwards the keys. -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- A private window's tint over the acrylic. -->
        <Border x:Name="PrivateTint"
                Grid.ColumnSpan="2"
                Background="{ThemeResource DriftPrivateWindowBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Page area: the active tab's page, inset from the window like a card; in split view
             (Split.cs), two to four cards side by side with a divider between each two. -->
        <Border x:Name="PageArea"
                Grid.Column="1"
                Margin="0,8,8,8"
                SizeChanged="DragLayout_SizeChanged">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PageAreaTransform" />
            </Border.RenderTransform>
            <Grid x:Name="PageColumns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaneColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitGapColumn" Width="0" />
                    <ColumnDefinition x:Name="RightPaneColumn" Width="0" />
                    <ColumnDefinition x:Name="Gap3Column" Width="0" />
                    <ColumnDefinition x:Name="Pane3Column" Width="0" />
                    <ColumnDefinition x:Name="Gap4Column" Width="0" />
                    <ColumnDefinition x:Name="Pane4Column" Width="0" />
                </Grid.ColumnDefinitions>
                <!-- The page's card (PageCardView), and in it the page's view, or what shows when there's none. -->
                <local:PageCardView x:Name="MainCard">
                    <Grid>
                        <TextBlock x:Name="EmptyText"
                                   Text="Press Ctrl+T to open a tab"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Opacity="0.6" />
                        <Grid x:Name="WebHost" />
                        <!-- A page whose process died or hung (Views/CrashCardView.xaml). -->
                        <local:CrashCardView x:Name="CrashPanel"
                                             Visibility="Collapsed" />
                    </Grid>
                
                </local:PageCardView>
                <!-- Between pages 1 and 2: drag to share the width differently. -->
                <local:SplitDividerView x:Name="SplitDivider"
                                        Grid.Column="1"
                                        Visibility="Collapsed"
                                        PointerPressed="SplitDivider_PointerPressed"
                                        PointerMoved="SplitDivider_PointerMoved"
                                        PointerReleased="SplitDivider_PointerReleased"
                                        PointerCaptureLost="SplitDivider_PointerCaptureLost"
                                        PointerEntered="SplitDivider_PointerEntered"
                                        PointerExited="SplitDivider_PointerExited"
                                        DoubleTapped="SplitDivider_DoubleTapped" />
                <!-- The right-hand page of a split. Right-hand pages' views live here while they're split. -->
                <local:PageCardView x:Name="SplitCard" Grid.Column="2" Visibility="Collapsed">
                    <Grid x:Name="SplitHost" />
                </local:PageCardView>
                <!-- Between pages 2 and 3. -->
                <local:SplitDividerView x:Name="SplitDivider2"
                                        Grid.Column="3"
                                        Visibility="Collapsed"
                                        PointerPressed="SplitDivider_PointerPressed"
                                        PointerMoved="SplitDivider_PointerMoved"
                                        PointerReleased="SplitDivider_PointerReleased"
                                        PointerCaptureLost="SplitDivider_PointerCaptureLost"
                                        PointerEntered="SplitDivider_PointerEntered"
                                        PointerExited="SplitDivider_PointerExited"
                                        DoubleTapped="SplitDivider_DoubleTapped" />
                <!-- A split's page 3: its view lives here while it's split. -->
                <local:PageCardView x:Name="SplitCard3" Grid.Column="4" Visibility="Collapsed">
                    <Grid x:Name="SplitHost3" />
                </local:PageCardView>
                <!-- Between pages 3 and 4. -->
                <local:SplitDividerView x:Name="SplitDivider3"
                                        Grid.Column="5"
                                        Visibility="Collapsed"
                                        PointerPressed="SplitDivider_PointerPressed"
                                        PointerMoved="SplitDivider_PointerMoved"
                                        PointerReleased="SplitDivider_PointerReleased"
                                        PointerCaptureLost="SplitDivider_PointerCaptureLost"
                                        PointerEntered="SplitDivider_PointerEntered"
                                        PointerExited="SplitDivider_PointerExited"
                                        DoubleTapped="SplitDivider_DoubleTapped" />
                <!-- A split's page 4: its view lives here while it's split. -->
                <local:PageCardView x:Name="SplitCard4" Grid.Column="6" Visibility="Collapsed">
                    <Grid x:Name="SplitHost4" />
                </local:PageCardView>
                <!-- Each page's marker (PageMarkerView): on the page you're on, a stronger border and its handle. -->
                <local:PageMarkerView x:Name="LeftPageMarker" Grid.Column="0" Label="Left page" Click="PageHandle_Click" />
                <local:PageMarkerView x:Name="RightPageMarker" Grid.Column="2" Label="Right page" Click="PageHandle_Click" />
                <local:PageMarkerView x:Name="Page3Marker" Grid.Column="4" Label="Third page" Click="PageHandle_Click" />
                <local:PageMarkerView x:Name="Page4Marker" Grid.Column="6" Label="Fourth page" Click="PageHandle_Click" />
                <!-- While a tab is dragged over a half of the page: that half, outlined, where it'll land (Split.cs). -->
                <Border x:Name="SplitDropSlot"
                        Grid.ColumnSpan="7"
                        HorizontalAlignment="Left"
                        CornerRadius="6"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
                <!-- While a tab is dragged from the sidebar: drop it on a half of the page to split. The page
                     there moves over to make room (Split.cs). -->
                <Grid x:Name="SplitDropLayer"
                      Grid.ColumnSpan="7"
                      Background="Transparent"
                      AllowDrop="True"
                      Visibility="Collapsed"
                      DragOver="SplitDrop_DragOver"
                      DragLeave="SplitDrop_DragLeave"
                      Drop="SplitDrop_Drop" />
            </Grid>
        </Border>

        <!-- While Peek is open the shrunk page fades back to 42% opacity. This frame draws that page's
             border unscaled, at the page's whole-pixel bounds (set in SnapPageShrink), because a scaled
             1px border always comes out soft. It fades with the page, and tapping it dismisses Peek. -->
        <Border x:Name="PeekPageFrame"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="Transparent"
                Opacity="0"
                Visibility="Collapsed"
                Tapped="PeekPageFrame_Tapped" />

        <!-- Peek: a floating page over the page column, with round controls beside it.
             It has no background of its own, so clicks around the card reach the muted page
             (PeekPageFrame) and dismiss Peek. It sits below the sidebar, which stays usable. -->
        <Grid x:Name="PeekLayer"
              Grid.Column="1"
              Visibility="Collapsed">
            <!-- Its margin is set in code (PlacePeekCard): about three quarters of the page's width, centred. -->
            <Grid x:Name="PeekCardFrame"
                  Margin="96,11,104,12">
                <!-- A page's card, as the panes' are, lifted higher: it floats over the page. -->
                <local:PageCardView x:Name="PeekCard" Lift="14">
                    <Grid>
                        <!-- Opening as a tab (PromotePeekToTab): the page's background colour, filling the card as
                             it grows, and a picture of the page standing in for it, held still. -->
                        <Border x:Name="PeekCardTint" CornerRadius="5" />
                        <Grid x:Name="PeekWebHost" />
                        <!-- Over the page until it has content, then fades (RevealWhenLoaded): fading the page
                             itself stopped the whole card drawing for the length of the fade. -->
                        <Border x:Name="PeekCover"
                                CornerRadius="5"
                                Background="{ThemeResource DriftPageBrush}"
                                Opacity="0"
                                IsHitTestVisible="False" />
                        <Border x:Name="PeekStill" CornerRadius="5" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush x:Name="PeekStillBrush" Stretch="Fill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </local:PageCardView>
                <!-- The grabber, as on a sheet: pull the card down by it to close it (PeekGrab.cs). Out of
                     sight above the card until the pointer rests at the window's top over it; then the card
                     comes down a little and it's in the gap, clear of the window's drag edge. What it
                     answers to fills the gap and reaches a little way onto the card. -->
                <Grid x:Name="PeekGrabber"
                      Width="160"
                      Height="24"
                      Margin="0,-14,0,0"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Top"
                      Background="Transparent"
                      AutomationProperties.Name="Drag down to close"
                      PointerEntered="PeekGrabber_PointerEntered"
                      PointerExited="PeekGrabber_PointerExited"
                      PointerPressed="PeekGrabber_PointerPressed"
                      PointerMoved="PeekGrabber_PointerMoved"
                      PointerReleased="PeekGrabber_PointerReleased"
                      PointerCanceled="PeekGrabber_PointerCanceled"
                      PointerCaptureLost="PeekGrabber_PointerCanceled">
                    <Border x:Name="PeekGrabberBar"
                            Width="44"
                            Height="5"
                            Margin="0,4,0,0"
                            CornerRadius="2.5"
                            VerticalAlignment="Top"
                            Background="{ThemeResource DriftIconBrush}"
                            Opacity="0">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Border.OpacityTransition>
                    </Border>
                </Grid>
                <!-- On the card, just off its right edge, as Arc's are: they grow, shrink and move with it. -->
                <StackPanel x:Name="PeekControls"
                            Margin="0,7,-41,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Spacing="8">
                    <Button x:Name="PeekCloseButton" Style="{StaticResource PeekButtonStyle}"
                            Click="PeekClose_Click"
                            AutomationProperties.Name="Close Peek" ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                    <Button x:Name="PeekToTabButton" Style="{StaticResource PeekButtonStyle}"
                            Click="PeekToTab_Click"
                            PointerEntered="PeekToTab_PointerEntered"
                            AutomationProperties.Name="Open as tab" ToolTipService.ToolTip="Open as tab">
                        <FontIcon Glyph="&#xE740;" FontSize="12" />
                    </Button>
                    <!-- Beside the page it came from (PromotePeekToTab). Not when that page is already in a split. -->
                    <Button x:Name="PeekToSplitButton" Style="{StaticResource PeekButtonStyle}"
                            Click="PeekToSplit_Click"
                            PointerEntered="PeekToTab_PointerEntered"
                            AutomationProperties.Name="Open as split" ToolTipService.ToolTip="Open as split">
                        <FontIcon Glyph="&#xE90D;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- With the sidebar hidden, hovering the window's left edge brings it back over the page. -->
        <Border x:Name="SidebarHotZone"
                Grid.ColumnSpan="2"
                Width="8"
                HorizontalAlignment="Left"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="SidebarHotZone_PointerEntered" />

        <!-- Sidebar. Declared after the page and Peek so it stays on top: usable during Peek,
             and floating over the page when shown from the hot zone. -->
        <Grid x:Name="Sidebar"
              Padding="8,6,4,8">
            <!-- Disabled toolbar buttons (back/forward with no history) just dim their glyph,
                 without the grey plate the default button style gives them. -->
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Docked, the sidebar is see-through like the rest of the window. Floating over the page,
                 it's a card of its own: inset from the window's edges (SetSidebarHidden), rounded like the
                 Peek card, with an acrylic fill, a hairline border and a shadow. Its margin cancels the
                 sidebar's padding, so the card spans the whole sidebar. The shadow comes from Translation,
                 which is safe here: unlike the Peek card, nothing inside is web content. -->
            <Border x:Name="FloatingSidebarBackdrop"
                    Grid.RowSpan="10"
                    CornerRadius="10"
                    Style="{StaticResource FloatingPanelStyle}"
                    Background="{ThemeResource DriftFloatingSidebarBrush}"
                    Translation="0,0,32"
                    Visibility="Collapsed" />

            <!-- Window row: menu and sidebar toggle on the left, navigation on the right.
                 The empty middle is where the window is dragged from. -->
            <local:ToolbarView x:Name="Toolbar" />

            <!-- Address pill: shows where the tab is. Clicking it opens the command bar on the tab's URL,
                 as Ctrl+L does; the typing happens there. -->
            <local:AddressBarView x:Name="AddressBar"
                                  Grid.Row="1"
                                  Margin="0,8,4,10" />

            <!-- Essentials: favicon tiles, up to four across (LayoutEssentials). The tiles' outer edges line up
                 with the address bar's: the list reaches out by their margin on the left, and the address
                 bar stops short of the sidebar's edge on the right as they do. Below, the first row's
                 highlight sits 10 under the tiles, as far as a row of tiles from the next: their margin (5),
                 less 2 here, and the list's 4 and the row's 3 there. -->
            <GridView x:Name="EssentialList"
                      Grid.Row="2"
                      Margin="-5,-5,0,-2"
                      Padding="0"
                      SizeChanged="EssentialList_SizeChanged"
                      ItemsSource="{x:Bind EssentialTabs}"
                      ItemContainerStyle="{StaticResource PinnedTileStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      CanDragItems="True"
                      CanReorderItems="False"
                      AllowDrop="True"
                      DragItemsStarting="Tabs_DragItemsStarting"
                      DragItemsCompleted="Tabs_DragItemsCompleted"
                      SelectionChanged="TabList_SelectionChanged">
                <GridView.ItemContainerTransitions>
                    <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:BrowserTab">
                        <local:EssentialTileView Tab="{x:Bind}" />
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- While a tab is dragged and this group is empty: somewhere to drop it. -->
            <Grid x:Name="EssentialDropZone"
                  Grid.Row="2"
                  Height="43"
                  Margin="0,0,0,4"
                  AllowDrop="True"
                  Background="Transparent"
                  Visibility="Collapsed"
                  DragOver="Tabs_DragOver"
                  DragLeave="Tabs_DragLeave"
                  Drop="Tabs_Drop">
                <Rectangle x:Name="EssentialDropZoneOutline" RadiusX="8" RadiusY="8"
                           Stroke="{ThemeResource DriftDividerBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="4,3" />
                <TextBlock Text="Drop here to add to Essentials"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource DriftSecondaryTextBrush}" />
            </Grid>

            <!-- Folders, pinned tabs, New Tab and the tabs scroll together under the Essentials, as in Arc,
                 so a long pinned list never hides the tabs. The tab list takes whatever height is left
                 below the tabs (SidebarScroll_SizeChanged), so a tab can still be dropped there. -->
            <!-- Always scrollable (Enabled, not Auto), even with too few tabs to scroll: a touchpad swipe over
                 the sidebar reaches the library's swipe (Library.cs) only by chaining sideways out of a list
                 that scrolls. With nothing to scroll, the swipe open never reached it, and stalled. -->
            <ScrollViewer x:Name="SidebarScroll"
                          Grid.Row="3"
                          Grid.RowSpan="5"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollMode="Enabled"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="SidebarScroll_SizeChanged">
                <!-- Right-click below the tabs: what the + button offers (ToolbarMenus.cs). Rows have menus of their own. -->
                <ScrollViewer.ContextFlyout>
                    <MenuFlyout Opening="SidebarSpaceMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarSpaceMenu_Closed">
                        <MenuFlyoutItem x:Name="SpaceNewTabItem" Text="New tab" Click="NewTab_Click" />
                        <MenuFlyoutItem x:Name="SpaceNewFolderItem" Text="New folder" Click="NewFolder_Click" />
                        <MenuFlyoutSubItem x:Name="SpaceLiveFolderItem" Text="New live folder">
                            <MenuFlyoutItem x:Name="SpaceGitHubItem" Text="GitHub pull requests" Click="NewPullsFolder_Click" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </ScrollViewer.ContextFlyout>
                <Grid x:Name="SidebarScrollContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Folders, like Arc's: between the Essentials and the pinned tabs (Folders.cs). One flat list of
                         folder headers and the tabs under them, indented a step per level. -->
                    <ListView x:Name="FolderList"
                              Grid.Row="0"
                              Margin="0,4,4,0"
                              Padding="0"
                              Visibility="Collapsed"
                              ItemsSource="{x:Bind FolderRows}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="FolderList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemContainerStyleSelector>
                            <local:FolderRowStyleSelector FolderStyle="{StaticResource FolderHeaderRowStyle}" RowStyle="{StaticResource TabRowStyle}" />
                        </ListView.ItemContainerStyleSelector>
                        <ListView.ItemTemplateSelector>
                            <local:FolderRowTemplateSelector TabTemplate="{StaticResource TabRowTemplate}">
                                <local:FolderRowTemplateSelector.FolderTemplate>
                                    <DataTemplate x:DataType="models:TabFolder">
                                        <local:FolderHeaderView Folder="{x:Bind}" />
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.FolderTemplate>
                                <!-- A live folder's note (LiveFolders.cs): signed out, or nothing in it. In line with the tabs' titles. -->
                                <local:FolderRowTemplateSelector.NoteTemplate>
                                    <DataTemplate x:DataType="models:LiveNote">
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                   Margin="26,0,0,0"
                                                   FontSize="14"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.NoteTemplate>
                            </local:FolderRowTemplateSelector>
                        </ListView.ItemTemplateSelector>
                    </ListView>

                    <!-- Pinned tabs: rows under the folders, with their titles (like Zen's). -->
                    <ListView x:Name="PinnedList"
                              Grid.Row="1"
                              Margin="0,4,4,0"
                              Padding="0"
                              ItemsSource="{x:Bind PinnedTabs}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              ItemTemplate="{StaticResource TabRowTemplate}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="TabList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                    </ListView>



                    <!-- While a tab is dragged and this group is empty: somewhere to drop it. -->
                    <Grid x:Name="PinnedDropZone"
                          Grid.Row="1"
                          Height="36"
                          Margin="0,4,4,0"
                          AllowDrop="True"
                          Background="Transparent"
                          Visibility="Collapsed"
                          DragOver="Tabs_DragOver"
                          DragLeave="Tabs_DragLeave"
                          Drop="Tabs_Drop">
                        <Rectangle x:Name="PinnedDropZoneOutline" RadiusX="8" RadiusY="8"
                                   Stroke="{ThemeResource DriftDividerBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="4,3" />
                        <TextBlock Text="Drop here to pin"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    </Grid>

                    <!-- Arc's: 15 under the last pinned tab's card, 13 above New Tab's, as wide as they are. -->
                    <Border Grid.Row="2" Height="1" Margin="0,12,4,13"
                            Background="{ThemeResource DriftDividerBrush}" />

                    <Button x:Name="NewTabButton"
                            Grid.Row="3"
                            Margin="0,0,4,3"
                            Height="38"
                            Style="{StaticResource SubtleButtonStyle}"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="11,0"
                            Foreground="{ThemeResource DriftSecondaryTextBrush}"
                            AutomationProperties.Name="New Tab"
                            PointerEntered="NewTabButton_PointerEntered"
                            PointerExited="NewTabButton_PointerExited"
                            Click="NewTab_Click">
                        <!-- Hovered or pressed, the tabs' own hover fill (DriftHoverBrush), not the button's white,
                             and its words stay grey, as a tab's do. -->
                        <Button.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Light">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14000000" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#888888" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#888888" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Dark">
                                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1AFFFFFF" />
                                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#969696" />
                                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#969696" />
                                    </ResourceDictionary>
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </Button.Resources>
                        <!-- Its shortcut shows at the end while hovered, like Arc's (ShowNewTabHint). -->
                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="New Tab" FontSize="14" />
                            </StackPanel>
                            <TextBlock x:Name="NewTabHint" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Opacity="0">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- Regular tabs -->
                    <ListView x:Name="TabList"
                              Grid.Row="4"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Margin="0,0,4,0"
                              Padding="0"
                              ItemsSource="{x:Bind Tabs}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              ItemTemplate="{StaticResource TabRowTemplate}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="TabList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                    </ListView>
                </Grid>
            </ScrollViewer>

            <!-- The mini player, like Arc's (MediaControls.cs): while a tab plays sound, and a while after
                 it's paused, its icon (go to it), back, play/pause, forward and mute. Hovered, it grows
                 upward over the tab list into a card with the title (scrolling by if it's long), the
                 artist or site, picture-in-picture and close, and a bar to seek with. MediaBarRow keeps
                 the compact bar's room in the sidebar; MediaCard is what shows, over it. -->
            <Border x:Name="MediaBarRow"
                    Grid.Row="8"
                    Margin="0,4,4,0"
                    Height="40"
                    Visibility="Collapsed" />
            <local:MediaCardView x:Name="MediaCard"
                                 Grid.Row="7"
                                 Grid.RowSpan="2"
                                 Margin="0,4,4,0"
                                 Height="40"
                                 VerticalAlignment="Bottom"
                                 Visibility="Collapsed"
                                 PointerEntered="MediaCard_PointerEntered"
                                 PointerExited="MediaCard_PointerExited" />

            <!-- The library (bookmarks, downloads and history), like Zen's button in the same place. -->
            <Button x:Name="LibraryButton"
                    Grid.Row="9"
                    Margin="0,4,0,0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource IconButtonStyle}"
                    Click="LibraryButton_Click"
                    PointerEntered="DownloadPeekAnchor_PointerEntered"
                    PointerExited="DownloadPeek_PointerExited"
                    ContextRequested="LibraryButton_ContextRequested"
                    AutomationProperties.Name="Library"
                    ToolTipService.ToolTip="Library">
                <!-- As in Zen (DownloadsPeek.cs): the newest download's file sits on a badge at the top right,
                     ringed with progress while files download, till you've hovered the button or opened the library. -->
                <Grid Width="32" Height="32">
                    <FontIcon x:Name="LibraryGlyph" Glyph="&#xE8F1;" FontSize="14" />
                    <Grid x:Name="LibraryBadge"
                          Width="22" Height="22"
                          Margin="0,-2,-4,0"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          IsHitTestVisible="False"
                          Visibility="Collapsed">
                        <Ellipse Fill="{ThemeResource DriftPeekBadgeBrush}" Stroke="{ThemeResource DriftPeekBadgeBorderBrush}" StrokeThickness="1" />
                        <Border Width="15" Height="15" CornerRadius="3">
                            <Grid>
                                <FontIcon Glyph="&#xE8A5;" FontSize="13" Foreground="{ThemeResource DriftIconBrush}" />
                                <Image x:Name="LibraryBadgeImage" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <ProgressRing x:Name="DownloadsRing"
                                      Width="22" Height="22"
                                      Minimum="0" Maximum="1"
                                      IsActive="False"
                                      Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Button>

            <!-- New things for the sidebar, across from the Library button. -->
            <Button x:Name="PlusButton"
                    Grid.Row="9"
                    Margin="0,4,0,0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource IconButtonStyle}"
                    AutomationProperties.Name="New"
                    ToolTipService.ToolTip="New">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
                <Button.Flyout>
                    <MenuFlyout Placement="TopEdgeAlignedRight" Opening="PlusMenu_Opening" Opened="SidebarMenu_Opened" Closed="PlusMenu_Closed">
                        <MenuFlyoutItem x:Name="PlusNewTabItem" Text="New tab" Click="NewTab_Click" />
                        <MenuFlyoutItem x:Name="PlusNewFolderItem" Text="New folder" Click="NewFolder_Click" />
                        <!-- A live folder keeps itself filled from somewhere (LiveFolders.cs). -->
                        <MenuFlyoutSubItem x:Name="PlusLiveFolderItem" Text="New live folder">
                            <MenuFlyoutItem x:Name="PlusGitHubItem" Text="GitHub pull requests" Click="NewPullsFolder_Click" />
                        </MenuFlyoutSubItem>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Hover the Library button and your newest downloads rise above it, as in
                 Arc: click one to open it, or drag it onto a page, Explorer or another app (DownloadPeek.cs). -->
            <local:DownloadPeekView x:Name="DownloadPeekCard"
                                    Grid.RowSpan="9"
                                    Margin="0,0,4,4"
                                    VerticalAlignment="Bottom" />

            <!-- Where a dragged tab will land, like Zen's: a line with a ring between rows, in the accent
                 colour (ShowDropIndicator). Essentials show it by moving aside instead (PreviewEssentials);
                 a tab arriving from another group shows as a faded tile in the gap. -->
            <Canvas x:Name="DropIndicatorLayer" Grid.RowSpan="10" IsHitTestVisible="False">
                <Grid x:Name="DropLine" Height="8" Visibility="Collapsed">
                    <Rectangle Height="2" Margin="7,0,0,0" RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" StrokeThickness="2"
                             Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <!-- A folder a drag will drop into (its header, outlined). -->
                <Border x:Name="FolderDropHighlight" CornerRadius="8" BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <Border x:Name="EssentialPlaceholder" Height="43" CornerRadius="8" Opacity="0.5"
                        Background="{ThemeResource DriftTileBrush}" Visibility="Collapsed">
                    <Grid>
                        <FontIcon x:Name="EssentialPlaceholderGlyph" Glyph="&#xE774;" FontSize="16" Opacity="0.6"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="EssentialPlaceholderIcon" Width="18" Height="18" />
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- The sidebar's edge, in the gap between the sidebar and the page: drag it to resize the sidebar,
             past its narrowest to hide it; double-click it for the default width (SidebarResizing.cs).
             The same grip as split view's divider, but only on hover or while held. Placed in code
             (PlaceResizeHandle): it follows the width, and goes while the library's in the sidebar's place. -->
        <local:ResizeGrip x:Name="SidebarResizeHandle"
                          Grid.ColumnSpan="2"
                          Width="10"
                          Margin="199,8,0,8"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          AutomationProperties.Name="Resize sidebar"
                          PointerEntered="ResizeHandle_PointerEntered"
                          PointerExited="ResizeHandle_PointerExited"
                          PointerPressed="ResizeHandle_PointerPressed"
                          PointerMoved="ResizeHandle_PointerMoved"
                          PointerReleased="ResizeHandle_PointerReleased"
                          PointerCanceled="ResizeHandle_PointerCanceled"
                          PointerCaptureLost="ResizeHandle_PointerCanceled"
                          DoubleTapped="ResizeHandle_DoubleTapped">
            <Border x:Name="SidebarGrip"
                    Width="4"
                    Height="32"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Background="{ThemeResource DriftIconBrush}"
                    Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Border.OpacityTransition>
            </Border>
            <Border x:Name="SidebarGripAccent"
                    Width="4"
                    Height="32"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.12" />
                </Border.OpacityTransition>
            </Border>
        </local:ResizeGrip>

        <!-- The library, as Zen has it: downloads and history in the sidebar's place, twice its width.
             It's always its full width, moved left by however much narrower the sidebar is, so as the
             sidebar widens (a swipe, or the library button) it slides in from the left attached to the
             page's edge. (Not right-aligned in the column: wider than its column, it would be clipped.)
             See Library.cs. -->
        <local:LibraryView x:Name="Library"
                           Grid.ColumnSpan="2"
                           HorizontalAlignment="Left" />

        <!-- A tab drag's ghosts, off-screen until photographed (Views/DragGhostsView.xaml). -->
        <local:DragGhostsView x:Name="GhostStage"
                              Grid.ColumnSpan="2"
                              IsHitTestVisible="False" />

        <!-- The window buttons, as in Zen: out of sight until the pointer rests at the top of the page area,
             then down from the top-right corner where Windows keeps them (CaptionBar.cs). -->
        <local:CaptionBarView x:Name="CaptionBar"
                              Grid.ColumnSpan="2"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top" />

        <!-- Command bar, like Arc's: Ctrl+T (new tab), Ctrl+L or the address pill (this tab's URL).
             A card centred over the whole window, above the page as it is: a search field, then
             suggestions (open tabs, history, searches). The layer around it catches clicks, which
             close it. It opens instantly from the keyboard and with a short scale-and-fade from a click
             (CommandBar.cs). -->
        <local:CommandBarView x:Name="CommandLayer"
                              Grid.ColumnSpan="2" />

        <!-- Hovering a pinned Google Calendar: today's meetings (GoogleCalendar.cs), beside the tab. -->
        <local:HoverCard x:Name="CalendarCard" Grid.ColumnSpan="2" Width="288"
                         ActionName="New event" ActionClick="CalendarNew_Click"
                         PointerEntered="HoverCard_PointerEntered" PointerExited="HoverCard_PointerExited">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="CalendarAllDay" Margin="10,8,10,0" Spacing="4" />
                <Grid Grid.Row="1" Height="300" Margin="0,8,0,0">
                    <ScrollViewer x:Name="CalendarScroll" VerticalScrollBarVisibility="Hidden">
                        <Canvas x:Name="CalendarTimeline" />
                    </ScrollViewer>
                    <local:CardMessage x:Name="CalendarMessage" Margin="24,0" ActionClick="CalendarAction_Click" />
                </Grid>
            </Grid>
        </local:HoverCard>

        <!-- Hovering a pinned Gmail or Outlook mail: your unread emails (Gmail.cs), beside the tab. -->
        <local:HoverCard x:Name="MailCard" Grid.ColumnSpan="2" Width="260"
                         ActionName="Compose" ActionClick="MailCompose_Click"
                         PointerEntered="HoverCard_PointerEntered" PointerExited="HoverCard_PointerExited">
            <Grid MinHeight="120">
                <ScrollViewer x:Name="MailScroll" MaxHeight="340" VerticalScrollBarVisibility="Hidden">
                    <StackPanel x:Name="MailList" Padding="6,6,6,6" Spacing="2" />
                </ScrollViewer>
                <local:CardMessage x:Name="MailMessage" Margin="24,12" ActionClick="MailAction_Click" />
            </Grid>
        </local:HoverCard>

        <!-- A minute before a meeting: what it is, and Join (GoogleCalendar.cs). -->
        <local:MeetingNoticeView x:Name="MeetingNotice"
                                 Grid.Column="1"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,16,24,0" />

        <!-- Ctrl+D: says the page is bookmarked, at the foot of the page, with Edit (Bookmarks.cs). -->
        <local:Toast x:Name="BookmarkToast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,8,28" />

        <!-- Ctrl+Shift+C: says the link was copied, at the foot of the page, for a moment. -->
        <local:Toast x:Name="CopiedToast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,8,28" />

        <!-- After a first press of the window's close button, or Alt+F4: a second closes (Confirm.cs). -->
        <local:Toast x:Name="CloseAgainHint" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,40,8,0"
                     FromAbove="True" />

        <!-- After a bookmark's deleted or the tab list's cleared: Undo, for a moment; and notices, with a choice or two
             (Confirm.cs). -->
        <local:Toast x:Name="UndoToast" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,8,28" />

        <!-- Ctrl+Tab's switcher, as in Arc (TabSwitcher.cs): your tabs, most recently used first, over the
             middle of the window while Ctrl is held. -->
        <local:SwitcherView x:Name="SwitcherLayer"
                            Grid.ColumnSpan="2" />
    </Grid>
</Window>
