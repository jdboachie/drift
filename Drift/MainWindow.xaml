<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Drift.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Drift.Models"
    xmlns:local="using:Drift"
    Title="Drift">

    <Grid x:Name="Root"
          Background="{ThemeResource DriftWindowBrush}"
          Loaded="Root_Loaded"
          KeyDown="Root_KeyDown"
          KeyboardAcceleratorPlacementMode="Hidden">

        <Grid.Resources>
            <!-- Peek entrance: the card grows out of the link that opened it while the page behind recedes and fades.
                 The card's growth and the buttons' pop are springs (ShowPeekLayer, Spring.cs): they overshoot a touch
                 and settle, which storyboards can't do. This storyboard has the parts that should land exactly:
                 the page's shrink to whole pixels (PageShrink/PageShift, set in code) on the iOS drawer curve,
                 cubic-bezier(0.32, 0.72, 0, 1), over 300ms, and the fades, on the strong ease-out,
                 cubic-bezier(0.23, 1, 0.32, 1). The card starts small at the link and fades up over 100ms; the
                 page dims a little behind it so the card reads first; the buttons fade in as the card settles.
                 Timings match the Peek constants in MainWindow.xaml.cs. -->
            <Storyboard x:Name="PeekEnterAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleX">
                    <SplineDoubleKeyFrame x:Name="PageShrinkX" KeyTime="0:0:0.300" Value="0.97" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleY">
                    <SplineDoubleKeyFrame x:Name="PageShrinkY" KeyTime="0:0:0.300" Value="0.97" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateX">
                    <SplineDoubleKeyFrame x:Name="PageShiftX" KeyTime="0:0:0.300" Value="0" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame x:Name="PageShiftY" KeyTime="0:0:0.300" Value="0" KeySpline="0.32,0.72 0,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekCardFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.100" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekControls" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.120" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.250" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.200" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Peek exit: quicker than the entrance, since the user has already decided. The card springs back
                 toward the link it came from (ClosePeek) while this fades it and restores the page. -->
            <Storyboard x:Name="PeekExitAnimation">
                <!-- Holds so the card is still visible as it heads back to the link and dips past it. -->
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0:0:0.110" Value="1" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.240" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleX">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="ScaleY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateX">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageAreaTransform" Storyboard.TargetProperty="TranslateY">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.210" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.170" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.170" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- With Windows animation effects turned off: fade only, no movement. -->
            <Storyboard x:Name="PeekFadeInAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0.3" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- With Windows animation effects turned off: fade only, no movement. -->
            <Storyboard x:Name="PeekFadeOutAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekLayer" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PageArea" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PeekPageFrame" Storyboard.TargetProperty="Opacity">
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="0" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

            <!-- Command bar, opened by a click: fades in on the strong ease-out while it scales up from 0.97
                 (a spring, in CommandBar.cs). From the keyboard it just appears. -->
            <Storyboard x:Name="CommandEnterAnimation">
                <DoubleAnimationUsingKeyFrames Storyboard.TargetName="CommandCard" Storyboard.TargetProperty="Opacity">
                    <DiscreteDoubleKeyFrame KeyTime="0" Value="0" />
                    <SplineDoubleKeyFrame KeyTime="0:0:0.150" Value="1" KeySpline="0.23,1 0.32,1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>

        </Grid.Resources>

        <!-- Keyboard shortcuts are added in code (ApplyShortcuts), from Settings. They fire while focus
             is in the app's own UI; when a page has focus, the injected script forwards the keys. -->

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="208" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- A private window's tint over the acrylic. -->
        <Border x:Name="PrivateTint"
                Grid.ColumnSpan="2"
                Background="{ThemeResource DriftPrivateWindowBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed" />

        <!-- Page area: the active tab's page, inset from the window like a card; in split view
             (Split.cs), two cards side by side with a divider between them. -->
        <Border x:Name="PageArea"
                Grid.Column="1"
                Margin="0,8,8,8"
                SizeChanged="DragLayout_SizeChanged">
            <Border.RenderTransform>
                <CompositeTransform x:Name="PageAreaTransform" />
            </Border.RenderTransform>
            <Grid x:Name="PageColumns">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="LeftPaneColumn" Width="*" />
                    <ColumnDefinition x:Name="SplitGapColumn" Width="0" />
                    <ColumnDefinition x:Name="RightPaneColumn" Width="0" />
                </Grid.ColumnDefinitions>
            <!-- The border comes from a style so Peek can hide it with a local value and clear that
                 afterwards, getting back a brush that still follows light/dark mode. -->
            <Border x:Name="MainCard"
                    CornerRadius="6"
                    BorderThickness="1"
                    Background="{ThemeResource DriftPageBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{ThemeResource DriftPageBorderBrush}" />
                </Style>
            </Border.Style>
            <Grid>
                <TextBlock x:Name="EmptyText"
                           Text="Press Ctrl+T to open a tab."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Opacity="0.6" />
                <Grid x:Name="WebHost" />
                <!-- When a page's process dies or hangs (OnProcessFailed): what happened, and a way back. -->
                <StackPanel x:Name="CrashPanel"
                            Visibility="Collapsed"
                            MaxWidth="360"
                            Spacing="8"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7BA;" FontSize="28" Foreground="{ThemeResource DriftIconBrush}" Margin="0,0,0,4" />
                    <TextBlock x:Name="CrashTitle" Text="This page crashed" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock x:Name="CrashText" FontSize="13" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <Button x:Name="CrashWaitButton" Content="Wait" Click="CrashWait_Click" />
                        <Button x:Name="CrashReloadButton" Content="Reload" Style="{StaticResource AccentButtonStyle}"
                                Click="CrashReload_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>
            </Border>
                <!-- Between the two pages: drag to share the width differently. -->
                <local:SplitDivider x:Name="SplitDivider"
                                    Grid.Column="1"
                                    Background="Transparent"
                                    Visibility="Collapsed"
                                    PointerPressed="SplitDivider_PointerPressed"
                                    PointerMoved="SplitDivider_PointerMoved"
                                    PointerReleased="SplitDivider_PointerReleased"
                                    PointerCaptureLost="SplitDivider_PointerCaptureLost"
                                    PointerEntered="SplitDivider_PointerEntered"
                                    PointerExited="SplitDivider_PointerExited"
                                    DoubleTapped="SplitDivider_DoubleTapped">
                    <!-- A grip, so it reads as something to drag: brighter on hover, accent-coloured while held. -->
                    <Border x:Name="SplitGrip"
                            Width="4"
                            Height="32"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Background="{ThemeResource DriftIconBrush}"
                            Opacity="0.3">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.15" />
                        </Border.OpacityTransition>
                    </Border>
                    <Border x:Name="SplitGripAccent"
                            Width="4"
                            Height="32"
                            CornerRadius="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Opacity="0">
                        <Border.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.12" />
                        </Border.OpacityTransition>
                    </Border>
                </local:SplitDivider>
                <!-- The right-hand page of a split. Right-hand pages' views live here while they're split. -->
                <Border x:Name="SplitCard"
                        Grid.Column="2"
                        CornerRadius="6"
                        BorderThickness="1"
                        Background="{ThemeResource DriftPageBrush}"
                        Visibility="Collapsed">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{ThemeResource DriftPageBorderBrush}" />
                        </Style>
                    </Border.Style>
                    <Grid x:Name="SplitHost" />
                </Border>
                <!-- While a tab is dragged over a half of the page: that half, outlined, where it'll land (Split.cs). -->
                <Border x:Name="SplitDropSlot"
                        Grid.ColumnSpan="3"
                        HorizontalAlignment="Left"
                        CornerRadius="6"
                        BorderThickness="2"
                        BorderBrush="{ThemeResource DriftDropOutlineBrush}"
                        IsHitTestVisible="False"
                        Opacity="0">
                    <Border.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Border.OpacityTransition>
                </Border>
                <!-- While a tab is dragged from the sidebar: drop it on a half of the page to split. The page
                     there moves over to make room (Split.cs). -->
                <Grid x:Name="SplitDropLayer"
                      Grid.ColumnSpan="3"
                      Background="Transparent"
                      AllowDrop="True"
                      Visibility="Collapsed"
                      DragOver="SplitDrop_DragOver"
                      DragLeave="SplitDrop_DragLeave"
                      Drop="SplitDrop_Drop" />
            </Grid>
        </Border>

        <!-- While Peek is open the shrunk page fades back to 30% opacity. This frame draws that page's
             border unscaled, at the page's whole-pixel bounds (set in SnapPageShrink), because a scaled
             1px border always comes out soft. It fades with the page, and tapping it dismisses Peek. -->
        <Border x:Name="PeekPageFrame"
                Grid.Column="1"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="Transparent"
                Opacity="0"
                Visibility="Collapsed"
                Tapped="PeekPageFrame_Tapped" />

        <!-- Peek: a floating page over the page column, with round controls beside it.
             It has no background of its own, so clicks around the card reach the muted page
             (PeekPageFrame) and dismiss Peek. It sits below the sidebar, which stays usable. -->
        <Grid x:Name="PeekLayer"
              Grid.Column="1"
              Visibility="Collapsed">
            <Grid x:Name="PeekCardFrame"
                  Margin="96,8,96,8">
                <!-- The shadow comes from this stand-in. Lifting the card itself (Translation + ThemeShadow)
                     moves its web content onto a layer that ignores the rounded clip, so the page
                     showed square corners. -->
                <Border x:Name="PeekCardShadow"
                        CornerRadius="8"
                        Background="{ThemeResource DriftPageBrush}"
                        Translation="0,0,14">
                    <Border.Shadow>
                        <ThemeShadow />
                    </Border.Shadow>
                </Border>
                <Border x:Name="PeekCard"
                        CornerRadius="8"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource DriftPageBorderBrush}"
                        Background="{ThemeResource DriftPageBrush}">
                    <Grid>
                        <!-- Opening as a tab (PromotePeekToTab): the page's background colour, filling the card as
                             it grows, and a picture of the page standing in for it, held still. -->
                        <Border x:Name="PeekCardTint" CornerRadius="7" />
                        <Grid x:Name="PeekWebHost" />
                        <Border x:Name="PeekStill" CornerRadius="7" Visibility="Collapsed" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush x:Name="PeekStillBrush" Stretch="Fill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel x:Name="PeekControls"
                        Margin="0,36,52,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Spacing="12">
                <Button x:Name="PeekCloseButton" Style="{StaticResource PeekButtonStyle}"
                        Click="PeekClose_Click"
                        AutomationProperties.Name="Close Peek" ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
                <Button x:Name="PeekToTabButton" Style="{StaticResource PeekButtonStyle}"
                        Click="PeekToTab_Click"
                        PointerEntered="PeekToTab_PointerEntered"
                        AutomationProperties.Name="Open as tab" ToolTipService.ToolTip="Open as tab">
                    <FontIcon Glyph="&#xE740;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- With the sidebar hidden, hovering the window's left edge brings it back over the page. -->
        <Border x:Name="SidebarHotZone"
                Grid.ColumnSpan="2"
                Width="8"
                HorizontalAlignment="Left"
                Background="Transparent"
                Visibility="Collapsed"
                PointerEntered="SidebarHotZone_PointerEntered" />

        <!-- Sidebar. Declared after the page and Peek so it stays on top: usable during Peek,
             and floating over the page when shown from the hot zone. -->
        <Grid x:Name="Sidebar"
              Padding="8,6,4,8">
            <!-- Disabled toolbar buttons (back/forward with no history) just dim their glyph,
                 without the grey plate the default button style gives them. -->
            <Grid.Resources>
                <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Docked, the sidebar is see-through like the rest of the window. Floating over the page,
                 it's a card of its own: inset from the window's edges (SetSidebarHidden), rounded like the
                 Peek card, with an acrylic fill, a hairline border and a shadow. Its margin cancels the
                 sidebar's padding, so the card spans the whole sidebar. The shadow comes from Translation,
                 which is safe here: unlike the Peek card, nothing inside is web content. -->
            <Border x:Name="FloatingSidebarBackdrop"
                    Grid.RowSpan="10"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftPageBorderBrush}"
                    Background="{ThemeResource DriftFloatingSidebarBrush}"
                    Translation="0,0,32"
                    Visibility="Collapsed">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
            </Border>

            <!-- Window row: menu and sidebar toggle on the left, navigation on the right.
                 The empty middle is where the window is dragged from. -->
            <Grid Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MenuButton" Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Menu" ToolTipService.ToolTip="Menu">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="Menu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                            <MenuFlyoutItem x:Name="NewTabMenuItem" Text="New tab" Click="NewTab_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE710;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="NewFolderMenuItem" Text="New folder" Click="NewFolder_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8F4;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="ReopenMenuItem" Text="Reopen closed tab" Click="Reopen_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7A7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="PrivateMenuItem" Text="New private window" Click="PrivateWindow_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xED1A;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="DownloadsMenuItem" Text="Downloads" Click="Downloads_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE896;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="HistoryMenuItem" Text="History" Click="History_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE81C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SidebarMenuItem" Text="Hide sidebar" Click="ToggleSidebar_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE90C;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="SettingsMenuItem" Text="Settings" Click="Settings_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE713;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Minimize" Click="Minimize_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE921;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MaximizeMenuItem" Text="Maximize" Click="Maximize_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon x:Name="MaximizeMenuIcon" Glyph="&#xE922;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Close window" KeyboardAcceleratorTextOverride="Alt+F4" Click="CloseWindow_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button x:Name="SidebarToggleButton" Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                        Click="ToggleSidebar_Click"
                        AutomationProperties.Name="Toggle sidebar" ToolTipService.ToolTip="Toggle sidebar (Ctrl+S)">
                    <FontIcon Glyph="&#xE90C;" FontSize="14" />
                </Button>
                <Border x:Name="TitleDragSpacer" Grid.Column="2" Background="Transparent"
                        SizeChanged="DragLayout_SizeChanged" />
                <Button x:Name="BackButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                        Click="Back_Click" AutomationProperties.Name="Back" ToolTipService.ToolTip="Back">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
                <Button x:Name="ForwardButton" Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                        Click="Forward_Click" AutomationProperties.Name="Forward" ToolTipService.ToolTip="Forward">
                    <FontIcon Glyph="&#xE72A;" FontSize="14" />
                </Button>
                <!-- Reload; while the page loads, stop (ShowLoadButton). -->
                <Button x:Name="ReloadButton" Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                        Click="Reload_Click" AutomationProperties.Name="Reload" ToolTipService.ToolTip="Reload">
                    <FontIcon x:Name="ReloadGlyph" Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Address pill: shows where the tab is. Clicking it opens the command bar on the tab's URL,
                 as Ctrl+L does; the typing happens there. -->
            <Grid Grid.Row="1" Margin="0,8,4,10">
            <Button x:Name="AddressPill"
                    Height="36"
                    Padding="10,0"
                    CornerRadius="8"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    AutomationProperties.Name="Address"
                    Click="AddressPill_Click">
                <!-- The pill and pill-hover colours from App.xaml (DriftPillBrush, DriftPillHoverBrush), repeated
                     as plain brushes per theme: aliases to those keys aren't picked up by the button's template. -->
                <Button.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.ThemeDictionaries>
                            <ResourceDictionary x:Key="Light">
                                <SolidColorBrush x:Key="ButtonBackground" Color="#14000000" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1C000000" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#1C000000" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </ResourceDictionary>
                            <ResourceDictionary x:Key="Dark">
                                <SolidColorBrush x:Key="ButtonBackground" Color="#1AFFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#24FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#24FFFFFF" />
                                <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                            </ResourceDictionary>
                        </ResourceDictionary.ThemeDictionaries>
                    </ResourceDictionary>
                </Button.Resources>
                <TextBlock x:Name="AddressText" FontSize="13" TextTrimming="CharacterEllipsis" />
            </Button>
            <!-- At the pill's end: the page's zoom, when it isn't 100% (ShowZoomChip), which resets it when
                 clicked; in a private window, a badge saying so, which lets clicks through to the pill; and,
                 like Arc's, copy link and site settings. -->
            <StackPanel x:Name="PillBadges"
                        Orientation="Horizontal"
                        Spacing="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,5,0"
                        SizeChanged="PillBadges_SizeChanged">
                <Button x:Name="ZoomChip"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="Collapsed"
                        VerticalAlignment="Center"
                        Height="26" MinHeight="0" MinWidth="0"
                        Padding="6,0"
                        Click="ZoomChip_Click">
                    <TextBlock x:Name="ZoomChipText" FontSize="12" Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                </Button>
                <Border x:Name="PrivateBadge"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"
                        VerticalAlignment="Center"
                        Padding="8,2,8,3"
                        CornerRadius="10"
                        Background="{ThemeResource DriftPrivateBadgeBrush}">
                    <TextBlock Text="Private" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource DriftPrivateBadgeTextBrush}" />
                </Border>
                <!-- Copy link and site settings (whether it's secure, permissions, site data), Arc-style: only
                     there while the pointer is in the sidebar (ShowSiteSettingsButton); otherwise they take no room. -->
                <Button x:Name="CopyLinkButton"
                        Width="26" Height="26"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="Collapsed"
                        Opacity="0"
                        ToolTipService.ToolTip="Copy link"
                        AutomationProperties.Name="Copy link"
                        Click="CopyLink_Click">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <FontIcon x:Name="CopyLinkGlyph" Glyph="&#xE71B;" FontSize="13" />
                </Button>
                <Button x:Name="SiteInfoButton"
                        Width="26" Height="26"
                        VerticalAlignment="Center"
                        Style="{StaticResource IconButtonStyle}"
                        Visibility="Collapsed"
                        Opacity="0"
                        ToolTipService.ToolTip="Site settings"
                        AutomationProperties.Name="Site settings"
                        GotFocus="SiteInfoButton_FocusChanged"
                        LostFocus="SiteInfoButton_FocusChanged">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <FontIcon Glyph="&#xE9E9;" FontSize="13" />
                <Button.Flyout>
                    <Flyout x:Name="SiteInfoFlyout" Placement="BottomEdgeAlignedRight"
                            Opening="SiteInfo_Opening" Opened="SiteInfo_Opened" Closed="SiteInfo_Closed">
                        <StackPanel Width="300" Spacing="12">
                            <!-- The site, after a padlock (or a warning), with what that means under its name. -->
                            <Grid ColumnSpacing="8" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <FontIcon x:Name="SiteInfoSecureGlyph" Glyph="&#xE72E;" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock x:Name="SiteInfoHost" Grid.Column="1" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SiteInfoSecureText" Grid.Column="1" Grid.Row="1" FontSize="13" TextWrapping="Wrap"
                                           Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                            </Grid>
                            <!-- Ad blocking for this site (SiteAdBlock.cs): some sites break with it on. Shown once
                                 the ad blocker says how the site stands; not at all without one. -->
                            <Grid x:Name="SiteAdBlockRow" Visibility="Collapsed" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ad blocking" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="SiteAdBlockSwitch" Grid.Column="1"
                                              OnContent="" OffContent="" MinWidth="0" Margin="0,0,-12,0"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="Ad blocking on this site"
                                              Toggled="SiteAdBlock_Toggled" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource DriftDividerBrush}" />
                            <StackPanel Spacing="6">
                                <TextBlock Text="Permissions" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel x:Name="SitePermissionList" Spacing="6" />
                            </StackPanel>
                            <Border Height="1" Background="{ThemeResource DriftDividerBrush}" />
                            <StackPanel Spacing="6">
                                <Button x:Name="ClearSiteDataButton" Content="Clear cookies and site data" Click="ClearSiteData_Click" />
                                <TextBlock x:Name="SiteDataText" FontSize="12" TextWrapping="Wrap"
                                           Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                           Text="Signs you out of this site and clears what it has stored." />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
                </Button>
            </StackPanel>
            <!-- At the pill's start, like Arc's: a padlock on secure pages, a warning on others. Its tooltip
                 says which; clicking it opens site settings. -->
            <Button x:Name="SiteSecurityButton"
                    Width="26" Height="26"
                    Margin="5,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Style="{StaticResource IconButtonStyle}"
                    Visibility="Collapsed"
                    Click="SiteSecurity_Click">
                <FontIcon x:Name="SiteSecurityGlyph" Glyph="&#xE72E;" FontSize="12" />
            </Button>
            </Grid>

            <!-- Essentials: favicon tiles, up to four across (LayoutEssentials). The tiles' outer edges line up
                 with the address bar's: the list reaches out by their margin on the left, and the address
                 bar stops short of the sidebar's edge on the right as they do. -->
            <GridView x:Name="EssentialList"
                      Grid.Row="2"
                      Margin="-4,-4,0,0"
                      SizeChanged="EssentialList_SizeChanged"
                      ItemsSource="{x:Bind EssentialTabs}"
                      ItemContainerStyle="{StaticResource PinnedTileStyle}"
                      SelectionMode="Single"
                      IsItemClickEnabled="False"
                      CanDragItems="True"
                      CanReorderItems="False"
                      AllowDrop="True"
                      DragItemsStarting="Tabs_DragItemsStarting"
                      DragItemsCompleted="Tabs_DragItemsCompleted"
                      SelectionChanged="TabList_SelectionChanged">
                <GridView.ItemContainerTransitions>
                    <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:BrowserTab">
                        <Grid Height="46" Background="Transparent"
                              AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                              ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}"
                              PointerEntered="IntegrationAnchor_PointerEntered"
                              PointerExited="IntegrationAnchor_PointerExited">
                            <Grid.ContextFlyout>
                                <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                    <MenuFlyoutItem Text="Go to pinned page" Tag="{x:Bind}" Click="ResetPinned_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE80F;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE90D;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Text="Move to pinned tabs" Tag="{x:Bind}" Click="MoveToPinned_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE718;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSubItem Text="Add to folder" Tag="{x:Bind}">
                                        <MenuFlyoutSubItem.Icon>
                                            <FontIcon Glyph="&#xE8B7;" />
                                        </MenuFlyoutSubItem.Icon>
                                    </MenuFlyoutSubItem>
                                    <MenuFlyoutItem Text="Remove from Essentials" Tag="{x:Bind}" Click="MoveToRegular_Click">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE77A;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <FontIcon Glyph="&#xE774;" FontSize="16" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                      Margin="{x:Bind FaviconMargin, Mode=OneWay}"
                                      Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="18" Height="18"
                                   Margin="{x:Bind FaviconMargin, Mode=OneWay}"
                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                            <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                            <TextBlock Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                       Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                            <Button Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                    Style="{StaticResource AccentButtonStyle}"
                                    FontSize="10" Padding="8,0,8,1" MinHeight="0" MinWidth="0" CornerRadius="8"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"
                                    Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                            <!-- While this tab has a page open in Peek, that page's icon sits on the corner. -->
                            <Border Width="22" Height="22"
                                    Margin="0,-4,-4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                                    Background="{ThemeResource DriftActiveBrush}"
                                    Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}">
                                <Grid>
                                    <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                              Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                </Grid>
                            </Border>
                            <!-- Playing sound: a speaker on the icon's top-right corner, which mutes the tab
                                 (MediaControls.cs). -->
                            <Grid Width="18" Height="18">
                                <!-- The size of the speaker on a tab row. -->
                                <Border Width="22" Height="22"
                                        Margin="0,-12,-14,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        CornerRadius="11"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                                        Background="{ThemeResource DriftActiveBrush}"
                                        Visibility="{x:Bind AudioVisibility, Mode=OneWay}">
                                    <Button Width="20" Height="20"
                                            CornerRadius="10"
                                            Tag="{x:Bind}"
                                            Click="TabAudio_Click"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                    </Button>
                                </Border>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- While a tab is dragged and this group is empty: somewhere to drop it. -->
            <Grid x:Name="EssentialDropZone"
                  Grid.Row="2"
                  Height="46"
                  Margin="0,0,0,4"
                  AllowDrop="True"
                  Background="Transparent"
                  Visibility="Collapsed"
                  DragOver="Tabs_DragOver"
                  DragLeave="Tabs_DragLeave"
                  Drop="Tabs_Drop">
                <Rectangle x:Name="EssentialDropZoneOutline" RadiusX="8" RadiusY="8"
                           Stroke="{ThemeResource DriftDividerBrush}"
                           StrokeThickness="1"
                           StrokeDashArray="4,3" />
                <TextBlock Text="Drop here to add to Essentials"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource DriftSecondaryTextBrush}" />
            </Grid>

            <!-- Folders, pinned tabs, New Tab and the tabs scroll together under the Essentials, as in Arc,
                 so a long pinned list never hides the tabs. The tab list takes whatever height is left
                 below the tabs (SidebarScroll_SizeChanged), so a tab can still be dropped there. -->
            <ScrollViewer x:Name="SidebarScroll"
                          Grid.Row="3"
                          Grid.RowSpan="5"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          SizeChanged="SidebarScroll_SizeChanged">
                <Grid x:Name="SidebarScrollContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- Folders, like Arc's: between the Essentials and the pinned tabs (Folders.cs). One flat list of
                         folder headers and the tabs under them, indented a step per level. -->
                    <ListView x:Name="FolderList"
                              Grid.Row="0"
                              Margin="0,4,4,0"
                              Padding="0"
                              Visibility="Collapsed"
                              ItemsSource="{x:Bind FolderRows}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="FolderList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplateSelector>
                            <local:FolderRowTemplateSelector>
                                <local:FolderRowTemplateSelector.FolderTemplate>
                                    <DataTemplate x:DataType="models:TabFolder">
                                        <Grid ColumnSpacing="10" Background="Transparent"
                                              Tag="{x:Bind}"
                                              DoubleTapped="FolderHeader_DoubleTapped">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                                    <MenuFlyoutItem Text="New tab" Tag="{x:Bind}" Click="FolderNewTab_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE710;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Rename" Tag="{x:Bind}" Click="FolderRename_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8AC;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="New subfolder" Tag="{x:Bind}" Click="FolderNewSubfolder_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8F4;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Expand all folders" Click="FolderExpandAll_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Collapse all folders" Click="FolderCollapseAll_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE70E;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Close all tabs" Tag="{x:Bind}" Click="FolderCloseAll_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE738;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copy all links" Tag="{x:Bind}" Click="FolderCopyLinks_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE8C8;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Delete folder…" Tag="{x:Bind}" Click="FolderDelete_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE74D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="14"
                                                      Foreground="{ThemeResource DriftIconBrush}" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Name, Mode=OneWay}"
                                                       Visibility="{x:Bind local:Ui.Hidden(IsRenaming), Mode=OneWay}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Tag="{x:Bind}"
                                                     Visibility="{x:Bind local:Ui.Shown(IsRenaming), Mode=OneWay}"
                                                     Margin="-6,0,4,0"
                                                     Padding="5,4,5,4"
                                                     MinHeight="28"
                                                     FontSize="13"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="Folder name"
                                                     KeyDown="FolderName_KeyDown"
                                                     LostFocus="FolderName_LostFocus" />
                                        </Grid>
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.FolderTemplate>
                                <local:FolderRowTemplateSelector.TabTemplate>
                                    <DataTemplate x:DataType="models:BrowserTab">
                                        <Grid ColumnSpacing="10" Background="Transparent"
                                              AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                              PointerEntered="TabRow_PointerEntered"
                                              PointerExited="TabRow_PointerExited">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                                    <MenuFlyoutItem Text="Go to pinned page" Tag="{x:Bind}" Click="ResetPinned_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE80F;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE90D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSubItem Text="Move to folder" Tag="{x:Bind}">
                                                        <MenuFlyoutSubItem.Icon>
                                                            <FontIcon Glyph="&#xE8B7;" />
                                                        </MenuFlyoutSubItem.Icon>
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutItem Text="Remove from folder" Tag="{x:Bind}" Click="RemoveFromFolder_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE718;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Add to Essentials" Tag="{x:Bind}" Click="MoveToEssentials_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE734;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Unpin tab" Tag="{x:Bind}" Click="MoveToRegular_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE77A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                                      Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="16" Height="16"
                                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
                                                <Button Width="20" Height="20"
                                                        Tag="{x:Bind}"
                                                        Click="TabAudio_Click"
                                                        Style="{StaticResource TabCloseButtonStyle}"
                                                        Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                                </Button>
                                                <TextBlock Grid.Column="1"
                                                           Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                           Text="{x:Bind Title, Mode=OneWay}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                                                <TextBlock Grid.Column="2" Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="12"
                                                           VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                                           Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                                                <Button Grid.Column="2" Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        FontSize="12" Padding="10,1,10,2" MinHeight="0" MinWidth="0" CornerRadius="10"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                                            </Grid>
                                            <Button Grid.Column="2"
                                                    Opacity="0"
                                                    Tag="{x:Bind}"
                                                    Click="PinnedAction_Click"
                                                    Margin="{x:Bind RowButtonMargin, Mode=OneWay}"
                                                    Style="{StaticResource TabCloseButtonStyle}"
                                                    AutomationProperties.Name="{x:Bind PinnedActionName, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind PinnedActionName, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind PinnedActionGlyph, Mode=OneWay}" FontSize="10" />
                                            </Button>
                                            <Border Grid.Column="2"
                                                    Width="24" Height="24"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                                                    Background="{ThemeResource DriftPeekBadgeBrush}"
                                                    Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}"
                                                    AutomationProperties.Name="Open in Peek">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                                              Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                                    <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.TabTemplate>
                            </local:FolderRowTemplateSelector>
                        </ListView.ItemTemplateSelector>
                    </ListView>

                    <!-- Pinned tabs: rows under the folders, with their titles (like Zen's). -->
                    <ListView x:Name="PinnedList"
                              Grid.Row="1"
                              Margin="0,4,4,0"
                              Padding="0"
                              ItemsSource="{x:Bind PinnedTabs}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="TabList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BrowserTab">
                                <Grid ColumnSpacing="10" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                      PointerEntered="TabRow_PointerEntered"
                                      PointerExited="TabRow_PointerExited">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                            <MenuFlyoutItem Text="Go to pinned page" Tag="{x:Bind}" Click="ResetPinned_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE80F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Essentials" Tag="{x:Bind}" Click="MoveToEssentials_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE734;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="Add to folder" Tag="{x:Bind}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutSubItem.Icon>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="Unpin tab" Tag="{x:Bind}" Click="MoveToRegular_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE77A;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="16" Height="16"
                                           Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                                    <Grid Grid.Column="1" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
                                        <Button Width="20" Height="20"
                                                Tag="{x:Bind}"
                                                Click="TabAudio_Click"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                                   Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                                        <Button Grid.Column="2" Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" Padding="10,1,10,2" MinHeight="0" MinWidth="0" CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <!-- Shown on hover, like Arc. -->
                                    <Button Grid.Column="2"
                                            Opacity="0"
                                            Tag="{x:Bind}"
                                            Click="PinnedAction_Click"
                                            Margin="{x:Bind RowButtonMargin, Mode=OneWay}"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            AutomationProperties.Name="{x:Bind PinnedActionName, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind PinnedActionName, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind PinnedActionGlyph, Mode=OneWay}" FontSize="10" />
                                    </Button>
                                    <!-- While this tab has a page open in Peek, that page's icon sits at the row's end. -->
                                    <Border Grid.Column="2"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                                            Background="{ThemeResource DriftPeekBadgeBrush}"
                                            Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}"
                                            AutomationProperties.Name="Open in Peek">
                                        <Grid>
                                            <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                                      Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>



                    <!-- While a tab is dragged and this group is empty: somewhere to drop it. -->
                    <Grid x:Name="PinnedDropZone"
                          Grid.Row="1"
                          Height="36"
                          Margin="0,4,4,0"
                          AllowDrop="True"
                          Background="Transparent"
                          Visibility="Collapsed"
                          DragOver="Tabs_DragOver"
                          DragLeave="Tabs_DragLeave"
                          Drop="Tabs_Drop">
                        <Rectangle x:Name="PinnedDropZoneOutline" RadiusX="8" RadiusY="8"
                                   Stroke="{ThemeResource DriftDividerBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="4,3" />
                        <TextBlock Text="Drop here to pin"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    </Grid>

                    <Border Grid.Row="2" Height="1" Margin="4,8,8,6"
                            Background="{ThemeResource DriftDividerBrush}" />

                    <Button x:Name="NewTabButton"
                            Grid.Row="3"
                            Margin="0,0,4,2"
                            Height="36"
                            Style="{StaticResource SubtleButtonStyle}"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="11,0"
                            Foreground="{ThemeResource DriftSecondaryTextBrush}"
                            AutomationProperties.Name="New Tab"
                            PointerEntered="NewTabButton_PointerEntered"
                            PointerExited="NewTabButton_PointerExited"
                            Click="NewTab_Click">
                        <!-- Its shortcut shows at the end while hovered, like Arc's (ShowNewTabHint). -->
                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="New Tab" FontSize="13" />
                            </StackPanel>
                            <TextBlock x:Name="NewTabHint" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Opacity="0">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- Regular tabs -->
                    <ListView x:Name="TabList"
                              Grid.Row="4"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Margin="0,0,4,0"
                              Padding="0"
                              ItemsSource="{x:Bind Tabs}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="TabList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BrowserTab">
                                <Grid ColumnSpacing="10" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                      PointerEntered="TabRow_PointerEntered"
                                      PointerExited="TabRow_PointerExited">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                            <MenuFlyoutItem Text="Pin tab" Tag="{x:Bind}" Click="MoveToPinned_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE718;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Essentials" Tag="{x:Bind}" Click="MoveToEssentials_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE734;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="Add to folder" Tag="{x:Bind}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutSubItem.Icon>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Separate tabs" Tag="{x:Bind}" Click="SeparateTabs_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE737;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Close tab" Tag="{x:Bind}" Click="CloseTabNow_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                                  Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="16" Height="16"
                                               Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnSpacing="6" Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
                                        <Button Width="20" Height="20"
                                                Tag="{x:Bind}"
                                                Click="TabAudio_Click"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                                   Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                                        <Button Grid.Column="2" Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" Padding="10,1,10,2" MinHeight="0" MinWidth="0" CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <!-- Split view (Split.cs): its own row, both pages in it as two pills like Arc's, the one
                                         you're on brighter. Click a pill to go to that page; each has its own ×. -->
                                    <Grid Grid.ColumnSpan="3" Margin="-6,4,0,4" ColumnSpacing="4" Visibility="{x:Bind SplitVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="6" Background="{ThemeResource DriftTileBrush}" Padding="8,0,2,0">
                                            <Grid Tag="{x:Bind Split.Left, Mode=OneWay}" Tapped="SplitHalf_Tapped" Background="Transparent" ColumnSpacing="8"
                                                  PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}"
                                                          Opacity="{x:Bind Split.Left.HalfOpacity, Mode=OneWay}"
                                                          Visibility="{x:Bind Split.Left.PlaceholderVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Split.Left.Favicon, Mode=OneWay}" Width="16" Height="16"
                                                       Opacity="{x:Bind Split.Left.HalfOpacity, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Split.Left.Title, Mode=OneWay}" FontSize="13"
                                                           Opacity="{x:Bind Split.Left.HalfOpacity, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <!-- Takes just this page out of the split; shown while the half is hovered. -->
                                                <Button Grid.Column="2"
                                                        Width="20" Height="20"
                                                        Visibility="Collapsed"
                                                        Tag="{x:Bind Split.Left, Mode=OneWay}"
                                                        Click="CloseSplitHalf_Click"
                                                        Style="{StaticResource TabCloseButtonStyle}"
                                                        AutomationProperties.Name="Close tab"
                                                        ToolTipService.ToolTip="Close tab">
                                                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="6" Background="{ThemeResource DriftTileBrush}" Padding="8,0,2,0">
                                            <Grid Tag="{x:Bind Split.Right, Mode=OneWay}" Tapped="SplitHalf_Tapped" Background="Transparent" ColumnSpacing="8"
                                                  PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}"
                                                          Opacity="{x:Bind Split.Right.HalfOpacity, Mode=OneWay}"
                                                          Visibility="{x:Bind Split.Right.PlaceholderVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Split.Right.Favicon, Mode=OneWay}" Width="16" Height="16"
                                                       Opacity="{x:Bind Split.Right.HalfOpacity, Mode=OneWay}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Split.Right.Title, Mode=OneWay}" FontSize="13"
                                                           Opacity="{x:Bind Split.Right.HalfOpacity, Mode=OneWay}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <!-- Takes just this page out of the split; shown while the half is hovered. -->
                                                <Button Grid.Column="2"
                                                        Width="20" Height="20"
                                                        Visibility="Collapsed"
                                                        Tag="{x:Bind Split.Right, Mode=OneWay}"
                                                        Click="CloseSplitHalf_Click"
                                                        Style="{StaticResource TabCloseButtonStyle}"
                                                        AutomationProperties.Name="Close tab"
                                                        ToolTipService.ToolTip="Close tab">
                                                    <FontIcon Glyph="&#xE711;" FontSize="9" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <!-- Shown on hover, like Arc. (A split's row has one per half instead.) -->
                                    <Button Grid.Column="2"
                                            Opacity="0"
                                            Visibility="{x:Bind SingleVisibility, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="CloseTab_Click"
                                            Margin="{x:Bind RowButtonMargin, Mode=OneWay}"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            AutomationProperties.Name="Close tab"
                                            ToolTipService.ToolTip="Close tab">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                    <!-- While this tab has a page open in Peek, that page's icon sits at the row's end, as on pinned rows. -->
                                    <Border Grid.Column="2"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                                            Background="{ThemeResource DriftPeekBadgeBrush}"
                                            Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}"
                                            AutomationProperties.Name="Open in Peek">
                                        <Grid>
                                            <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                                      Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>

            <!-- The mini player, like Arc's (MediaControls.cs): while a tab plays sound, and a while after
                 it's paused, its icon (go to it), back, play/pause, forward and mute. Hovered, it grows
                 upward over the tab list into a card with the title (scrolling by if it's long), the
                 artist or site, picture-in-picture and close, and a bar to seek with. MediaBarRow keeps
                 the compact bar's room in the sidebar; MediaCard is what shows, over it. -->
            <Border x:Name="MediaBarRow"
                    Grid.Row="8"
                    Margin="0,4,4,0"
                    Height="40"
                    Visibility="Collapsed" />
            <Grid x:Name="MediaCard"
                  Grid.Row="7"
                  Grid.RowSpan="2"
                  Margin="0,4,4,0"
                  Height="40"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed"
                  PointerEntered="MediaCard_PointerEntered"
                  PointerExited="MediaCard_PointerExited">
                <!-- What's cut back to the bar while it grows (its visual's clip, MediaControls.cs). -->
                <Grid x:Name="MediaCardBody">
                <!-- The card itself, which stretches up past its top as it springs open. -->
                <Grid x:Name="MediaCardBack">
                    <Border CornerRadius="8" Background="{ThemeResource DriftTileBrush}" />
                    <!-- Expanded, it's a solid card over the tabs. -->
                    <Border x:Name="MediaCardPlate"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                            Background="{ThemeResource DriftSelectedBrush}"
                            Opacity="0" />
                </Grid>
                <Grid Padding="4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="MediaHeader" Margin="8,8,0,0" ColumnSpacing="2" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The album cover or the video's thumbnail, where the site gives one. -->
                        <Border x:Name="MediaArtFrame" Width="36" Height="36" Margin="0,0,8,0" CornerRadius="6"
                                VerticalAlignment="Center" Background="{ThemeResource DriftTileBrush}" Visibility="Collapsed"
                                Tapped="MediaTitle_Tapped">
                            <Image x:Name="MediaArt" Stretch="UniformToFill" ImageFailed="MediaArt_ImageFailed" />
                        </Border>
                        <!-- The title and site: click to go to the tab. -->
                        <StackPanel Grid.Column="1" Background="Transparent" Spacing="1" VerticalAlignment="Center" Tapped="MediaTitle_Tapped">
                            <Canvas x:Name="MediaTitleBox" Height="18" SizeChanged="MediaTitleBox_SizeChanged">
                                <StackPanel x:Name="MediaTitleStrip" Orientation="Horizontal">
                                    <TextBlock x:Name="MediaTitle" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MediaTitleCopy" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed" />
                                </StackPanel>
                            </Canvas>
                            <TextBlock x:Name="MediaSite" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        </StackPanel>
                        <Button x:Name="MediaPipButton" Grid.Column="2" Click="MediaPip_Click" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top" Margin="0,-4,0,0"
                                AutomationProperties.Name="Picture in picture" ToolTipService.ToolTip="Picture in picture">
                            <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        </Button>
                        <Button Grid.Column="3" Click="MediaClose_Click" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top" Margin="0,-4,0,0"
                                AutomationProperties.Name="Stop and close" ToolTipService.ToolTip="Stop and close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <!-- How far through it is: press or drag on the bar to seek. -->
                    <Grid x:Name="MediaProgress" Grid.Row="1" Margin="8,8,8,0" ColumnSpacing="8" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaElapsed" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        <Grid x:Name="MediaScrub" Grid.Column="1" Height="16" Background="Transparent"
                              PointerPressed="MediaScrub_PointerPressed"
                              PointerMoved="MediaScrub_PointerMoved"
                              PointerReleased="MediaScrub_PointerReleased"
                              PointerCaptureLost="MediaScrub_PointerCaptureLost"
                              AutomationProperties.Name="Seek">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{ThemeResource DriftPillBrush}" />
                            <Border x:Name="MediaScrubFill" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Background="{ThemeResource DriftIconBrush}" Opacity="0.7" />
                        </Grid>
                        <TextBlock x:Name="MediaDuration" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    </Grid>
                    <Grid x:Name="MediaControlsRow" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MediaTabButton" Click="MediaTab_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center">
                            <Grid>
                                <FontIcon x:Name="MediaIconGlyph" Glyph="&#xE774;" FontSize="14" Opacity="0.6" />
                                <Image x:Name="MediaIcon" Width="16" Height="16" />
                            </Grid>
                        </Button>
                        <Button x:Name="MediaBackButton" Grid.Column="1" Click="MediaBack_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Skip back" ToolTipService.ToolTip="Skip back">
                            <FontIcon Glyph="&#xE892;" FontSize="12" />
                        </Button>
                        <Button x:Name="MediaPlayButton" Grid.Column="2" Click="MediaPlay_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center">
                            <FontIcon x:Name="MediaPlayGlyph" Glyph="&#xE769;" FontSize="14" />
                        </Button>
                        <Button x:Name="MediaForwardButton" Grid.Column="3" Click="MediaForward_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Skip forward" ToolTipService.ToolTip="Skip forward">
                            <FontIcon Glyph="&#xE893;" FontSize="12" />
                        </Button>
                        <Button x:Name="MediaMuteButton" Grid.Column="4" Click="MediaMute_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center">
                            <FontIcon x:Name="MediaMuteGlyph" Glyph="&#xE767;" FontSize="14" />
                        </Button>
                    </Grid>
                </Grid>
                </Grid>
            </Grid>

            <!-- Downloads: while one runs, or one has finished since you last looked, a row at the bottom
                 with its name and progress. It opens the library's list; so do Ctrl+J and the menu. -->
            <!-- The library (downloads and history), like Zen's button in the same place. -->
            <Button x:Name="LibraryButton"
                    Grid.Row="9"
                    Margin="0,4,0,0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource IconButtonStyle}"
                    Click="LibraryButton_Click"
                    AutomationProperties.Name="Library"
                    ToolTipService.ToolTip="Downloads and history">
                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
            </Button>
            <Button x:Name="DownloadsButton"
                    Grid.Row="9"
                    Margin="44,4,4,0"
                    Click="DownloadsButton_Click"
                    Height="40"
                    Style="{StaticResource SubtleButtonStyle}"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="11,0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Downloads">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DownloadsGlyph" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="DownloadsText" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="DownloadsProgress" Height="3" MinHeight="3" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Where a dragged tab will land, like Zen's: a line with a ring between rows, in the accent
                 colour (ShowDropIndicator). Essentials show it by moving aside instead (PreviewEssentials);
                 a tab arriving from another group shows as a faded tile in the gap. -->
            <Canvas x:Name="DropIndicatorLayer" Grid.RowSpan="10" IsHitTestVisible="False">
                <Grid x:Name="DropLine" Height="8" Visibility="Collapsed">
                    <Rectangle Height="2" Margin="7,0,0,0" RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" StrokeThickness="2"
                             Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <!-- A folder a drag will drop into (its header, outlined). -->
                <Border x:Name="FolderDropHighlight" CornerRadius="8" BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <Border x:Name="EssentialPlaceholder" Height="46" CornerRadius="8" Opacity="0.5"
                        Background="{ThemeResource DriftTileBrush}" Visibility="Collapsed">
                    <Grid>
                        <FontIcon x:Name="EssentialPlaceholderGlyph" Glyph="&#xE774;" FontSize="16" Opacity="0.6"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="EssentialPlaceholderIcon" Width="18" Height="18" />
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- The library, as Zen has it: downloads and history in the sidebar's place, twice its width.
             It's always its full width, moved left by however much narrower the sidebar is, so as the
             sidebar widens (a swipe, or the library button) it slides in from the left attached to the
             page's edge. (Not right-aligned in the column: wider than its column, it would be clipped.)
             See Library.cs. -->
        <Grid x:Name="Library"
              Grid.ColumnSpan="2"
              Width="416"
              HorizontalAlignment="Left"
              Padding="8,6,4,8"
              ColumnSpacing="8"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The rail: a section per button, icon over name; back to the tabs at the bottom. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <Button x:Name="LibraryDownloadsTab" Tag="downloads" Click="LibraryTab_Click"
                            Style="{StaticResource SubtleButtonStyle}" Width="64" Height="58" Padding="0" CornerRadius="8"
                            HorizontalAlignment="Center" AutomationProperties.Name="Downloads">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="LibraryDownloadsGlyph" Glyph="&#xE896;" FontSize="18" />
                            <TextBlock Text="Downloads" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryHistoryTab" Tag="history" Click="LibraryTab_Click"
                            Style="{StaticResource SubtleButtonStyle}" Width="64" Height="58" Padding="0" CornerRadius="8"
                            HorizontalAlignment="Center" AutomationProperties.Name="History">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="LibraryHistoryGlyph" Glyph="&#xE81C;" FontSize="18" />
                            <TextBlock Text="History" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Row="1" Width="40" Height="40" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Left" Click="LibraryBack_Click"
                        AutomationProperties.Name="Back to tabs" ToolTipService.ToolTip="Back to tabs">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="LibrarySearch" PlaceholderText="Search downloads" IsSpellCheckEnabled="False"
                         TextChanged="LibrarySearch_TextChanged" KeyDown="LibrarySearch_KeyDown"
                         AutomationProperties.Name="Search" />
                <Grid x:Name="LibraryDownloadsPage" Grid.Row="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Click="DownloadsFolder_Click" AutomationProperties.Name="Open Downloads folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="12" />
                                <TextBlock Text="Open folder" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadsClearButton" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Click="DownloadsClear_Click">
                            <TextBlock Text="Clear list" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DownloadsEmpty" Grid.Row="1" Text="Nothing downloaded yet" FontSize="13" Margin="0,4"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    <ListView x:Name="DownloadList"
                              ItemsSource="{x:Bind DownloadItems}"
                              Grid.Row="1"
                              Margin="-12,0,0,0"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="DownloadList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DownloadItem">
                                <Grid ColumnSpacing="12" Padding="0,8" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="18" VerticalAlignment="Top" Margin="0,2,0,0"
                                              Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                              Foreground="{ThemeResource DriftIconBrush}" />
                                    <StackPanel Grid.Column="1" Spacing="2" Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                                        <ProgressBar Margin="0,4,0,0"
                                                     Value="{x:Bind Percent, Mode=OneWay}"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource TabCloseButtonStyle}" Tag="{x:Bind}" Click="DownloadFolder_Click"
                                                Visibility="{x:Bind FolderVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="Show in folder" ToolTipService.ToolTip="Show in folder">
                                            <FontIcon Glyph="&#xE838;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource TabCloseButtonStyle}" Tag="{x:Bind}" Click="DownloadCancel_Click"
                                                Visibility="{x:Bind RunningVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="Cancel download" ToolTipService.ToolTip="Cancel">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                        <Button Style="{StaticResource TabCloseButtonStyle}" Tag="{x:Bind}" Click="DownloadRemove_Click"
                                                Visibility="{x:Bind DoneVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="Remove from list" ToolTipService.ToolTip="Remove from list">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <ScrollViewer x:Name="LibraryHistoryPage" Grid.Row="1" Visibility="Collapsed" Margin="-4,0,0,0">
                    <StackPanel Padding="0,0,8,8">
                        <!-- Builds only the rows on screen (HistoryRows), so a long history opens at once. -->
                        <ItemsRepeater x:Name="LibraryHistoryList" />
                        <TextBlock x:Name="LibraryHistoryEmpty" FontSize="13" Margin="4" Visibility="Collapsed"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        <Button x:Name="LibraryHistoryMore" Content="Show more" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Click="LibraryHistoryMore_Click" Visibility="Collapsed" />
                        <HyperlinkButton Content="Clear browsing data…" HorizontalAlignment="Left" Margin="0,8,0,0"
                                         Click="LibraryClearData_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- What follows the pointer while a tab is dragged: a row over the tab lists, a tile over
             Essentials, a card of the page over the page (to split). Kept off-screen and photographed
             (RenderGhostsAsync) at the start of a drag. -->
        <Canvas x:Name="GhostStage" Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Border x:Name="RowGhost" Canvas.Left="-4000" Height="36" Padding="11,0"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="RowGhostGlyph" Glyph="&#xE774;" FontSize="14" Opacity="0.6"
                              Foreground="{ThemeResource DriftIconBrush}" />
                    <Image x:Name="RowGhostIcon" Width="16" Height="16" />
                    <TextBlock x:Name="RowGhostTitle" Grid.Column="1" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border x:Name="TileGhost" Canvas.Left="-4000" Canvas.Top="60" Height="46"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}">
                <Grid>
                    <FontIcon x:Name="TileGhostGlyph" Glyph="&#xE774;" FontSize="16" Opacity="0.6"
                              Foreground="{ThemeResource DriftIconBrush}" />
                    <Image x:Name="TileGhostIcon" Width="18" Height="18" />
                </Grid>
            </Border>
            <Border x:Name="PageGhost" Canvas.Left="-4000" Canvas.Top="120" Width="88" Height="116"
                    CornerRadius="10" BorderThickness="1" Padding="8,0"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <Grid HorizontalAlignment="Center">
                        <FontIcon x:Name="PageGhostGlyph" Glyph="&#xE774;" FontSize="18" Opacity="0.6"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="PageGhostIcon" Width="20" Height="20" />
                    </Grid>
                    <TextBlock x:Name="PageGhostTitle" FontSize="12" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- Command bar, like Arc's: Ctrl+T (new tab), Ctrl+L or the address pill (this tab's URL).
             A card centred over the whole window, above the page as it is: a search field, then
             suggestions (open tabs, history, searches). The layer around it catches clicks, which
             close it. It opens instantly from the keyboard and with a short scale-and-fade from a click
             (CommandBar.cs). -->
        <Grid x:Name="CommandLayer"
              Grid.ColumnSpan="2"
              Background="Transparent"
              Visibility="Collapsed"
              PointerPressed="CommandLayer_PointerPressed">
            <Border x:Name="CommandCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="720"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftPageBorderBrush}"
                    Background="{ThemeResource DriftCommandBarBrush}"
                    Translation="0,0,48">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <Grid Height="52" Padding="18,0,16,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="CommandGlyph" Glyph="&#xE721;" FontSize="15"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="CommandFavicon" Width="16" Height="16" Visibility="Collapsed" />
                        <TextBox x:Name="CommandBox"
                                 Grid.Column="1"
                                 Style="{StaticResource CommandBoxStyle}"
                                 VerticalAlignment="Center"
                                 Padding="0,6,0,6"
                                 FontSize="16"
                                 PlaceholderText="Search or Enter URL..."
                                 AutomationProperties.Name="Search or enter URL"
                                 IsSpellCheckEnabled="False"
                                 IsTextPredictionEnabled="False"
                                 TextChanged="CommandBox_TextChanged"
                                 PreviewKeyDown="CommandBox_PreviewKeyDown" />
                    </Grid>
                    <Border x:Name="CommandDivider" Height="1" Background="{ThemeResource DriftDividerBrush}" Visibility="Collapsed" />
                    <StackPanel x:Name="CommandResults" Padding="6" Visibility="Collapsed" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hovering a pinned Google Calendar: today's meetings (GoogleCalendar.cs), beside the tab. -->
        <Border x:Name="CalendarCard"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="288"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,48"
                PointerEntered="HoverCard_PointerEntered"
                PointerExited="HoverCard_PointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
            <Border.ScaleTransition>
                <Vector3Transition Duration="0:0:0.15" />
            </Border.ScaleTransition>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CalendarDay" Margin="14,12,14,8" FontSize="13" FontWeight="SemiBold" />
                <StackPanel x:Name="CalendarAllDay" Grid.Row="1" Margin="10,0,10,8" Spacing="4" />
                <Grid Grid.Row="2" Height="300">
                    <ScrollViewer x:Name="CalendarScroll" VerticalScrollBarVisibility="Hidden">
                        <Canvas x:Name="CalendarTimeline" />
                    </ScrollViewer>
                    <TextBlock x:Name="CalendarMessage" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
                    <Button x:Name="CalendarNewButton" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                            Background="{ThemeResource DriftCommandBarBrush}" CornerRadius="16" Width="32" Height="32"
                            Click="CalendarNew_Click"
                            AutomationProperties.Name="New event" ToolTipService.ToolTip="New event">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Hovering a pinned Gmail: your unread emails (Gmail.cs), beside the tab. -->
        <Border x:Name="MailCard"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="300"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,48"
                PointerEntered="HoverCard_PointerEntered"
                PointerExited="HoverCard_PointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
            <Border.ScaleTransition>
                <Vector3Transition Duration="0:0:0.15" />
            </Border.ScaleTransition>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="MailHeader" Margin="14,12,14,6" FontSize="13" FontWeight="SemiBold" />
                <Grid Grid.Row="1" MinHeight="140">
                    <ScrollViewer x:Name="MailScroll" MaxHeight="340" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="MailList" Padding="6,0,6,48" />
                    </ScrollViewer>
                    <TextBlock x:Name="MailMessage" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24,0,24,24"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                            Background="{ThemeResource DriftCommandBarBrush}" CornerRadius="16" Width="32" Height="32"
                            Click="MailCompose_Click"
                            AutomationProperties.Name="Compose" ToolTipService.ToolTip="Compose">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- A minute before a meeting: what it is, and Join (GoogleCalendar.cs). -->
        <Border x:Name="MeetingNotice"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,24,0"
                Padding="12,10,8,10"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,48">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="MeetingNoticeIcon" Width="20" Height="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="240">
                    <TextBlock x:Name="MeetingNoticeTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeetingNoticeWhen" FontSize="12" Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                </StackPanel>
                <Button x:Name="MeetingNoticeJoin" Grid.Column="2" Content="Join" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" Click="MeetingNoticeJoin_Click" />
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                        Click="MeetingNoticeClose_Click"
                        AutomationProperties.Name="Dismiss" ToolTipService.ToolTip="Dismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- Ctrl+Shift+C: says the link was copied, at the foot of the page, for a moment. -->
        <Border x:Name="CopiedToast"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,8,28"
                Padding="14,8"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftCommandBarBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource DriftIconBrush}" />
                <TextBlock Text="Copied link" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- Ctrl+Tab's switcher, as in Arc (TabSwitcher.cs): your tabs, most recently used first, over the
             middle of the window while Ctrl is held. -->
        <Grid x:Name="SwitcherLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border x:Name="SwitcherCard"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Padding="8"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftPageBorderBrush}"
                    Background="{ThemeResource DriftSwitcherBrush}"
                    Translation="0,0,48">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ScrollViewer HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SwitcherList" ItemsSource="{x:Bind SwitcherItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SwitcherItem">
                                <Grid Width="172" Padding="8" RowSpacing="8" CornerRadius="10"
                                      Background="Transparent"
                                      Tag="{x:Bind}"
                                      PointerPressed="SwitcherItem_PointerPressed"
                                      AutomationProperties.Name="{x:Bind Tab.Title, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Picked: a tint behind it. -->
                                    <Border Grid.RowSpan="2" Margin="-8" CornerRadius="10"
                                            Background="{ThemeResource DriftPillBrush}"
                                            Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                    <Border Height="100" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{ThemeResource DriftPageBorderBrush}"
                                            Background="{ThemeResource DriftTileBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" VerticalAlignment="Top"
                                                   Visibility="{x:Bind PictureVisibility, Mode=OneWay}" />
                                            <Grid Visibility="{x:Bind IconTileVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE774;" FontSize="24" Opacity="0.5"
                                                          Foreground="{ThemeResource DriftIconBrush}"
                                                          Visibility="{x:Bind Tab.PlaceholderVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Tab.Favicon, Mode=OneWay}" Width="32" Height="32" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Opacity="0.6"
                                                  Foreground="{ThemeResource DriftIconBrush}"
                                                  Visibility="{x:Bind Tab.PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Tab.Favicon, Mode=OneWay}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Tab.Title, Mode=OneWay}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Visibility="{x:Bind PlainVisibility, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Tab.Title, Mode=OneWay}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
