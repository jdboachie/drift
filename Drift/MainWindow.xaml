                                            </Grid>
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind Name, Mode=OneWay}"
                                                       Visibility="{x:Bind local:Ui.Hidden(IsRenaming), Mode=OneWay}"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBox Grid.Column="1"
                                                     Tag="{x:Bind}"
                                                     Visibility="{x:Bind local:Ui.Shown(IsRenaming), Mode=OneWay}"
                                                     Margin="-6,0,4,0"
                                                     Padding="5,4,5,4"
                                                     MinHeight="28"
                                                     FontSize="13"
                                                     VerticalAlignment="Center"
                                                     AutomationProperties.Name="Folder name"
                                                     KeyDown="FolderName_KeyDown"
                                                     LostFocus="FolderName_LostFocus" />
                                        </Grid>
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.FolderTemplate>
                                <local:FolderRowTemplateSelector.TabTemplate>
                                    <DataTemplate x:DataType="models:BrowserTab">
                                        <Grid ColumnSpacing="10" Background="Transparent"
                                              AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                              PointerEntered="TabRow_PointerEntered"
                                              PointerExited="TabRow_PointerExited">
                                            <Grid.ContextFlyout>
                                                <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                                    <MenuFlyoutItem Text="Go to pinned page" Tag="{x:Bind}" Click="ResetPinned_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE80F;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE90D;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSubItem Text="Move to folder" Tag="{x:Bind}">
                                                        <MenuFlyoutSubItem.Icon>
                                                            <FontIcon Glyph="&#xE8B7;" />
                                                        </MenuFlyoutSubItem.Icon>
                                                    </MenuFlyoutSubItem>
                                                    <MenuFlyoutItem Text="Remove from folder" Tag="{x:Bind}" Click="RemoveFromFolder_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE718;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Add to Essentials" Tag="{x:Bind}" Click="MoveToEssentials_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE734;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Unpin tab" Tag="{x:Bind}" Click="MoveToRegular_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <FontIcon Glyph="&#xE77A;" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                                      Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="16" Height="16"
                                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                                            <Grid Grid.Column="1" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
                                                <Button Width="20" Height="20"
                                                        Tag="{x:Bind}"
                                                        Click="TabAudio_Click"
                                                        Style="{StaticResource TabCloseButtonStyle}"
                                                        Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                        AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                        ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                                    <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                                </Button>
                                                <TextBlock Grid.Column="1"
                                                           Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                           Text="{x:Bind Title, Mode=OneWay}"
                                                           FontSize="13"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                                                <TextBlock Grid.Column="2" Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="12"
                                                           VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                                           Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                                                <Button Grid.Column="2" Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        FontSize="12" Padding="10,1,10,2" MinHeight="0" MinWidth="0" CornerRadius="10"
                                                        VerticalAlignment="Center"
                                                        Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                                                <!-- New in a live folder (LiveFolders.cs), until it's opened. -->
                                                <Ellipse Grid.Column="2" Width="6" Height="6" Margin="0,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                         Visibility="{x:Bind NewVisibility, Mode=OneWay}"
                                                         AutomationProperties.Name="New" />
                                            </Grid>
                                            <Button Grid.Column="2"
                                                    Opacity="0"
                                                    Tag="{x:Bind}"
                                                    Click="PinnedAction_Click"
                                                    Margin="{x:Bind RowButtonMargin, Mode=OneWay}"
                                                    Style="{StaticResource TabCloseButtonStyle}"
                                                    AutomationProperties.Name="{x:Bind PinnedActionName, Mode=OneWay}"
                                                    ToolTipService.ToolTip="{x:Bind PinnedActionName, Mode=OneWay}">
                                                <FontIcon Glyph="{x:Bind PinnedActionGlyph, Mode=OneWay}" FontSize="10" />
                                            </Button>
                                            <Border Grid.Column="2"
                                                    Width="24" Height="24"
                                                    HorizontalAlignment="Right"
                                                    CornerRadius="6"
                                                    BorderThickness="1"
                                                    BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                                                    Background="{ThemeResource DriftPeekBadgeBrush}"
                                                    Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}"
                                                    AutomationProperties.Name="Open in Peek">
                                                <Grid>
                                                    <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                                              Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                                    <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.TabTemplate>
                                <!-- A live folder's note (LiveFolders.cs): signed out, or nothing in it. In line with the tabs' titles. -->
                                <local:FolderRowTemplateSelector.NoteTemplate>
                                    <DataTemplate x:DataType="models:LiveNote">
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                                   Margin="26,0,0,0"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"
                                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                                    </DataTemplate>
                                </local:FolderRowTemplateSelector.NoteTemplate>
                            </local:FolderRowTemplateSelector>
                        </ListView.ItemTemplateSelector>
                    </ListView>

                    <!-- Pinned tabs: rows under the folders, with their titles (like Zen's). -->
                    <ListView x:Name="PinnedList"
                              Grid.Row="1"
                              Margin="0,4,4,0"
                              Padding="0"
                              ItemsSource="{x:Bind PinnedTabs}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="TabList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BrowserTab">
                                <Grid ColumnSpacing="10" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                      PointerEntered="TabRow_PointerEntered"
                                      PointerExited="TabRow_PointerExited">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                            <MenuFlyoutItem Text="Go to pinned page" Tag="{x:Bind}" Click="ResetPinned_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE80F;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Essentials" Tag="{x:Bind}" Click="MoveToEssentials_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE734;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="Add to folder" Tag="{x:Bind}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutSubItem.Icon>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="Unpin tab" Tag="{x:Bind}" Click="MoveToRegular_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE77A;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                              Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                    <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="16" Height="16"
                                           Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                                    <Grid Grid.Column="1" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
                                        <Button Width="20" Height="20"
                                                Tag="{x:Bind}"
                                                Click="TabAudio_Click"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                                   Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                                        <Button Grid.Column="2" Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" Padding="10,1,10,2" MinHeight="0" MinWidth="0" CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <!-- Shown on hover, like Arc. -->
                                    <Button Grid.Column="2"
                                            Opacity="0"
                                            Tag="{x:Bind}"
                                            Click="PinnedAction_Click"
                                            Margin="{x:Bind RowButtonMargin, Mode=OneWay}"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            AutomationProperties.Name="{x:Bind PinnedActionName, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind PinnedActionName, Mode=OneWay}">
                                        <FontIcon Glyph="{x:Bind PinnedActionGlyph, Mode=OneWay}" FontSize="10" />
                                    </Button>
                                    <!-- While this tab has a page open in Peek, that page's icon sits at the row's end. -->
                                    <Border Grid.Column="2"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                                            Background="{ThemeResource DriftPeekBadgeBrush}"
                                            Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}"
                                            AutomationProperties.Name="Open in Peek">
                                        <Grid>
                                            <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                                      Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>



                    <!-- While a tab is dragged and this group is empty: somewhere to drop it. -->
                    <Grid x:Name="PinnedDropZone"
                          Grid.Row="1"
                          Height="36"
                          Margin="0,4,4,0"
                          AllowDrop="True"
                          Background="Transparent"
                          Visibility="Collapsed"
                          DragOver="Tabs_DragOver"
                          DragLeave="Tabs_DragLeave"
                          Drop="Tabs_Drop">
                        <Rectangle x:Name="PinnedDropZoneOutline" RadiusX="8" RadiusY="8"
                                   Stroke="{ThemeResource DriftDividerBrush}"
                                   StrokeThickness="1"
                                   StrokeDashArray="4,3" />
                        <TextBlock Text="Drop here to pin"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    </Grid>

                    <Border Grid.Row="2" Height="1" Margin="4,8,8,6"
                            Background="{ThemeResource DriftDividerBrush}" />

                    <Button x:Name="NewTabButton"
                            Grid.Row="3"
                            Margin="0,0,4,2"
                            Height="36"
                            Style="{StaticResource SubtleButtonStyle}"
                            CornerRadius="8"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Padding="11,0"
                            Foreground="{ThemeResource DriftSecondaryTextBrush}"
                            AutomationProperties.Name="New Tab"
                            PointerEntered="NewTabButton_PointerEntered"
                            PointerExited="NewTabButton_PointerExited"
                            Click="NewTab_Click">
                        <!-- Its shortcut shows at the end while hovered, like Arc's (ShowNewTabHint). -->
                        <Grid ColumnSpacing="8" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="New Tab" FontSize="13" />
                            </StackPanel>
                            <TextBlock x:Name="NewTabHint" Grid.Column="1" FontSize="12" VerticalAlignment="Center" Opacity="0">
                                <TextBlock.OpacityTransition>
                                    <ScalarTransition Duration="0:0:0.15" />
                                </TextBlock.OpacityTransition>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- Regular tabs -->
                    <ListView x:Name="TabList"
                              Grid.Row="4"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              Margin="0,0,4,0"
                              Padding="0"
                              ItemsSource="{x:Bind Tabs}"
                              ItemContainerStyle="{StaticResource TabRowStyle}"
                              SelectionMode="Single"
                              CanDragItems="True"
                              CanReorderItems="False"
                              AllowDrop="True"
                              DragItemsStarting="Tabs_DragItemsStarting"
                              DragItemsCompleted="Tabs_DragItemsCompleted"
                              SelectionChanged="TabList_SelectionChanged">
                        <ListView.ItemContainerTransitions>
                            <!-- No add/remove/reposition animations: a dropped or moved tab just lands. -->
                            <TransitionCollection />
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:BrowserTab">
                                <Grid ColumnSpacing="10" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                      PointerEntered="TabRow_PointerEntered"
                                      PointerExited="TabRow_PointerExited">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout Opening="TabMenu_Opening" Opened="SidebarMenu_Opened" Closed="SidebarMenu_Closed">
                                            <MenuFlyoutItem Text="Pin tab" Tag="{x:Bind}" Click="MoveToPinned_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE718;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Add to Essentials" Tag="{x:Bind}" Click="MoveToEssentials_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE734;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSubItem Text="Add to folder" Tag="{x:Bind}">
                                                <MenuFlyoutSubItem.Icon>
                                                    <FontIcon Glyph="&#xE8B7;" />
                                                </MenuFlyoutSubItem.Icon>
                                            </MenuFlyoutSubItem>
                                            <MenuFlyoutItem Text="Split with current tab" Tag="{x:Bind}" Click="SplitWithCurrent_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE90D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Separate tabs" Tag="{x:Bind}" Click="SeparateTabs_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE737;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Close tab" Tag="{x:Bind}" Click="CloseTabNow_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE711;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                                  Visibility="{x:Bind PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Favicon, Mode=OneWay}" Width="16" Height="16"
                                               Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />
                                    </Grid>
                                    <Grid Grid.Column="1" ColumnSpacing="6" Visibility="{x:Bind SingleVisibility, Mode=OneWay}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Playing sound: a speaker, which mutes the tab (MediaControls.cs). -->
                                        <Button Width="20" Height="20"
                                                Tag="{x:Bind}"
                                                Click="TabAudio_Click"
                                                Style="{StaticResource TabCloseButtonStyle}"
                                                Visibility="{x:Bind AudioVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="{x:Bind AudioName, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind AudioName, Mode=OneWay}">
                                            <FontIcon Glyph="{x:Bind AudioGlyph, Mode=OneWay}" FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.Column="1"
                                                   Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <!-- A calendar's next meeting (GoogleCalendar.cs): "in 5m", then Join. -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind MeetingText, Mode=OneWay}" FontSize="12"
                                                   VerticalAlignment="Center" Foreground="{ThemeResource DriftSecondaryTextBrush}"
                                                   Visibility="{x:Bind MeetingTextVisibility, Mode=OneWay}" />
                                        <Button Grid.Column="2" Content="Join" Tag="{x:Bind}" Click="MeetingJoin_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                FontSize="12" Padding="10,1,10,2" MinHeight="0" MinWidth="0" CornerRadius="10"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind JoinVisibility, Mode=OneWay}" />
                                    </Grid>
                                    <!-- Split view (Split.cs): one row for both pages, side by side as they are on screen, each half
                                         filling its side of the row. While the split is the tab you're on, the selected-tab card
                                         sits on the half you're on, and springs across when you switch (PlaceSplitCard). On hover
                                         a half's favicon becomes its ×, as Safari's tabs do, so the title keeps its room. -->
                                    <Grid Grid.ColumnSpan="3" Visibility="{x:Bind SplitVisibility, Mode=OneWay}" SizeChanged="SplitRow_SizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" Tag="{x:Bind}"
                                                CornerRadius="8" BorderThickness="1" IsHitTestVisible="False" Opacity="0"
                                                Background="{ThemeResource DriftSelectedBrush}"
                                                BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                                                Loaded="SplitCard_Loaded">
                                            <Border.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.15" />
                                            </Border.OpacityTransition>
                                        </Border>
                                        <!-- Between the halves, as the gap between the pages is. -->
                                        <Border Grid.Column="1" Width="1" Height="16" HorizontalAlignment="Center"
                                                Background="{ThemeResource DriftDividerBrush}">
                                            <Border.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.15" />
                                            </Border.OpacityTransition>
                                        </Border>
                                        <Grid Grid.Column="0" Tag="{x:Bind Split.Left, Mode=OneWay}" Background="Transparent" CornerRadius="8"
                                              Padding="11,0,8,0" ColumnSpacing="8"
                                              AutomationProperties.Name="{x:Bind Split.Left.Title, Mode=OneWay}"
                                              Loaded="SplitHalf_Loaded" Tapped="SplitHalf_Tapped"
                                              PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Opacity="{x:Bind Split.Left.ContentOpacity, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                                          Visibility="{x:Bind Split.Left.PlaceholderVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Split.Left.Favicon, Mode=OneWay}" Width="16" Height="16" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Split.Left.Title, Mode=OneWay}" FontSize="13"
                                                       Opacity="{x:Bind Split.Left.ContentOpacity, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <!-- Takes just this page out of the split. -->
                                            <Button Width="20" Height="20" Margin="-2,0"
                                                    Opacity="0" IsHitTestVisible="False"
                                                    Tag="{x:Bind Split.Left, Mode=OneWay}"
                                                    Click="CloseSplitHalf_Click"
                                                    Style="{StaticResource TabCloseButtonStyle}"
                                                    AutomationProperties.Name="Close tab"
                                                    ToolTipService.ToolTip="Close tab">
                                                <FontIcon Glyph="&#xE711;" FontSize="9" />
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Column="2" Tag="{x:Bind Split.Right, Mode=OneWay}" Background="Transparent" CornerRadius="8"
                                              Padding="11,0,8,0" ColumnSpacing="8"
                                              AutomationProperties.Name="{x:Bind Split.Right.Title, Mode=OneWay}"
                                              Loaded="SplitHalf_Loaded" Tapped="SplitHalf_Tapped"
                                              PointerEntered="SplitHalf_PointerEntered" PointerExited="SplitHalf_PointerExited">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Opacity="{x:Bind Split.Right.ContentOpacity, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE774;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" Opacity="0.6"
                                                          Visibility="{x:Bind Split.Right.PlaceholderVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Split.Right.Favicon, Mode=OneWay}" Width="16" Height="16" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{x:Bind Split.Right.Title, Mode=OneWay}" FontSize="13"
                                                       Opacity="{x:Bind Split.Right.ContentOpacity, Mode=OneWay}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <!-- Takes just this page out of the split. -->
                                            <Button Width="20" Height="20" Margin="-2,0"
                                                    Opacity="0" IsHitTestVisible="False"
                                                    Tag="{x:Bind Split.Right, Mode=OneWay}"
                                                    Click="CloseSplitHalf_Click"
                                                    Style="{StaticResource TabCloseButtonStyle}"
                                                    AutomationProperties.Name="Close tab"
                                                    ToolTipService.ToolTip="Close tab">
                                                <FontIcon Glyph="&#xE711;" FontSize="9" />
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <!-- Shown on hover, like Arc. (A split's row has one per half instead.) -->
                                    <Button Grid.Column="2"
                                            Opacity="0"
                                            Visibility="{x:Bind SingleVisibility, Mode=OneWay}"
                                            Tag="{x:Bind}"
                                            Click="CloseTab_Click"
                                            Margin="{x:Bind RowButtonMargin, Mode=OneWay}"
                                            Style="{StaticResource TabCloseButtonStyle}"
                                            AutomationProperties.Name="Close tab"
                                            ToolTipService.ToolTip="Close tab">
                                        <FontIcon Glyph="&#xE711;" FontSize="10" />
                                    </Button>
                                    <!-- While this tab has a page open in Peek, that page's icon sits at the row's end, as on pinned rows. -->
                                    <Border Grid.Column="2"
                                            Width="24" Height="24"
                                            HorizontalAlignment="Right"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            BorderBrush="{ThemeResource DriftPeekBadgeBorderBrush}"
                                            Background="{ThemeResource DriftPeekBadgeBrush}"
                                            Visibility="{x:Bind PeekBadgeVisibility, Mode=OneWay}"
                                            AutomationProperties.Name="Open in Peek">
                                        <Grid>
                                            <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="{ThemeResource DriftIconBrush}"
                                                      Visibility="{x:Bind PeekPlaceholderVisibility, Mode=OneWay}" />
                                            <Image Source="{x:Bind PeekFavicon, Mode=OneWay}" Width="16" Height="16" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>

            <!-- The mini player, like Arc's (MediaControls.cs): while a tab plays sound, and a while after
                 it's paused, its icon (go to it), back, play/pause, forward and mute. Hovered, it grows
                 upward over the tab list into a card with the title (scrolling by if it's long), the
                 artist or site, picture-in-picture and close, and a bar to seek with. MediaBarRow keeps
                 the compact bar's room in the sidebar; MediaCard is what shows, over it. -->
            <Border x:Name="MediaBarRow"
                    Grid.Row="8"
                    Margin="0,4,4,0"
                    Height="40"
                    Visibility="Collapsed" />
            <Grid x:Name="MediaCard"
                  Grid.Row="7"
                  Grid.RowSpan="2"
                  Margin="0,4,4,0"
                  Height="40"
                  VerticalAlignment="Bottom"
                  Visibility="Collapsed"
                  PointerEntered="MediaCard_PointerEntered"
                  PointerExited="MediaCard_PointerExited">
                <!-- What's cut back to the bar while it grows (its visual's clip, MediaControls.cs). -->
                <Grid x:Name="MediaCardBody">
                <!-- The card itself, which stretches up past its top as it springs open. -->
                <Grid x:Name="MediaCardBack">
                    <Border CornerRadius="8" Background="{ThemeResource DriftTileBrush}" />
                    <!-- Expanded, it's a solid card over the tabs. -->
                    <Border x:Name="MediaCardPlate"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                            Background="{ThemeResource DriftSelectedBrush}"
                            Opacity="0" />
                </Grid>
                <Grid Padding="4,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="MediaHeader" Margin="8,8,0,0" ColumnSpacing="2" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- The album cover or the video's thumbnail, where the site gives one. -->
                        <Border x:Name="MediaArtFrame" Width="36" Height="36" Margin="0,0,8,0" CornerRadius="6"
                                VerticalAlignment="Center" Background="{ThemeResource DriftTileBrush}" Visibility="Collapsed"
                                Tapped="MediaTitle_Tapped">
                            <Image x:Name="MediaArt" Stretch="UniformToFill" ImageFailed="MediaArt_ImageFailed" />
                        </Border>
                        <!-- The title and site: click to go to the tab. -->
                        <StackPanel Grid.Column="1" Background="Transparent" Spacing="1" VerticalAlignment="Center" Tapped="MediaTitle_Tapped">
                            <Canvas x:Name="MediaTitleBox" Height="18" SizeChanged="MediaTitleBox_SizeChanged">
                                <StackPanel x:Name="MediaTitleStrip" Orientation="Horizontal">
                                    <TextBlock x:Name="MediaTitle" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MediaTitleCopy" FontSize="13" FontWeight="SemiBold" Visibility="Collapsed" />
                                </StackPanel>
                            </Canvas>
                            <TextBlock x:Name="MediaSite" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        </StackPanel>
                        <Button x:Name="MediaPipButton" Grid.Column="2" Click="MediaPip_Click" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top" Margin="0,-4,0,0"
                                AutomationProperties.Name="Picture in picture" ToolTipService.ToolTip="Picture in picture">
                            <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                        </Button>
                        <Button Grid.Column="3" Click="MediaClose_Click" Style="{StaticResource IconButtonStyle}"
                                VerticalAlignment="Top" Margin="0,-4,0,0"
                                AutomationProperties.Name="Stop and close" ToolTipService.ToolTip="Stop and close">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                    <!-- How far through it is: press or drag on the bar to seek. -->
                    <Grid x:Name="MediaProgress" Grid.Row="1" Margin="8,8,8,0" ColumnSpacing="8" Visibility="Collapsed" Opacity="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MediaElapsed" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        <Grid x:Name="MediaScrub" Grid.Column="1" Height="16" Background="Transparent"
                              PointerPressed="MediaScrub_PointerPressed"
                              PointerMoved="MediaScrub_PointerMoved"
                              PointerReleased="MediaScrub_PointerReleased"
                              PointerCaptureLost="MediaScrub_PointerCaptureLost"
                              AutomationProperties.Name="Seek">
                            <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{ThemeResource DriftPillBrush}" />
                            <Border x:Name="MediaScrubFill" Height="4" Width="0" CornerRadius="2" VerticalAlignment="Center"
                                    HorizontalAlignment="Left" Background="{ThemeResource DriftIconBrush}" Opacity="0.7" />
                        </Grid>
                        <TextBlock x:Name="MediaDuration" Grid.Column="2" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    </Grid>
                    <Grid x:Name="MediaControlsRow" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="MediaTabButton" Click="MediaTab_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center">
                            <Grid>
                                <FontIcon x:Name="MediaIconGlyph" Glyph="&#xE774;" FontSize="14" Opacity="0.6" />
                                <Image x:Name="MediaIcon" Width="16" Height="16" />
                            </Grid>
                        </Button>
                        <Button x:Name="MediaBackButton" Grid.Column="1" Click="MediaBack_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Skip back" ToolTipService.ToolTip="Skip back">
                            <FontIcon Glyph="&#xE892;" FontSize="12" />
                        </Button>
                        <Button x:Name="MediaPlayButton" Grid.Column="2" Click="MediaPlay_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center">
                            <FontIcon x:Name="MediaPlayGlyph" Glyph="&#xE769;" FontSize="14" />
                        </Button>
                        <Button x:Name="MediaForwardButton" Grid.Column="3" Click="MediaForward_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="Skip forward" ToolTipService.ToolTip="Skip forward">
                            <FontIcon Glyph="&#xE893;" FontSize="12" />
                        </Button>
                        <Button x:Name="MediaMuteButton" Grid.Column="4" Click="MediaMute_Click" Style="{StaticResource IconButtonStyle}"
                                HorizontalAlignment="Center">
                            <FontIcon x:Name="MediaMuteGlyph" Glyph="&#xE767;" FontSize="14" />
                        </Button>
                    </Grid>
                </Grid>
                </Grid>
            </Grid>

            <!-- Downloads: while one runs, or one has finished since you last looked, a row at the bottom
                 with its name and progress. It opens the library's list; so do Ctrl+J and the menu. -->
            <!-- The library (bookmarks, downloads and history), like Zen's button in the same place. -->
            <Button x:Name="LibraryButton"
                    Grid.Row="9"
                    Margin="0,4,0,0"
                    Width="40"
                    Height="40"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource IconButtonStyle}"
                    Click="LibraryButton_Click"
                    AutomationProperties.Name="Library"
                    ToolTipService.ToolTip="Library">
                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
            </Button>
            <Button x:Name="DownloadsButton"
                    Grid.Row="9"
                    Margin="44,4,4,0"
                    Click="DownloadsButton_Click"
                    Height="40"
                    Style="{StaticResource SubtleButtonStyle}"
                    CornerRadius="8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Padding="11,0"
                    Visibility="Collapsed"
                    AutomationProperties.Name="Downloads">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="DownloadsGlyph" Glyph="&#xE896;" FontSize="14" Foreground="{ThemeResource DriftIconBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <TextBlock x:Name="DownloadsText" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <ProgressBar x:Name="DownloadsProgress" Height="3" MinHeight="3" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Where a dragged tab will land, like Zen's: a line with a ring between rows, in the accent
                 colour (ShowDropIndicator). Essentials show it by moving aside instead (PreviewEssentials);
                 a tab arriving from another group shows as a faded tile in the gap. -->
            <Canvas x:Name="DropIndicatorLayer" Grid.RowSpan="10" IsHitTestVisible="False">
                <Grid x:Name="DropLine" Height="8" Visibility="Collapsed">
                    <Rectangle Height="2" Margin="7,0,0,0" RadiusX="1" RadiusY="1" VerticalAlignment="Center"
                               Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                    <Ellipse Width="8" Height="8" HorizontalAlignment="Left" StrokeThickness="2"
                             Stroke="{ThemeResource AccentFillColorDefaultBrush}" />
                </Grid>
                <!-- A folder a drag will drop into (its header, outlined). -->
                <Border x:Name="FolderDropHighlight" CornerRadius="8" BorderThickness="2"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                <Border x:Name="EssentialPlaceholder" Height="46" CornerRadius="8" Opacity="0.5"
                        Background="{ThemeResource DriftTileBrush}" Visibility="Collapsed">
                    <Grid>
                        <FontIcon x:Name="EssentialPlaceholderGlyph" Glyph="&#xE774;" FontSize="16" Opacity="0.6"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="EssentialPlaceholderIcon" Width="18" Height="18" />
                    </Grid>
                </Border>
            </Canvas>
        </Grid>

        <!-- The sidebar's edge, in the gap between the sidebar and the page: drag it to resize the sidebar,
             past its narrowest to hide it; double-click it for the default width (SidebarResizing.cs).
             The same grip as split view's divider, but only on hover or while held. Placed in code
             (PlaceResizeHandle): it follows the width, and goes while the library's in the sidebar's place. -->
        <local:ResizeGrip x:Name="SidebarResizeHandle"
                          Grid.ColumnSpan="2"
                          Width="10"
                          Margin="199,8,0,8"
                          HorizontalAlignment="Left"
                          Background="Transparent"
                          AutomationProperties.Name="Resize sidebar"
                          PointerEntered="ResizeHandle_PointerEntered"
                          PointerExited="ResizeHandle_PointerExited"
                          PointerPressed="ResizeHandle_PointerPressed"
                          PointerMoved="ResizeHandle_PointerMoved"
                          PointerReleased="ResizeHandle_PointerReleased"
                          PointerCanceled="ResizeHandle_PointerCanceled"
                          PointerCaptureLost="ResizeHandle_PointerCanceled"
                          DoubleTapped="ResizeHandle_DoubleTapped">
            <Border x:Name="SidebarGrip"
                    Width="4"
                    Height="32"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Background="{ThemeResource DriftIconBrush}"
                    Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.15" />
                </Border.OpacityTransition>
            </Border>
            <Border x:Name="SidebarGripAccent"
                    Width="4"
                    Height="32"
                    CornerRadius="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="0">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.12" />
                </Border.OpacityTransition>
            </Border>
        </local:ResizeGrip>

        <!-- The library, as Zen has it: downloads and history in the sidebar's place, twice its width.
             It's always its full width, moved left by however much narrower the sidebar is, so as the
             sidebar widens (a swipe, or the library button) it slides in from the left attached to the
             page's edge. (Not right-aligned in the column: wider than its column, it would be clipped.)
             See Library.cs. -->
        <Grid x:Name="Library"
              Grid.ColumnSpan="2"
              Width="416"
              HorizontalAlignment="Left"
              Padding="8,6,4,8"
              ColumnSpacing="8"
              Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- The rail: a section per button, icon over name; back to the tabs at the bottom. -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="6">
                    <Button x:Name="LibraryBookmarksTab" Tag="bookmarks" Click="LibraryTab_Click"
                            Style="{StaticResource SubtleButtonStyle}" Width="64" Height="58" Padding="0" CornerRadius="8"
                            HorizontalAlignment="Center" AutomationProperties.Name="Bookmarks">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="LibraryBookmarksGlyph" Glyph="&#xE734;" FontSize="18" />
                            <TextBlock Text="Bookmarks" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryDownloadsTab" Tag="downloads" Click="LibraryTab_Click"
                            Style="{StaticResource SubtleButtonStyle}" Width="64" Height="58" Padding="0" CornerRadius="8"
                            HorizontalAlignment="Center" AutomationProperties.Name="Downloads">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="LibraryDownloadsGlyph" Glyph="&#xE896;" FontSize="18" />
                            <TextBlock Text="Downloads" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="LibraryHistoryTab" Tag="history" Click="LibraryTab_Click"
                            Style="{StaticResource SubtleButtonStyle}" Width="64" Height="58" Padding="0" CornerRadius="8"
                            HorizontalAlignment="Center" AutomationProperties.Name="History">
                        <StackPanel Spacing="4">
                            <FontIcon x:Name="LibraryHistoryGlyph" Glyph="&#xE81C;" FontSize="18" />
                            <TextBlock Text="History" FontSize="11" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button Grid.Row="1" Width="40" Height="40" Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Left" Click="LibraryBack_Click"
                        AutomationProperties.Name="Back to tabs" ToolTipService.ToolTip="Back to tabs">
                    <FontIcon Glyph="&#xE72B;" FontSize="14" />
                </Button>
            </Grid>
            <Grid Grid.Column="1" RowSpacing="8" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="LibrarySearch" PlaceholderText="Search downloads" IsSpellCheckEnabled="False"
                         TextChanged="LibrarySearch_TextChanged" KeyDown="LibrarySearch_KeyDown"
                         AutomationProperties.Name="Search" />
                <Grid x:Name="LibraryDownloadsPage" Grid.Row="1" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                        <Button Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Click="DownloadsFolder_Click" AutomationProperties.Name="Open Downloads folder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE838;" FontSize="12" />
                                <TextBlock Text="Open folder" FontSize="13" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="DownloadsClearButton" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                                Click="DownloadsClear_Click">
                            <TextBlock Text="Clear list" FontSize="13" />
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DownloadsEmpty" Grid.Row="1" Text="Nothing downloaded yet" FontSize="13" Margin="0,4"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                    <ListView x:Name="DownloadList"
                              ItemsSource="{x:Bind DownloadItems}"
                              Grid.Row="1"
                              Margin="-12,0,0,0"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="DownloadList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:DownloadItem">
                                <Grid ColumnSpacing="12" Padding="0,8" Background="Transparent"
                                      AutomationProperties.Name="{x:Bind FileName, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Windows' icon for the file, as Explorer has it (FileIcons); the plain glyph till it comes. -->
                                    <Grid Width="24" Height="24" VerticalAlignment="Top" Margin="0,4,0,0"
                                          Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="18"
                                                  Visibility="{x:Bind GlyphVisibility, Mode=OneWay}"
                                                  Foreground="{ThemeResource DriftIconBrush}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Spacing="2" Opacity="{x:Bind ContentOpacity, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind FileName, Mode=OneWay}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                                        <ProgressBar Margin="0,4,0,0"
                                                     Value="{x:Bind Percent, Mode=OneWay}"
                                                     IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                                     Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource TabCloseButtonStyle}" Tag="{x:Bind}" Click="DownloadFolder_Click"
                                                Visibility="{x:Bind FolderVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="Show in folder" ToolTipService.ToolTip="Show in folder">
                                            <FontIcon Glyph="&#xE838;" FontSize="12" />
                                        </Button>
                                        <Button Style="{StaticResource TabCloseButtonStyle}" Tag="{x:Bind}" Click="DownloadCancel_Click"
                                                Visibility="{x:Bind RunningVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="Cancel download" ToolTipService.ToolTip="Cancel">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                        <Button Style="{StaticResource TabCloseButtonStyle}" Tag="{x:Bind}" Click="DownloadRemove_Click"
                                                Visibility="{x:Bind DoneVisibility, Mode=OneWay}"
                                                AutomationProperties.Name="Remove from list" ToolTipService.ToolTip="Remove from list">
                                            <FontIcon Glyph="&#xE711;" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                <!-- Bookmarks (Bookmarks.cs): folders that open and close, the pages in them. -->
                <Grid x:Name="LibraryBookmarksPage" Grid.Row="1" RowSpacing="4" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button HorizontalAlignment="Right" Style="{StaticResource SubtleButtonStyle}" Padding="8,4"
                            Click="BookmarksNewFolder_Click" AutomationProperties.Name="New folder">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F4;" FontSize="12" />
                            <TextBlock Text="New folder" FontSize="13" />
                        </StackPanel>
                    </Button>
                    <ScrollViewer Grid.Row="1" Margin="-4,0,0,0">
                        <StackPanel Padding="0,0,8,8">
                            <StackPanel x:Name="BookmarkList" />
                            <TextBlock x:Name="LibraryBookmarksEmpty" FontSize="13" Margin="4" Visibility="Collapsed" TextWrapping="Wrap"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <ScrollViewer x:Name="LibraryHistoryPage" Grid.Row="1" Visibility="Collapsed" Margin="-4,0,0,0">
                    <StackPanel Padding="0,0,8,8">
                        <!-- Builds only the rows on screen (HistoryRows), so a long history opens at once. -->
                        <ItemsRepeater x:Name="LibraryHistoryList" />
                        <TextBlock x:Name="LibraryHistoryEmpty" FontSize="13" Margin="4" Visibility="Collapsed"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                        <Button x:Name="LibraryHistoryMore" Content="Show more" HorizontalAlignment="Center" Margin="0,8,0,0"
                                Click="LibraryHistoryMore_Click" Visibility="Collapsed" />
                        <HyperlinkButton Content="Clear browsing data…" HorizontalAlignment="Left" Margin="0,8,0,0"
                                         Click="LibraryClearData_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- What follows the pointer while a tab is dragged: a row over the tab lists, a tile over
             Essentials, a card of the page over the page (to split). Kept off-screen and photographed
             (RenderGhostsAsync) at the start of a drag. -->
        <Canvas x:Name="GhostStage" Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Border x:Name="RowGhost" Canvas.Left="-4000" Height="36" Padding="11,0"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="RowGhostGlyph" Glyph="&#xE774;" FontSize="14" Opacity="0.6"
                              Foreground="{ThemeResource DriftIconBrush}" />
                    <Image x:Name="RowGhostIcon" Width="16" Height="16" />
                    <TextBlock x:Name="RowGhostTitle" Grid.Column="1" FontSize="13"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border x:Name="TileGhost" Canvas.Left="-4000" Canvas.Top="60" Height="46"
                    CornerRadius="8" BorderThickness="1"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}">
                <Grid>
                    <FontIcon x:Name="TileGhostGlyph" Glyph="&#xE774;" FontSize="16" Opacity="0.6"
                              Foreground="{ThemeResource DriftIconBrush}" />
                    <Image x:Name="TileGhostIcon" Width="18" Height="18" />
                </Grid>
            </Border>
            <Border x:Name="PageGhost" Canvas.Left="-4000" Canvas.Top="120" Width="88" Height="116"
                    CornerRadius="10" BorderThickness="1" Padding="8,0"
                    BorderBrush="{ThemeResource DriftActiveBorderBrush}"
                    Background="{ThemeResource DriftActiveBrush}">
                <StackPanel VerticalAlignment="Center" Spacing="8">
                    <Grid HorizontalAlignment="Center">
                        <FontIcon x:Name="PageGhostGlyph" Glyph="&#xE774;" FontSize="18" Opacity="0.6"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="PageGhostIcon" Width="20" Height="20" />
                    </Grid>
                    <TextBlock x:Name="PageGhostTitle" FontSize="12" HorizontalAlignment="Center"
                               TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Canvas>

        <!-- The window buttons, as in Zen: out of sight until the pointer rests at the top of the page area,
             then down from the top-right corner where Windows keeps them (CaptionBar.cs). -->
        <Border x:Name="CaptionBar"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                CornerRadius="0,0,0,8"
                BorderThickness="1,0,0,1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Translation="0,-56,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.Resources>
                <Style x:Key="CaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                    <Setter Property="Width" Value="46" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{ThemeResource DriftIconBrush}" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </Border.Resources>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButtonStyle}" CornerRadius="0,0,0,7" Click="Minimize_Click"
                        AutomationProperties.Name="Minimize">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="Maximize_Click"
                        AutomationProperties.Name="Maximize">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                    </Button.Resources>
                    <FontIcon x:Name="CaptionMaximizeGlyph" Glyph="&#xE922;" FontSize="10" />
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Click="CloseWindow_Click"
                        AutomationProperties.Name="Close">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#C83C31" />
                        <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
                        <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Command bar, like Arc's: Ctrl+T (new tab), Ctrl+L or the address pill (this tab's URL).
             A card centred over the whole window, above the page as it is: a search field, then
             suggestions (open tabs, history, searches). The layer around it catches clicks, which
             close it. It opens instantly from the keyboard and with a short scale-and-fade from a click
             (CommandBar.cs). -->
        <Grid x:Name="CommandLayer"
              Grid.ColumnSpan="2"
              Background="Transparent"
              Visibility="Collapsed"
              PointerPressed="CommandLayer_PointerPressed">
            <Border x:Name="CommandCard"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="720"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftPageBorderBrush}"
                    Background="{ThemeResource DriftSwitcherBrush}"
                    Translation="0,0,48">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <StackPanel>
                    <Grid Height="52" Padding="18,0,16,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon x:Name="CommandGlyph" Glyph="&#xE721;" FontSize="15"
                                  Foreground="{ThemeResource DriftIconBrush}" />
                        <Image x:Name="CommandFavicon" Width="16" Height="16" Visibility="Collapsed" />
                        <!-- Searching a site (SiteSearchBar.cs): its name in a chip before what you type. -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SiteChip" CornerRadius="6" Padding="8,3,8,4" Margin="0,0,8,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Background="{ThemeResource DriftPillBrush}">
                                <TextBlock x:Name="SiteChipText" FontSize="14" />
                            </Border>
                            <TextBox x:Name="CommandBox"
                                     Grid.Column="1"
                                     Style="{StaticResource CommandBoxStyle}"
                                     VerticalAlignment="Center"
                                     Padding="0,6,0,6"
                                     FontSize="16"
                                     PlaceholderText="Search or Enter URL..."
                                     AutomationProperties.Name="Search or enter URL"
                                     IsSpellCheckEnabled="False"
                                     IsTextPredictionEnabled="False"
                                     TextChanged="CommandBox_TextChanged"
                                     PreviewKeyDown="CommandBox_PreviewKeyDown" />
                        </Grid>
                        <!-- Ask AI (AskAiBar.cs): the key for it while there's something typed; in an
                             answer, the model answering. -->
                        <StackPanel x:Name="AskHint" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="Ask AI" FontSize="13" VerticalAlignment="Center"
                                       Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                            <Border CornerRadius="4" Padding="6,1,6,2" Background="{ThemeResource DriftPillBrush}">
                                <TextBlock Text="Tab" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="AskModelLabel" Grid.Column="2" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
                    </Grid>
                    <Border x:Name="CommandDivider" Height="1" Background="{ThemeResource DriftDividerBrush}" Visibility="Collapsed" />
                    <StackPanel x:Name="CommandResults" Padding="6" Visibility="Collapsed" />
                    <ScrollViewer x:Name="AskScroller" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                                  ViewChanged="AskScroller_ViewChanged">
                        <StackPanel x:Name="AskTranscript" Padding="18,14,18,16" Spacing="8" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Hovering a pinned Google Calendar: today's meetings (GoogleCalendar.cs), beside the tab. -->
        <Border x:Name="CalendarCard"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="288"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,48"
                PointerEntered="HoverCard_PointerEntered"
                PointerExited="HoverCard_PointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
            <Border.ScaleTransition>
                <Vector3Transition Duration="0:0:0.15" />
            </Border.ScaleTransition>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CalendarDay" Margin="14,12,14,8" FontSize="13" FontWeight="SemiBold" />
                <StackPanel x:Name="CalendarAllDay" Grid.Row="1" Margin="10,0,10,8" Spacing="4" />
                <Grid Grid.Row="2" Height="300">
                    <ScrollViewer x:Name="CalendarScroll" VerticalScrollBarVisibility="Hidden">
                        <Canvas x:Name="CalendarTimeline" />
                    </ScrollViewer>
                    <TextBlock x:Name="CalendarMessage" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24,0"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
                    <Button x:Name="CalendarNewButton" Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                            Background="{ThemeResource DriftCommandBarBrush}" CornerRadius="16" Width="32" Height="32"
                            Click="CalendarNew_Click"
                            AutomationProperties.Name="New event" ToolTipService.ToolTip="New event">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- Hovering a pinned Gmail: your unread emails (Gmail.cs), beside the tab. -->
        <Border x:Name="MailCard"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="300"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,48"
                PointerEntered="HoverCard_PointerEntered"
                PointerExited="HoverCard_PointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.12" />
            </Border.OpacityTransition>
            <Border.ScaleTransition>
                <Vector3Transition Duration="0:0:0.15" />
            </Border.ScaleTransition>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="MailHeader" Margin="14,12,14,6" FontSize="13" FontWeight="SemiBold" />
                <Grid Grid.Row="1" MinHeight="140">
                    <ScrollViewer x:Name="MailScroll" MaxHeight="340" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="MailList" Padding="6,0,6,48" />
                    </ScrollViewer>
                    <TextBlock x:Name="MailMessage" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="24,0,24,24"
                               Foreground="{ThemeResource DriftSecondaryTextBrush}" Visibility="Collapsed" />
                    <Button Style="{StaticResource IconButtonStyle}"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,8"
                            Background="{ThemeResource DriftCommandBarBrush}" CornerRadius="16" Width="32" Height="32"
                            Click="MailCompose_Click"
                            AutomationProperties.Name="Compose" ToolTipService.ToolTip="Compose">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- A minute before a meeting: what it is, and Join (GoogleCalendar.cs). -->
        <Border x:Name="MeetingNotice"
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,24,0"
                Padding="12,10,8,10"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,48">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image x:Name="MeetingNoticeIcon" Width="20" Height="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="240">
                    <TextBlock x:Name="MeetingNoticeTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MeetingNoticeWhen" FontSize="12" Foreground="{ThemeResource DriftSecondaryTextBrush}" />
                </StackPanel>
                <Button x:Name="MeetingNoticeJoin" Grid.Column="2" Content="Join" Style="{StaticResource AccentButtonStyle}"
                        VerticalAlignment="Center" Click="MeetingNoticeJoin_Click" />
                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" VerticalAlignment="Center"
                        Click="MeetingNoticeClose_Click"
                        AutomationProperties.Name="Dismiss" ToolTipService.ToolTip="Dismiss">
                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- Ctrl+D: says the page is bookmarked, at the foot of the page, with Edit (Bookmarks.cs). -->
        <Border x:Name="BookmarkToast"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,8,28"
                Padding="14,4,6,4"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE735;" FontSize="13" VerticalAlignment="Center" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="BookmarkToastText" Text="Bookmarked" FontSize="13" VerticalAlignment="Center" />
                <Button x:Name="BookmarkToastEdit" Content="Edit" Style="{StaticResource SubtleButtonStyle}" Padding="8,3"
                        FontSize="13" Click="BookmarkToastEdit_Click" />
            </StackPanel>
        </Border>

        <!-- Ctrl+Shift+C: says the link was copied, at the foot of the page, for a moment. -->
        <Border x:Name="CopiedToast"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,8,28"
                Padding="14,8"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{ThemeResource DriftIconBrush}" />
                <TextBlock Text="Copied link" FontSize="13" />
            </StackPanel>
        </Border>

        <!-- After a first press of the window's close button, or Alt+F4: a second closes (Confirm.cs). -->
        <Border x:Name="CloseAgainHint"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,40,8,0"
                Padding="12,6"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,32">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <TextBlock x:Name="CloseAgainText" FontSize="13" />
        </Border>

        <!-- After a bookmark's deleted or the tab list's cleared: Undo, for a moment (Confirm.cs). -->
        <Border x:Name="UndoToast"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,8,28"
                Padding="14,4,6,4"
                CornerRadius="10"
                BorderThickness="1"
                BorderBrush="{ThemeResource DriftPageBorderBrush}"
                Background="{ThemeResource DriftSwitcherBrush}"
                IsHitTestVisible="False"
                Visibility="Collapsed"
                Opacity="0"
                Translation="0,0,32"
                PointerEntered="UndoToast_PointerEntered"
                PointerExited="UndoToast_PointerExited">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.15" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock x:Name="UndoToastText" FontSize="13" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                <Button Content="Undo" Style="{StaticResource SubtleButtonStyle}" Padding="8,3" FontSize="13" Click="Undo_Click" />
            </StackPanel>
        </Border>

        <!-- Ctrl+Tab's switcher, as in Arc (TabSwitcher.cs): your tabs, most recently used first, over the
             middle of the window while Ctrl is held. -->
        <Grid x:Name="SwitcherLayer" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Border x:Name="SwitcherCard"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Padding="8"
                    CornerRadius="14"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource DriftPageBorderBrush}"
                    Background="{ThemeResource DriftSwitcherBrush}"
                    Translation="0,0,48">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ScrollViewer HorizontalScrollMode="Enabled"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SwitcherList" ItemsSource="{x:Bind SwitcherItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="local:SwitcherItem">
                                <Grid Width="172" Padding="8" RowSpacing="8" CornerRadius="10"
                                      Background="Transparent"
                                      Tag="{x:Bind}"
                                      PointerPressed="SwitcherItem_PointerPressed"
                                      AutomationProperties.Name="{x:Bind Tab.Title, Mode=OneWay}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Picked: a tint behind it. -->
                                    <Border Grid.RowSpan="2" Margin="-8" CornerRadius="10"
                                            Background="{ThemeResource DriftPillBrush}"
                                            Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                    <Border Height="100" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{ThemeResource DriftPageBorderBrush}"
                                            Background="{ThemeResource DriftTileBrush}">
                                        <Grid>
                                            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" VerticalAlignment="Top"
                                                   Visibility="{x:Bind PictureVisibility, Mode=OneWay}" />
                                            <Grid Visibility="{x:Bind IconTileVisibility, Mode=OneWay}">
                                                <FontIcon Glyph="&#xE774;" FontSize="24" Opacity="0.5"
                                                          Foreground="{ThemeResource DriftIconBrush}"
                                                          Visibility="{x:Bind Tab.PlaceholderVisibility, Mode=OneWay}" />
                                                <Image Source="{x:Bind Tab.Favicon, Mode=OneWay}" Width="32" Height="32" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xE774;" FontSize="13" Opacity="0.6"
                                                  Foreground="{ThemeResource DriftIconBrush}"
                                                  Visibility="{x:Bind Tab.PlaceholderVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind Tab.Favicon, Mode=OneWay}" Width="16" Height="16" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Tab.Title, Mode=OneWay}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Visibility="{x:Bind PlainVisibility, Mode=OneWay}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Tab.Title, Mode=OneWay}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{x:Bind SelectedVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
